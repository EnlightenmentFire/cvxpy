[
 {
  "id": "s01_00",
  "text": "古人说有六道众生。",
  "start": 0.5,
  "end": 1.978
 },
 {
  "id": "s01_01",
  "text": "也许不必去问它们在哪里，只要看看一个人，一天之内，心落在了哪里。",
  "start": 2.478,
  "end": 7.87
 },
 {
  "id": "s02_00",
  "text": "清晨，账单一条条弹出来，眼里只剩下两个字：不够。",
  "start": 8.57,
  "end": 13.474
 },
 {
  "id": "s02_01",
  "text": "上午，一句话不对，他拍了桌子，非要争个输赢。",
  "start": 13.974,
  "end": 18.287
 },
 {
  "id": "s02_02",
  "text": "下午，手机刷了三个小时，停不下来，也想不起看了什么。",
  "start": 18.787,
  "end": 23.622
 },
 {
  "id": "s02_03",
  "text": "傍晚，一个坏消息砸下来，他觉得四面都是墙，怎么走也走不出去。",
  "start": 24.122,
  "end": 29.6
 },
 {
  "id": "s02_04",
  "text": "晚上，一顿好饭，一句夸奖，他满足得像在天上。",
  "start": 30.1,
  "end": 34.657
 },
 {
  "id": "s02_05",
  "text": "夜深了，他终于停下来，想了想今天，也想了想明天。",
  "start": 35.157,
  "end": 39.957
 },
 {
  "id": "s02_06",
  "text": "六道，一天就走完了。",
  "start": 40.457,
  "end": 42.404
 },
 {
  "id": "s02_07",
  "text": "而明天，也许又要再走一遍。",
  "start": 42.904,
  "end": 45.252
 },
 {
  "id": "s03_00",
  "text": "一千四百多年前，天台宗的智者大师说过一句很重的话：一念心中，具足三千世间。",
  "start": 46.052,
  "end": 53.165
 },
 {
  "id": "s03_01",
  "text": "今天的心理学实验室里，也看见了几处相似的风景。",
  "start": 53.665,
  "end": 57.561
 },
 {
  "id": "s03_02",
  "text": "有人门明明没锁，却再也不去推。",
  "start": 58.061,
  "end": 60.93
 },
 {
  "id": "s03_03",
  "text": "有人越缺什么，眼里就越只剩下什么。",
  "start": 61.43,
  "end": 64.404
 },
 {
  "id": "s03_04",
  "text": "有人中了大奖，过些日子，快乐却没有多出多少。",
  "start": 64.904,
  "end": 68.87
 },
 {
  "id": "s03_05",
  "text": "先说清楚：这不是用科学证明佛法，而是一种印照。",
  "start": 69.37,
  "end": 73.491
 },
 {
  "id": "s03_06",
  "text": "或许佛学的讲法，也有它的科学基础；两面镜子相对，各自照出对方的一部分。",
  "start": 73.991,
  "end": 80.078
 },
 {
  "id": "s03_07",
  "text": "还有一个问题，我们放到最后回答。",
  "start": 80.578,
  "end": 83.326
 },
 {
  "id": "s03_08",
  "text": "就算世上没有真的畜生道，又怎样？",
  "start": 83.826,
  "end": 86.47
 },
 {
  "id": "s03_09",
  "text": "一个孤苦无告、陷入绝望的人，难道就活得比畜生幸福吗？",
  "start": 86.97,
  "end": 91.822
 },
 {
  "id": "s04_00",
  "text": "先看佛教自己怎么说。",
  "start": 92.822,
  "end": 94.283
 },
 {
  "id": "s04_01",
  "text": "天台宗讲十法界：地狱、饿鬼、畜生、阿修罗、人、天，这是六凡；",
  "start": 94.783,
  "end": 102.07
 },
 {
  "id": "s04_02",
  "text": "声闻、缘觉、菩萨、佛，这是四圣。",
  "start": 102.57,
  "end": 106.761
 },
 {
  "id": "s04_03",
  "text": "前面六个，就是常说的六道。",
  "start": 107.261,
  "end": 109.852
 },
 {
  "id": "s04_04",
  "text": "但十法界不是十层楼，一层住一种众生。",
  "start": 110.352,
  "end": 113.709
 },
 {
  "id": "s04_05",
  "text": "天台的讲法叫十界互具：每一界里，都含着其他九界。",
  "start": 114.209,
  "end": 118.887
 },
 {
  "id": "s04_06",
  "text": "十界各具十界，就是百界；每一界又有十种如是，是千如；再配上众生、国土、五阴三种世间，便是三千。",
  "start": 119.387,
  "end": 129.387
 },
 {
  "id": "s04_07",
  "text": "地狱里，也有成佛的可能；佛的心里，也照见地狱的苦。",
  "start": 129.887,
  "end": 135.104
 },
 {
  "id": "s05_00",
  "text": "智顗大师在《摩诃止观》卷五上写道：",
  "start": 135.604,
  "end": 138.213
 },
 {
  "id": "s05_01",
  "text": "夫一心具十法界，一法界又具十法界百法界；一界具三十种世间，百法界即具三千种世间，此三千在一念心。",
  "start": 138.713,
  "end": 149.213
 },
 {
  "id": "s05_02",
  "text": "若无心而已，介尔有心，即具三千。",
  "start": 149.713,
  "end": 153.813
 },
 {
  "id": "s05_03",
  "text": "用白话说：只要有一念心起，哪怕细微到一丝一毫，十法界、三千种世间，就全在里面了。",
  "start": 154.613,
  "end": 162.352
 },
 {
  "id": "s06_00",
  "text": "所以，界不是一个地址，而是一种状态。",
  "start": 162.852,
  "end": 166.47
 },
 {
  "id": "s06_01",
  "text": "心念一转，你所在的界，就变了。",
  "start": 166.97,
  "end": 170.326
 },
 {
  "id": "s06_02",
  "text": "从地狱到佛，不隔十层楼，只隔一念。",
  "start": 170.826,
  "end": 174.565
 },
 {
  "id": "s06_03",
  "text": "要说明一句：这是天台宗的教义和观法。",
  "start": 175.065,
  "end": 178.109
 },
 {
  "id": "s06_04",
  "text": "本片只取它境由心造这一面，不代表对轮回问题做任何科学判断。",
  "start": 178.609,
  "end": 183.548
 },
 {
  "id": "s07_00",
  "text": "先看地狱。",
  "start": 184.348,
  "end": 185.426
 },
 {
  "id": "s07_01",
  "text": "佛经里描述的地狱，苦有千般；可苦到最深处，是一种感觉：无路可走。",
  "start": 185.926,
  "end": 192.57
 },
 {
  "id": "s07_02",
  "text": "最深的一层叫无间：苦没有间断，也看不到尽头。这正是绝望的样子。",
  "start": 193.07,
  "end": 199.052
 },
 {
  "id": "s07_03",
  "text": "一九六七年，美国心理学家塞利格曼和迈尔，发表了一项动物实验。",
  "start": 199.552,
  "end": 204.631
 },
 {
  "id": "s07_04",
  "text": "一组狗先经历了逃不掉的电击，无论做什么，都停不下来。",
  "start": 205.131,
  "end": 210.052
 },
 {
  "id": "s07_05",
  "text": "后来，把它们放进一个箱子，只要跨过一道矮栏，就能躲开电击。",
  "start": 210.552,
  "end": 215.804
 },
 {
  "id": "s07_06",
  "text": "很多狗却不再尝试，只是趴着忍受。",
  "start": 216.304,
  "end": 219.33
 },
 {
  "id": "s07_07",
  "text": "而没有经历过那段失控的狗，很快就学会了跨过去。",
  "start": 219.83,
  "end": 223.813
 },
 {
  "id": "s07_08",
  "text": "这就是著名的习得性无助。",
  "start": 224.313,
  "end": 226.244
 },
 {
  "id": "s07_09",
  "text": "今天看来，这类动物实验本身就有伦理争议，所以片中不展示。",
  "start": 226.744,
  "end": 231.683
 },
 {
  "id": "s08_00",
  "text": "故事还没有完。",
  "start": 232.183,
  "end": 233.278
 },
 {
  "id": "s08_01",
  "text": "快五十年后，二〇一六年，两位作者写了一篇回顾，叫《习得性无助五十年》，修正了自己当年的理论。",
  "start": 233.778,
  "end": 241.517
 },
 {
  "id": "s08_02",
  "text": "他们根据神经科学的证据说：被动，其实不是学来的。",
  "start": 242.017,
  "end": 246.209
 },
 {
  "id": "s08_03",
  "text": "长时间面对无法控制的痛苦，退缩是大脑的默认反应，和脑干深处的一个核团有关。",
  "start": 246.709,
  "end": 253.144
 },
 {
  "id": "s08_04",
  "text": "真正需要学会的，是另一样东西：控制感。",
  "start": 253.644,
  "end": 257.435
 },
 {
  "id": "s08_05",
  "text": "实验里还有一个细节：先经历过可以逃脱的电击的动物，后来再遇到逃不掉的，就不容易垮下去。",
  "start": 257.935,
  "end": 265.1
 },
 {
  "id": "s08_06",
  "text": "一次掌控的经验，像打了一针预防针。",
  "start": 265.6,
  "end": 268.487
 },
 {
  "id": "s08_07",
  "text": "当行动确实有用，大脑前额叶的内侧会察觉到：我能控制，然后去压住那个默认的退缩。",
  "start": 268.987,
  "end": 275.683
 },
 {
  "id": "s08_08",
  "text": "或许可以这样理解：人不是学会了绝望，而是太久没有机会学会希望。",
  "start": 276.183,
  "end": 281.435
 },
 {
  "id": "s09_00",
  "text": "这和地狱很像。",
  "start": 282.235,
  "end": 283.4
 },
 {
  "id": "s09_01",
  "text": "门不一定锁着，只是里面的人，已经很久没有推开过任何一扇门。",
  "start": 283.9,
  "end": 288.665
 },
 {
  "id": "s09_02",
  "text": "所以要走出来，光说一句别放弃，是不够的。",
  "start": 289.165,
  "end": 293.096
 },
 {
  "id": "s09_03",
  "text": "心理咨询里常用的一个办法，是从很小、一定做得到的事开始：起床，叠被，出门走十分钟。",
  "start": 293.596,
  "end": 301.404
 },
 {
  "id": "s09_04",
  "text": "他需要一次又一次地体验到：我做的事，真的有用。",
  "start": 301.904,
  "end": 306.165
 },
 {
  "id": "s10_00",
  "text": "再看饿鬼道。",
  "start": 307.065,
  "end": 308.178
 },
 {
  "id": "s10_01",
  "text": "佛典里描述饿鬼：腹大如山，咽如针孔。",
  "start": 308.678,
  "end": 312.574
 },
 {
  "id": "s10_02",
  "text": "肚子永远是空的，喉咙却细得咽不下东西。怎么吃，都不够。",
  "start": 313.074,
  "end": 318.187
 },
 {
  "id": "s10_03",
  "text": "二〇一三年，经济学家穆来纳森和心理学家沙菲尔出了一本书，叫《稀缺》。",
  "start": 318.687,
  "end": 324.409
 },
 {
  "id": "s10_04",
  "text": "他们发现，长期缺钱、缺时间的人，注意力会被缺的那件事牢牢吸住，像钻进了一条隧道。",
  "start": 324.909,
  "end": 332.578
 },
 {
  "id": "s10_05",
  "text": "隧道里的东西看得格外清楚，隧道外的一切，却都暗了下去。",
  "start": 333.078,
  "end": 337.878
 },
 {
  "id": "s10_06",
  "text": "他们管这叫隧道视野。",
  "start": 338.378,
  "end": 340.152
 },
 {
  "id": "s10_07",
  "text": "更麻烦的是，缺，本身就占用了脑子的带宽。",
  "start": 340.652,
  "end": 344.304
 },
 {
  "id": "s10_08",
  "text": "就像电脑后台一直开着一个很占内存的程序，别的事情就都慢了。",
  "start": 344.804,
  "end": 349.396
 },
 {
  "id": "s10_09",
  "text": "隧道也不是全无好处：截止日期逼近，人反而效率极高，书里叫它专注红利。",
  "start": 349.896,
  "end": 356.0
 },
 {
  "id": "s10_10",
  "text": "可代价是，隧道外的事被一再推迟；今天借明天的，明天就更缺，越缺越忙，越忙越缺。",
  "start": 356.5,
  "end": 364.657
 },
 {
  "id": "s11_00",
  "text": "同一年，他们和合作者在《科学》杂志上发表了一项研究。",
  "start": 365.157,
  "end": 369.539
 },
 {
  "id": "s11_01",
  "text": "在印度，种甘蔗的农民，一年的收入大多集中在收获的时候。",
  "start": 370.039,
  "end": 374.996
 },
 {
  "id": "s11_02",
  "text": "研究者找了四百六十四位甘蔗农，在收获前后，让同一批人做认知测验。",
  "start": 375.496,
  "end": 381.13
 },
 {
  "id": "s11_03",
  "text": "一种是看图找规律的推理题，一种是考专注、考抑制冲动的颜色数字测验。",
  "start": 381.63,
  "end": 387.874
 },
 {
  "id": "s11_04",
  "text": "收获前手头紧，成绩明显更差；收获后手头宽了，成绩就上来了。",
  "start": 388.374,
  "end": 394.27
 },
 {
  "id": "s11_05",
  "text": "人还是那个人，变的只是缺不缺。",
  "start": 394.77,
  "end": 398.439
 },
 {
  "id": "s11_06",
  "text": "但要老实说：这一类研究，后来的复现结果并不一致。",
  "start": 398.939,
  "end": 403.096
 },
 {
  "id": "s11_07",
  "text": "美国一项研究比较了发薪日前后的低收入者，没有看到认知测验成绩的差别。",
  "start": 403.596,
  "end": 409.109
 },
 {
  "id": "s11_08",
  "text": "二〇二一年，二十多位学者联合重做了二十项在网上进行的稀缺实验，只有四项得出了原来的结果。",
  "start": 409.609,
  "end": 417.07
 },
 {
  "id": "s11_09",
  "text": "所以这里，我们标为：有实证，也有复现争议。",
  "start": 417.57,
  "end": 421.517
 },
 {
  "id": "s12_00",
  "text": "不过，饿鬼道的寓意，不必等数据定论。",
  "start": 422.317,
  "end": 425.517
 },
 {
  "id": "s12_01",
  "text": "缺的不一定是钱，也可以是时间，是认可，是爱。",
  "start": 426.017,
  "end": 430.557
 },
 {
  "id": "s12_02",
  "text": "饿鬼的苦，不在缺，而在那种永远填不满的感觉。",
  "start": 431.057,
  "end": 435.37
 },
 {
  "id": "s12_03",
  "text": "一个人若总觉得不够，那么拥有再多，喉咙还是细的。",
  "start": 435.87,
  "end": 440.252
 },
 {
  "id": "s13_00",
  "text": "再往上看，天道。",
  "start": 441.152,
  "end": 442.978
 },
 {
  "id": "s13_01",
  "text": "天人福报大，衣食自然，快乐无比。",
  "start": 443.478,
  "end": 446.852
 },
 {
  "id": "s13_02",
  "text": "可佛经也说，天人有五衰；福报享尽，一样会衰落。",
  "start": 447.352,
  "end": 452.604
 },
 {
  "id": "s13_03",
  "text": "一九七八年，美国心理学家布里克曼等人，访问了二十二位彩票大奖得主，又找了二十二位普通人做对照。",
  "start": 453.104,
  "end": 461.261
 },
 {
  "id": "s13_04",
  "text": "结果出人意料：他们的幸福感，并没有比普通人高出多少。",
  "start": 461.761,
  "end": 466.074
 },
 {
  "id": "s13_05",
  "text": "而且，他们从日常小事里得到的快乐，比如和朋友聊天、听一句玩笑，反而少了。",
  "start": 466.574,
  "end": 473.043
 },
 {
  "id": "s13_06",
  "text": "心理学管这叫享乐适应：再大的快乐，也会被习惯慢慢吞掉。",
  "start": 473.543,
  "end": 478.57
 },
 {
  "id": "s13_07",
  "text": "布里克曼给了两个解释。一是对比：见过了大喜，平常的小乐就显得淡了。",
  "start": 479.07,
  "end": 485.035
 },
 {
  "id": "s13_08",
  "text": "二是习惯：新的快乐，过一阵子就成了新的平常。",
  "start": 485.535,
  "end": 490.213
 },
 {
  "id": "s14_00",
  "text": "要注意，这是一项小样本研究。",
  "start": 490.713,
  "end": 493.339
 },
 {
  "id": "s14_01",
  "text": "二〇二〇年，瑞典一项预先登记的研究，追踪了三千多位彩票玩家，最长到中奖后二十二年。",
  "start": 493.839,
  "end": 501.143
 },
 {
  "id": "s14_02",
  "text": "中大奖的人，对生活的满意度确实长期更高，并没有完全回到原点。",
  "start": 501.643,
  "end": 507.156
 },
 {
  "id": "s14_03",
  "text": "可日常的快乐感和心理健康，却看不出明显的差别。",
  "start": 507.656,
  "end": 511.448
 },
 {
  "id": "s14_04",
  "text": "但那份最初的惊喜，的确会褪色。",
  "start": 511.948,
  "end": 514.8
 },
 {
  "id": "s14_05",
  "text": "天上的宴席再华美，灯也会一盏一盏暗下来。",
  "start": 515.3,
  "end": 518.865
 },
 {
  "id": "s14_06",
  "text": "这或许就是天道的苦：苦不在没有，而在有了之后，慢慢觉得也不过如此。",
  "start": 519.365,
  "end": 525.47
 },
 {
  "id": "s15_00",
  "text": "剩下三道，简单说。",
  "start": 526.37,
  "end": 528.317
 },
 {
  "id": "s15_01",
  "text": "阿修罗，传统上说他有天人的福报，却没有天人的德行，好斗多嗔，总要和天人争个高下。",
  "start": 528.817,
  "end": 536.243
 },
 {
  "id": "s15_02",
  "text": "这里没有直接对应的实验，只能做个类比。",
  "start": 536.743,
  "end": 539.665
 },
 {
  "id": "s15_03",
  "text": "心理学家费斯廷格在一九五四年就提出：人会不停地拿自己和别人比。",
  "start": 540.165,
  "end": 545.713
 },
 {
  "id": "s15_04",
  "text": "二〇一二年，有经济学家在美国加州大学做了一项研究：让员工能方便地查到同事的工资。",
  "start": 546.213,
  "end": 552.77
 },
 {
  "id": "s15_05",
  "text": "结果，工资低于本单位同岗位中位数的人，满意度明显下降；高于中位数的人，却并没有因此更开心。",
  "start": 553.27,
  "end": 561.478
 },
 {
  "id": "s15_06",
  "text": "比较，常常只带来失去，不带来得到。",
  "start": 561.978,
  "end": 565.665
 },
 {
  "id": "s15_07",
  "text": "于是越比越要比，像一台停不下来的跑步机。",
  "start": 566.165,
  "end": 569.783
 },
 {
  "id": "s15_08",
  "text": "阿修罗的苦就在这里：赢了不安心，输了不甘心。",
  "start": 570.283,
  "end": 574.265
 },
 {
  "id": "s16_00",
  "text": "畜生道，传统上对应愚痴：被本能和惯性推着走，不问为什么。",
  "start": 575.065,
  "end": 580.491
 },
 {
  "id": "s16_01",
  "text": "我们每天又有多少时间，是在自动驾驶里度过的？",
  "start": 580.991,
  "end": 584.574
 },
 {
  "id": "s16_02",
  "text": "这不是说人笨，而是说，一个没有被觉察的习惯，会替我们做完大部分决定。",
  "start": 585.074,
  "end": 590.935
 },
 {
  "id": "s16_03",
  "text": "最后是人道。",
  "start": 591.435,
  "end": 592.478
 },
 {
  "id": "s16_04",
  "text": "人间苦乐参半：不像地狱那样苦到抬不起头，也不像天上那样乐到忘了自己。",
  "start": 592.978,
  "end": 599.065
 },
 {
  "id": "s16_05",
  "text": "佛教传统认为，正因为如此，人道最适合修行。",
  "start": 599.565,
  "end": 603.652
 },
 {
  "id": "s16_06",
  "text": "有苦，所以想出离；有乐，所以还有余力。",
  "start": 604.152,
  "end": 608.291
 },
 {
  "id": "s17_00",
  "text": "《增壹阿含经》里说：",
  "start": 608.791,
  "end": 610.27
 },
 {
  "id": "s17_01",
  "text": "佛世尊皆出人间，非由天而得也。",
  "start": 610.77,
  "end": 614.43
 },
 {
  "id": "s17_02",
  "text": "不在天上，而在人间。",
  "start": 615.23,
  "end": 617.316
 },
 {
  "id": "s18_00",
  "text": "说到这里，要划几条边界。",
  "start": 618.216,
  "end": 620.234
 },
 {
  "id": "s18_01",
  "text": "第一，这是心理学的读法，是印照，是类比；不是用心理学证明六道，也不是否证六道。",
  "start": 620.734,
  "end": 628.769
 },
 {
  "id": "s18_02",
  "text": "在佛教传统里，六道还有它宇宙论的意义，本片不讨论。",
  "start": 629.269,
  "end": 633.999
 },
 {
  "id": "s18_03",
  "text": "第二，引用的研究各有局限：有动物实验，有小样本，有复现争议，我们都一一标了出来。",
  "start": 634.499,
  "end": 642.134
 },
 {
  "id": "s18_04",
  "text": "第三，也是最要紧的：说境由心造，不等于说一切苦都是自己想出来的。",
  "start": 642.634,
  "end": 648.964
 },
 {
  "id": "s18_05",
  "text": "一个人穷，一个人病，一个人被困住，处境都是真实的。",
  "start": 649.464,
  "end": 654.664
 },
 {
  "id": "s18_06",
  "text": "对正在受苦的人只说一句想开就好，那不是慈悲，是冷漠。",
  "start": 655.164,
  "end": 659.86
 },
 {
  "id": "s18_07",
  "text": "心能转境；可很多时候，也需要外面伸进来的一只手。",
  "start": 660.36,
  "end": 664.743
 },
 {
  "id": "s18_08",
  "text": "佛法讲心，不是为了让人自责，而是让人看见：心，是可以练的。",
  "start": 665.243,
  "end": 670.912
 },
 {
  "id": "s19_00",
  "text": "现在，回到开头那个问题。",
  "start": 671.812,
  "end": 674.108
 },
 {
  "id": "s19_01",
  "text": "就算世上没有真的畜生道，又怎样？",
  "start": 674.608,
  "end": 677.251
 },
 {
  "id": "s19_02",
  "text": "一个孤苦无告、陷入绝望的人，难道活得比畜生幸福吗？",
  "start": 677.751,
  "end": 682.308
 },
 {
  "id": "s19_03",
  "text": "地狱也许不在地下，就在一个人的心里，也在他此生的处境里。",
  "start": 683.208,
  "end": 688.147
 },
 {
  "id": "s19_04",
  "text": "这样读六道，它就不再是吓唬人的来世故事，而是此时此地的提醒。",
  "start": 688.647,
  "end": 694.143
 },
 {
  "id": "s19_05",
  "text": "既然地狱可以在心里，出路，也可以在心里。",
  "start": 694.643,
  "end": 698.312
 },
 {
  "id": "s19_06",
  "text": "而那条出路，常常是从别人伸过来的一只手开始的。",
  "start": 698.812,
  "end": 702.743
 },
 {
  "id": "s19_07",
  "text": "还记得那个实验吗？人重新学会希望，靠的是一次又一次：我做的事，真的有用。",
  "start": 703.243,
  "end": 709.573
 },
 {
  "id": "s19_08",
  "text": "你伸出的那只手，也许就是别人的第一次。",
  "start": 710.073,
  "end": 713.273
 },
 {
  "id": "s19_09",
  "text": "六道各有一扇门。",
  "start": 714.173,
  "end": 715.495
 },
 {
  "id": "s19_10",
  "text": "地狱的门，是重新尝到一点控制感；饿鬼的门，是给心腾出一点带宽。",
  "start": 715.995,
  "end": 721.803
 },
 {
  "id": "s19_11",
  "text": "天道的门，是珍惜手里已经有的；阿修罗的门，是放下那把尺子。",
  "start": 722.303,
  "end": 728.269
 },
 {
  "id": "s19_12",
  "text": "畜生道的门，是醒过来，看见自己的习惯；而人道，就是那个能看见所有门的地方。",
  "start": 728.769,
  "end": 735.012
 },
 {
  "id": "s19_13",
  "text": "不必先问六道在哪里，先看看自己此刻的心，落在哪一道。",
  "start": 735.912,
  "end": 740.434
 },
 {
  "id": "s19_14",
  "text": "能走进去，也就能走出来。",
  "start": 740.934,
  "end": 743.108
 },
 {
  "id": "s20_00",
  "text": "《华严经》说：",
  "start": 744.108,
  "end": 745.099
 },
 {
  "id": "s20_01",
  "text": "若人欲了知，三世一切佛，应观法界性，一切唯心造。",
  "start": 745.599,
  "end": 751.779
 },
 {
  "id": "s20_02",
  "text": "想真正了解一切佛，就看清法界的本性：一切，都由心所造。",
  "start": 752.679,
  "end": 758.001
 }
]