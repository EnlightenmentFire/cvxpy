[
 {
  "序号": 1,
  "文本": "假如有人塞给你一封信，信封上写着：敌人来了，才准拆开。",
  "所属场景": "开场｜letter",
  "script_index": 0
 },
 {
  "序号": 2,
  "文本": "后来，敌人真的来了。号称十万人，把你守的城围了起来。",
  "所属场景": "开场｜siege",
  "script_index": 1
 },
 {
  "序号": 3,
  "文本": "你拆开信，上面只有几行字：谁出城去打，谁留在城里守。",
  "所属场景": "开场｜letter",
  "script_index": 2
 },
 {
  "序号": 4,
  "文本": "八百人冲阵之前，那封信，到底写了什么？",
  "所属场景": "开场｜bigtext",
  "script_index": 3
 },
 {
  "序号": 5,
  "文本": "先看这封信换来的那个早晨。",
  "所属场景": "开场｜battle",
  "script_index": 4
 },
 {
  "序号": 6,
  "文本": "天刚亮，一位将军披着铠甲、提着长戟，带着连夜招来的八百人，打开城门，冲了出去。",
  "所属场景": "开场｜battle",
  "script_index": 5
 },
 {
  "序号": 7,
  "文本": "他一边冲，一边大喊自己的名字，一直冲到对方主帅的大旗底下。",
  "所属场景": "开场｜battle",
  "script_index": 6
 },
 {
  "序号": 8,
  "文本": "对方主帅吓得跑上一座高土坡，拿长戟护住自己。",
  "所属场景": "开场｜battle",
  "script_index": 7
 },
 {
  "序号": 9,
  "文本": "这一仗，后来被写成：八百破十万。",
  "所属场景": "开场｜bigtext",
  "script_index": 8
 },
 {
  "序号": 10,
  "文本": "可最险的一刻还没到。十几天后，一座拆掉了桥板的桥，差一点改写了三国。",
  "所属场景": "开场｜bridge",
  "script_index": 9
 },
 {
  "序号": 11,
  "文本": "这是公元215年，合肥。",
  "所属场景": "开场｜title",
  "script_index": 10
 },
 {
  "序号": 12,
  "文本": "说到合肥，很多人第一反应是赤壁。",
  "所属场景": "第一章·是哪一次合肥｜timeline",
  "script_index": 12
 },
 {
  "序号": 13,
  "文本": "没错，赤壁那一年，也就是公元二零八年，孙权也围过一次合肥。",
  "所属场景": "第一章·是哪一次合肥｜timeline",
  "script_index": 13
 },
 {
  "序号": 14,
  "文本": "那一次，他攻了一个多月，没打下来。",
  "所属场景": "第一章·是哪一次合肥｜quote",
  "script_index": 14
 },
 {
  "序号": 15,
  "文本": "曹操那边，军中正闹瘟疫，只派了将军张憙，带一千骑兵去救。",
  "所属场景": "第一章·是哪一次合肥｜quote",
  "script_index": 15
 },
 {
  "序号": 16,
  "文本": "城外有个叫蒋济的官，想了个办法：假造一封张憙的来信，说步兵骑兵四万人，已经快到了。",
  "所属场景": "第一章·是哪一次合肥｜letter",
  "script_index": 16
 },
 {
  "序号": 17,
  "文本": "送信的人分三路走，一路进了城，两路被孙权抓了。孙权信以为真，烧了营寨就撤。",
  "所属场景": "第一章·是哪一次合肥｜quote",
  "script_index": 17
 },
 {
  "序号": 18,
  "文本": "你看，第一次合肥，救城的也是一封信。只不过，那是一封假信。",
  "所属场景": "第一章·是哪一次合肥｜letter",
  "script_index": 18
 },
 {
  "序号": 19,
  "文本": "那位将领是张憙，不是张辽。那一次，也不是我们今天要讲的这一次。",
  "所属场景": "第一章·是哪一次合肥｜bigtext",
  "script_index": 19
 },
 {
  "序号": 20,
  "文本": "我们要讲的，是七年以后，公元二一五年。",
  "所属场景": "第一章·是哪一次合肥｜timeline",
  "script_index": 20
 },
 {
  "序号": 21,
  "文本": "这一年，天下大概是这样的。",
  "所属场景": "第一章·是哪一次合肥｜cnmap",
  "script_index": 21
 },
 {
  "序号": 22,
  "文本": "曹操带着主力往西走，去打汉中的张鲁。",
  "所属场景": "第一章·是哪一次合肥｜cnmap",
  "script_index": 22
 },
 {
  "序号": 23,
  "文本": "孙权和刘备刚刚为荆州闹了一场，最后讲和，把荆州分了。",
  "所属场景": "第一章·是哪一次合肥｜cnmap",
  "script_index": 23
 },
 {
  "序号": 24,
  "文本": "荆州的事我们一句带过。孙权从陆口回来，掉头往北，直奔合肥。",
  "所属场景": "第一章·是哪一次合肥｜cnmap",
  "script_index": 24
 },
 {
  "序号": 25,
  "文本": "还有一件事。这几年，合肥以南的百姓大多逃过了长江，合肥往南，只剩一座皖城。",
  "所属场景": "第一章·是哪一次合肥｜hfmap",
  "script_index": 25
 },
 {
  "序号": 26,
  "文本": "前一年，孙权把皖城也拿下了。合肥，成了一座孤零零的城。",
  "所属场景": "第一章·是哪一次合肥｜hfmap",
  "script_index": 26
 },
 {
  "序号": 27,
  "文本": "你看地图就明白：曹操在汉中，合肥在东边，两地直线距离将近一千公里。",
  "所属场景": "第一章·是哪一次合肥｜cnmap",
  "script_index": 27
 },
 {
  "序号": 28,
  "文本": "合肥要是出事，曹操的救兵，一时半会儿到不了。",
  "所属场景": "第一章·是哪一次合肥｜cnmap",
  "script_index": 28
 },
 {
  "序号": 29,
  "文本": "合肥卡在长江和淮河之间。往南是巢湖，水路能通到长江。",
  "所属场景": "第一章·是哪一次合肥｜hfmap",
  "script_index": 29
 },
 {
  "序号": 30,
  "文本": "孙权想往北走，合肥是绕不开的一道门。",
  "所属场景": "第一章·是哪一次合肥｜hfmap",
  "script_index": 30
 },
 {
  "序号": 31,
  "文本": "那这道门里，有多少人？七千多。",
  "所属场景": "第一章·是哪一次合肥｜dots",
  "script_index": 31
 },
 {
  "序号": 32,
  "文本": "城外呢？孙权号称十万。",
  "所属场景": "第一章·是哪一次合肥｜dots",
  "script_index": 32
 },
 {
  "序号": 33,
  "文本": "城里带兵的，是三位将领。",
  "所属场景": "第一章·是哪一次合肥｜roster",
  "script_index": 33
 },
 {
  "序号": 34,
  "文本": "张辽，原来是吕布的部下。吕布在下邳兵败，他才带着人马投降曹操。",
  "所属场景": "第一章·是哪一次合肥｜roster",
  "script_index": 34
 },
 {
  "序号": 35,
  "文本": "乐进，个子矮小，却是早年就跟着曹操、以胆大出名的老部下。",
  "所属场景": "第一章·是哪一次合肥｜roster",
  "script_index": 35
 },
 {
  "序号": 36,
  "文本": "李典，出身地方大族，曾把宗族上万口人，整个搬到邺城去。",
  "所属场景": "第一章·是哪一次合肥｜roster",
  "script_index": 36
 },
 {
  "序号": 37,
  "文本": "三个人来路不同，彼此关系很差。",
  "所属场景": "第一章·是哪一次合肥｜roster",
  "script_index": 37
 },
 {
  "序号": 38,
  "文本": "这就是曹操留下的局面：他不在，救兵远，敌人多，自己人还不和。",
  "所属场景": "第一章·是哪一次合肥｜bigtext",
  "script_index": 38
 },
 {
  "序号": 39,
  "文本": "他能做的，只剩一封信。",
  "所属场景": "第一章·是哪一次合肥｜letter",
  "script_index": 39
 },
 {
  "序号": 40,
  "文本": "曹操出发去打张鲁之前，写下一道命令。古书里，这种命令叫“教”。",
  "所属场景": "第二章·那封信｜letter",
  "script_index": 41
 },
 {
  "序号": 41,
  "文本": "他没有交给张辽，也没有交给乐进、李典，而是交给了护军薛悌。",
  "所属场景": "第二章·那封信｜roster",
  "script_index": 42
 },
 {
  "序号": 42,
  "文本": "护军，你可以理解成随军的监督官。",
  "所属场景": "第二章·那封信｜roster",
  "script_index": 43
 },
 {
  "序号": 43,
  "文本": "信封的边上，写着五个字：贼至乃发。",
  "所属场景": "第二章·那封信｜letter",
  "script_index": 44
 },
 {
  "序号": 44,
  "文本": "意思是：敌人来了，才准拆开。",
  "所属场景": "第二章·那封信｜letter",
  "script_index": 45
 },
 {
  "序号": 45,
  "文本": "这一年八月，孙权的大军到了，把合肥团团围住。几位将领聚到一起，拆开了信。",
  "所属场景": "第二章·那封信｜siege",
  "script_index": 46
 },
 {
  "序号": 46,
  "文本": "信上写着：如果孙权来了，张辽、李典两位将军出城迎战；乐进留下守城，不许出战。",
  "所属场景": "第二章·那封信｜letter",
  "script_index": 47
 },
 {
  "序号": 47,
  "文本": "这句原文，断句有两种。张辽传读作“乐将军守护军”，资治通鉴读作“乐将军守，护军勿得与战”。",
  "所属场景": "第二章·那封信｜twocut",
  "script_index": 48
 },
 {
  "序号": 48,
  "文本": "怎么断都行，有一点不变：出去打的是张辽和李典，留下守的是乐进。",
  "所属场景": "第二章·那封信｜roster",
  "script_index": 49
 },
 {
  "序号": 49,
  "文本": "你想想，城里七千人，城外号称十万。换成你，第一反应是什么？",
  "所属场景": "第二章·那封信｜dots",
  "script_index": 50
 },
 {
  "序号": 50,
  "文本": "大概是关紧城门，死守，等救兵。",
  "所属场景": "第二章·那封信｜gate",
  "script_index": 51
 },
 {
  "序号": 51,
  "文本": "可这封信偏偏说：出去打。",
  "所属场景": "第二章·那封信｜gate",
  "script_index": 52
 },
 {
  "序号": 52,
  "文本": "所以史书上写：诸将皆疑。大家都想不通。",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 53
 },
 {
  "序号": 53,
  "文本": "张辽站出来解释：主公远征在外，等救兵赶到，敌人早把我们打垮了。",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 54
 },
 {
  "序号": 54,
  "文本": "所以这封信的意思，是趁敌人还没把城围死，先冲出去打他一下，挫掉他的锐气，让城里人心安定，然后才守得住。",
  "所属场景": "第二章·那封信｜chain",
  "script_index": 55
 },
 {
  "序号": 55,
  "文本": "他最后说：成败之机，在此一战。",
  "所属场景": "第二章·那封信｜bigtext",
  "script_index": 56
 },
 {
  "序号": 56,
  "文本": "资治通鉴把这一幕写得更紧张。张辽说完，乐进他们，没人接话。",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 57
 },
 {
  "序号": 57,
  "文本": "张辽火了：你们要是还犹豫，我张辽一个人来决这一仗。",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 58
 },
 {
  "序号": 58,
  "文本": "这时候，一个人开口了。李典。",
  "所属场景": "第二章·那封信｜roster",
  "script_index": 59
 },
 {
  "序号": 59,
  "文本": "李典传里有一句很要紧的话：乐进、李典、张辽，三个人一向不和。",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 60
 },
 {
  "序号": 60,
  "文本": "张辽要出战，最担心的，就是李典不跟他走。",
  "所属场景": "第二章·那封信｜roster",
  "script_index": 61
 },
 {
  "序号": 61,
  "文本": "李典是什么样的人？史书说他好学问，敬重读书人，从不跟别的将领争功，军中都叫他长者。",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 62
 },
 {
  "序号": 62,
  "文本": "他说：这是国家大事，就看你的计划怎么样。我怎么能因为私人恩怨，忘了公事呢？",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 63
 },
 {
  "序号": 63,
  "文本": "于是，两个合不来的人，一起出了城。",
  "所属场景": "第二章·那封信｜gate",
  "script_index": 64
 },
 {
  "序号": 64,
  "文本": "一百多年后，东晋的史学家孙盛，专门评过这封信。",
  "所属场景": "第二章·那封信｜sunsheng",
  "script_index": 65
 },
 {
  "序号": 65,
  "文本": "他说，合肥这座城，弱小，又没有外援。",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 66
 },
 {
  "序号": 66,
  "文本": "全交给勇猛的人，容易好战惹祸；全交给谨慎的人，又怕人心守不住。",
  "所属场景": "第二章·那封信｜sunsheng",
  "script_index": 67
 },
 {
  "序号": 67,
  "文本": "所以曹操推选方员，参以同异。方的圆的，一样的不一样的，搭配着用。",
  "所属场景": "第二章·那封信｜sunsheng",
  "script_index": 68
 },
 {
  "序号": 68,
  "文本": "再写成一封密教，事到临头拿出来，就像兵符的两半，正好对上。",
  "所属场景": "第二章·那封信｜sunsheng",
  "script_index": 69
 },
 {
  "序号": 69,
  "文本": "孙盛在同一段里还说过：几个将帅不和，本来就是丢掉军队的路子。",
  "所属场景": "第二章·那封信｜quote",
  "script_index": 70
 },
 {
  "序号": 70,
  "文本": "这就有意思了。三个人互相不服，按理说是大忌。",
  "所属场景": "第二章·那封信｜roster",
  "script_index": 71
 },
 {
  "序号": 71,
  "文本": "可这封信在敌人到来之前，就把谁冲、谁守分好了。到了那一刻，没人需要再争听谁的。",
  "所属场景": "第二章·那封信｜roster",
  "script_index": 72
 },
 {
  "序号": 72,
  "文本": "不过，信上只写了谁出战。没写带多少人，也没写怎么打。",
  "所属场景": "第二章·那封信｜letter",
  "script_index": 73
 },
 {
  "序号": 73,
  "文本": "那天夜里，张辽在城里招人：谁敢跟我出城？",
  "所属场景": "第二章·那封信｜gate",
  "script_index": 74
 },
 {
  "序号": 74,
  "文本": "七千多人里，站出来八百个。",
  "所属场景": "第三章·八百人这一早｜dots",
  "script_index": 76
 },
 {
  "序号": 75,
  "文本": "张辽让人宰了牛，连夜犒劳这八百人。史书里四个字：椎牛飨士。",
  "所属场景": "第三章·八百人这一早｜quote",
  "script_index": 77
 },
 {
  "序号": 76,
  "文本": "天刚蒙蒙亮，城门打开。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 78
 },
 {
  "序号": 77,
  "文本": "张辽披上铠甲，提着长戟，第一个冲进敌阵。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 79
 },
 {
  "序号": 78,
  "文本": "他一边冲，一边大喊自己的名字。在乱军里，这一嗓子，敌我都听得见：张辽来了。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 80
 },
 {
  "序号": 79,
  "文本": "他冲破营垒，一路杀到孙权的大旗底下。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 81
 },
 {
  "序号": 80,
  "文本": "孙权大吃一惊，身边的人也不知道该怎么办。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 82
 },
 {
  "序号": 81,
  "文本": "孙权跑上一座高高的土堆，拿长戟护住自己。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 83
 },
 {
  "序号": 82,
  "文本": "张辽在下面喊他：下来打！孙权不敢动。",
  "所属场景": "第三章·八百人这一早｜quote",
  "script_index": 84
 },
 {
  "序号": 83,
  "文本": "可孙权站得高，看得清。他发现，张辽带来的人，其实很少。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 85
 },
 {
  "序号": 84,
  "文本": "于是吴军围了上来，一层又一层，把张辽围在中间。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 86
 },
 {
  "序号": 85,
  "文本": "张辽左冲右突，直往前打，硬是撕开一个口子，带着身边几十个人冲了出去。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 87
 },
 {
  "序号": 86,
  "文本": "可没冲出来的人在后面喊：将军，你不要我们了吗？",
  "所属场景": "第三章·八百人这一早｜quote",
  "script_index": 88
 },
 {
  "序号": 87,
  "文本": "张辽又掉头杀了回去，把被围的人带了出来。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 89
 },
 {
  "序号": 88,
  "文本": "史书写：孙权的人马纷纷倒退，没人敢挡。",
  "所属场景": "第三章·八百人这一早｜quote",
  "script_index": 90
 },
 {
  "序号": 89,
  "文本": "这一仗，从天亮打到中午。",
  "所属场景": "第三章·八百人这一早｜battle",
  "script_index": 91
 },
 {
  "序号": 90,
  "文本": "吴军的气势被打掉了，退回去整修营垒。城里的人心这才安定下来，几位将领也都服了。",
  "所属场景": "第三章·八百人这一早｜quote",
  "script_index": 92
 },
 {
  "序号": 91,
  "文本": "这正是张辽当初说的：先打一下，再守。",
  "所属场景": "第三章·八百人这一早｜chain",
  "script_index": 93
 },
 {
  "序号": 92,
  "文本": "孙权又围了十几天。城，始终没有打下来。",
  "所属场景": "第三章·八百人这一早｜siege",
  "script_index": 94
 },
 {
  "序号": 93,
  "文本": "他下令撤军。",
  "所属场景": "第三章·八百人这一早｜retreat",
  "script_index": 95
 },
 {
  "序号": 94,
  "文本": "按说，故事到这里该结束了。可真正最险的一刻，在撤军的路上。",
  "所属场景": "第三章·八百人这一早｜bridge",
  "script_index": 96
 },
 {
  "序号": 95,
  "文本": "先说一个细节。张辽传写到撤军，只有一句：张辽追击，差一点又抓住孙权。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 98
 },
 {
  "序号": 96,
  "文本": "在哪里追上的？怎么个差一点？张辽传没写。",
  "所属场景": "第四章·撤军路上｜bigtext",
  "script_index": 99
 },
 {
  "序号": 97,
  "文本": "要看另一边，吴国这边的记载，吴主传。",
  "所属场景": "第四章·撤军路上｜split",
  "script_index": 100
 },
 {
  "序号": 98,
  "文本": "吴主传说：合肥没打下来，撤军。大部队，都已经上路了。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 101
 },
 {
  "序号": 99,
  "文本": "孙权和凌统、甘宁这些人，还留在津北。",
  "所属场景": "第四章·撤军路上｜retreat",
  "script_index": 102
 },
 {
  "序号": 100,
  "文本": "甘宁传写得更细：军中正闹瘟疫，部队都已经先撤了，孙权身边，只剩一千多名亲卫。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 103
 },
 {
  "序号": 101,
  "文本": "津，就是渡口。甘宁传，和后来的资治通鉴，都写出了这个渡口的名字：逍遥津。",
  "所属场景": "第四章·撤军路上｜hfmap",
  "script_index": 104
 },
 {
  "序号": 102,
  "文本": "你想象一下撤军的样子。",
  "所属场景": "第四章·撤军路上｜retreat",
  "script_index": 105
 },
 {
  "序号": 103,
  "文本": "大队人马排成长长一条，前头已经走远，主帅在最后压阵，身边人不多。",
  "所属场景": "第四章·撤军路上｜retreat",
  "script_index": 106
 },
 {
  "序号": 104,
  "文本": "围城的时候，十万人是一堵墙；撤军的时候，这堵墙变成了一根拉长的线。",
  "所属场景": "第四章·撤军路上｜retreat",
  "script_index": 107
 },
 {
  "序号": 105,
  "文本": "张辽在城上看得清清楚楚，带着步兵骑兵，突然杀到。",
  "所属场景": "第四章·撤军路上｜retreat",
  "script_index": 108
 },
 {
  "序号": 106,
  "文本": "孙权赶紧派人去追前面的部队，叫他们回来救。可前军已经走远了，根本来不及。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 109
 },
 {
  "序号": 107,
  "文本": "甘宁一边拉弓射敌，一边厉声质问：军乐为什么停了？",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 110
 },
 {
  "序号": 108,
  "文本": "凌统带着三百亲兵冲进包围，护着孙权冲出来，又回头去跟张辽拼。",
  "所属场景": "第四章·撤军路上｜retreat",
  "script_index": 111
 },
 {
  "序号": 109,
  "文本": "凌统身边的人全部战死，他自己也受了伤。估计孙权已经脱险，他才撤回来。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 112
 },
 {
  "序号": 110,
  "文本": "孙权骑马冲上桥。可桥的南头，桥板已经拆了，空出一丈多。",
  "所属场景": "第四章·撤军路上｜bridge",
  "script_index": 113
 },
 {
  "序号": 111,
  "文本": "汉代一丈，大约两米三。马要跳过去，背上还驮着人。",
  "所属场景": "第四章·撤军路上｜bridge",
  "script_index": 114
 },
 {
  "序号": 112,
  "文本": "凌统传的说法略有不同：桥是被魏军毁的，连着的只剩两块桥板。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 115
 },
 {
  "序号": 113,
  "文本": "这时候，孙权身边一个叫谷利的亲近监，让孙权抓紧马鞍，放松缰绳。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 116
 },
 {
  "序号": 114,
  "文本": "谷利在后面猛抽一鞭，马往前一跃，跳了过去。",
  "所属场景": "第四章·撤军路上｜bridge",
  "script_index": 117
 },
 {
  "序号": 115,
  "文本": "这一段出自裴松之注引的江表传，故事性很强。我们照原文讲，不往上加戏。",
  "所属场景": "第四章·撤军路上｜layers",
  "script_index": 118
 },
 {
  "序号": 116,
  "文本": "桥的南边，贺齐带着三千人接应。孙权这才逃了出来。",
  "所属场景": "第四章·撤军路上｜retreat",
  "script_index": 119
 },
 {
  "序号": 117,
  "文本": "桥断了，路也断了。凌统披着铠甲，悄悄摸了回来。",
  "所属场景": "第四章·撤军路上｜bridge",
  "script_index": 120
 },
 {
  "序号": 118,
  "文本": "孙权在船上看见他，又惊又喜。凌统哭他那些没回来的亲兵，孙权拿袖子给他擦眼泪。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 121
 },
 {
  "序号": 119,
  "文本": "还有一个细节。凌统一直怨恨甘宁，因为甘宁杀了他的父亲凌操。孙权专门下令，不许凌统报仇。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 122
 },
 {
  "序号": 120,
  "文本": "可那天在津北，甘宁传写的是：与统等死战。",
  "所属场景": "第四章·撤军路上｜bigtext",
  "script_index": 123
 },
 {
  "序号": 121,
  "文本": "事后，谷利被封为都亭侯。",
  "所属场景": "第四章·撤军路上｜bigtext",
  "script_index": 124
 },
 {
  "序号": 122,
  "文本": "这时候，张辽还不知道，自己差点抓住的是谁。",
  "所属场景": "第四章·撤军路上｜bigtext",
  "script_index": 125
 },
 {
  "序号": 123,
  "文本": "他问投降的吴兵：刚才那个紫胡子的将军，上身长，腿短，骑马射箭很厉害，是谁？",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 126
 },
 {
  "序号": 124,
  "文本": "吴兵说：那是孙会稽。也就是孙权。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 127
 },
 {
  "序号": 125,
  "文本": "张辽和乐进碰了头，后悔没早知道。全军都在叹息。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 128
 },
 {
  "序号": 126,
  "文本": "而孙权上了大船，摆酒压惊。",
  "所属场景": "第四章·撤军路上｜boat",
  "script_index": 129
 },
 {
  "序号": 127,
  "文本": "贺齐离开座位，流着泪说：您是一国之主，应当时时持重。今天的事，差点就是大祸。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 130
 },
 {
  "序号": 128,
  "文本": "孙权上前收了他的眼泪，说：太惭愧了，我已经刻在心上了。",
  "所属场景": "第四章·撤军路上｜quote",
  "script_index": 131
 },
 {
  "序号": 129,
  "文本": "同一场仗，魏国这边记的，是出城那一冲；吴国这边记的，是撤退时差点被抓。",
  "所属场景": "第四章·撤军路上｜split",
  "script_index": 132
 },
 {
  "序号": 130,
  "文本": "不是谁否定谁，是各记了自己那一半。",
  "所属场景": "第四章·撤军路上｜split",
  "script_index": 133
 },
 {
  "序号": 131,
  "文本": "那么，后来流传最广的那句话，又是从哪来的？",
  "所属场景": "第四章·撤军路上｜bigtext",
  "script_index": 134
 },
 {
  "序号": 132,
  "文本": "很多人都听过：张辽威震逍遥津，江东的小孩，听到他的名字都不敢哭。",
  "所属场景": "第五章·那句话从哪来｜bigtext",
  "script_index": 136
 },
 {
  "序号": 133,
  "文本": "可你去翻三国志，张辽传里没有这句，吴主传里没有，资治通鉴里也没有。",
  "所属场景": "第五章·那句话从哪来｜layers",
  "script_index": 137
 },
 {
  "序号": 134,
  "文本": "目前能对到的较早出处，在宋代编的一部大类书，太平御览，第四百八十八卷。",
  "所属场景": "第五章·那句话从哪来｜layers",
  "script_index": 138
 },
 {
  "序号": 135,
  "文本": "有意思的是，这一卷归在“泣”这个类目下面，专门收和哭有关的句子。",
  "所属场景": "第五章·那句话从哪来｜bigtext",
  "script_index": 139
 },
 {
  "序号": 136,
  "文本": "它引了一部叫魏略的书：张辽被孙权围住，冲出包围，又杀回去，孙权的人马败走，从此威震江东。小孩哭个不停，父母就拿张辽来吓唬他。",
  "所属场景": "第五章·那句话从哪来｜quote",
  "script_index": 140
 },
 {
  "序号": 137,
  "文本": "魏略原书早就失传了，这几句话，是靠类书转引才留下来的。",
  "所属场景": "第五章·那句话从哪来｜layers",
  "script_index": 141
 },
 {
  "序号": 138,
  "文本": "而且你注意，父母拿他吓小孩，这是街头巷尾的风声，不是军报。",
  "所属场景": "第五章·那句话从哪来｜bigtext",
  "script_index": 142
 },
 {
  "序号": 139,
  "文本": "到了唐代，有一本给孩子念的启蒙书，叫蒙求，里面有一句：张辽止啼。",
  "所属场景": "第五章·那句话从哪来｜quote",
  "script_index": 143
 },
 {
  "序号": 140,
  "文本": "再往后，三国演义写成：闻张辽大名，小儿也不敢夜啼。",
  "所属场景": "第五章·那句话从哪来｜quote",
  "script_index": 144
 },
 {
  "序号": 141,
  "文本": "一句话，就这样从风声，走进了启蒙书里的典故，又走进了小说。",
  "所属场景": "第五章·那句话从哪来｜layers",
  "script_index": 145
 },
 {
  "序号": 142,
  "文本": "那正史里，能看出张辽名声的，是哪一句？",
  "所属场景": "第五章·那句话从哪来｜bigtext",
  "script_index": 146
 },
 {
  "序号": 143,
  "文本": "七年以后，张辽病了。孙权还专门告诫部下：张辽虽然病了，也挡不住，千万小心。",
  "所属场景": "第五章·那句话从哪来｜quote",
  "script_index": 147
 },
 {
  "序号": 144,
  "文本": "说这话的，是当年在津桥上差点被他抓住的那个人。",
  "所属场景": "第五章·那句话从哪来｜bridge",
  "script_index": 148
 },
 {
  "序号": 145,
  "文本": "那八百破十万呢？",
  "所属场景": "第五章·那句话从哪来｜bigtext",
  "script_index": 149
 },
 {
  "序号": 146,
  "文本": "这句出自魏文帝曹丕的诏书，是十年以后，追念功臣时写的。",
  "所属场景": "第五章·那句话从哪来｜quote",
  "script_index": 150
 },
 {
  "序号": 147,
  "文本": "注意，诏书里写的是张辽、李典两个人。而十万，是孙权的号称；诏书是表彰，会把反差放大。",
  "所属场景": "第五章·那句话从哪来｜bigtext",
  "script_index": 151
 },
 {
  "序号": 148,
  "文本": "张辽传里还有一个细节：当年跟着张辽出城的那些应募步兵，后来都做了虎贲，成了皇帝的卫士。",
  "所属场景": "第五章·那句话从哪来｜quote",
  "script_index": 152
 },
 {
  "序号": 149,
  "文本": "最后，回到合肥。",
  "所属场景": "尾声·回到合肥｜walk",
  "script_index": 154
 },
 {
  "序号": 150,
  "文本": "第二年，曹操又来打孙权，到了合肥。",
  "所属场景": "尾声·回到合肥｜walk",
  "script_index": 155
 },
 {
  "序号": 151,
  "文本": "他在张辽当年打仗的地方，来回走了一遍，叹息了很久。",
  "所属场景": "尾声·回到合肥｜quote",
  "script_index": 156
 },
 {
  "序号": 152,
  "文本": "他在叹息什么，史书没有写。",
  "所属场景": "尾声·回到合肥｜walk",
  "script_index": 157
 },
 {
  "序号": 153,
  "文本": "我们只知道，他出发之前，留下过一封信。",
  "所属场景": "尾声·回到合肥｜letter",
  "script_index": 158
 },
 {
  "序号": 154,
  "文本": "一句给张辽和李典：出战。一句给乐进：守城。",
  "所属场景": "尾声·回到合肥｜letter",
  "script_index": 159
 },
 {
  "序号": 155,
  "文本": "三个人，谁也不服谁。",
  "所属场景": "尾声·回到合肥｜roster",
  "script_index": 160
 },
 {
  "序号": 156,
  "文本": "信封边上，是那五个字：贼至乃发。",
  "所属场景": "尾声·回到合肥｜letter",
  "script_index": 161
 }
]