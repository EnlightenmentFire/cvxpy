[
 {
  "id": "L001",
  "scene": "hook",
  "text": "感同身受，听起来是一种美德。",
  "pause_after": 0.35,
  "start": 0.5,
  "end": 3.341
 },
 {
  "id": "L002",
  "scene": "hook",
  "text": "可科学家发现：只练感同身受，人会更痛苦。",
  "pause_after": 0.35,
  "start": 3.691,
  "end": 8.182
 },
 {
  "id": "L003",
  "scene": "hook",
  "text": "换一种练法，结果完全不同。",
  "pause_after": 0.6,
  "start": 8.532,
  "end": 11.313
 },
 {
  "id": "L004",
  "scene": "brain2",
  "text": "同样是看别人受苦，大脑里亮起来的，可以是两套几乎不重叠的网络。",
  "pause_after": 0.45,
  "start": 11.913,
  "end": 17.66
 },
 {
  "id": "L005",
  "scene": "brain2",
  "text": "一套，连着难受和退缩；另一套，连着温暖和伸手。",
  "pause_after": 0.6,
  "start": 18.11,
  "end": 23.238
 },
 {
  "id": "L006",
  "scene": "burnout",
  "text": "医生、护士、心理咨询师，天天面对别人的痛苦。",
  "pause_after": 0.45,
  "start": 23.838,
  "end": 28.91
 },
 {
  "id": "L007",
  "scene": "burnout",
  "text": "做这项研究的科学家在论文里就写到：医生的职业倦怠率很高。",
  "pause_after": 0.45,
  "start": 29.36,
  "end": 34.16
 },
 {
  "id": "L008",
  "scene": "burnout",
  "text": "人们常把这种耗竭叫作“同情疲劳”。",
  "pause_after": 0.5,
  "start": 34.61,
  "end": 37.174
 },
 {
  "id": "L009",
  "scene": "rename",
  "text": "可德国马普研究所的神经科学家辛格和她的同事认为，这个名字可能叫错了。",
  "pause_after": 0.45,
  "start": 37.674,
  "end": 43.165
 },
 {
  "id": "L010",
  "scene": "rename",
  "text": "把人累垮的，也许不是慈悲，而是另一种东西，叫“共情痛苦”。",
  "pause_after": 0.6,
  "start": 43.615,
  "end": 48.688
 },
 {
  "id": "L011",
  "scene": "rename",
  "text": "这期就讲清楚三件事：这两条路有什么不同，能不能练，证据又到哪里为止。",
  "pause_after": 0.8,
  "start": 49.288,
  "end": 55.524
 },
 {
  "id": "L012",
  "scene": "exp_intro",
  "text": "先看一个实验。",
  "pause_after": 0.45,
  "start": 56.324,
  "end": 57.433
 },
 {
  "id": "L013",
  "scene": "exp_intro",
  "text": "二零一四年，克里梅茨基、辛格等人在《社会认知与情感神经科学》上发表了一项研究，合作者里还有马蒂厄·里卡尔。",
  "pause_after": 0.45,
  "start": 57.883,
  "end": 67.21
 },
 {
  "id": "L014",
  "scene": "exp_design",
  "text": "参与者都是女性，分成两组。",
  "pause_after": 0.45,
  "start": 67.66,
  "end": 70.279
 },
 {
  "id": "L015",
  "scene": "exp_design",
  "text": "一组先练同理心，再练慈悲；另一组做记忆训练，作为对照。",
  "pause_after": 0.45,
  "start": 70.729,
  "end": 76.201
 },
 {
  "id": "L016",
  "scene": "exp_video",
  "text": "每次训练前后，她们都躺进核磁共振扫描仪，看一段段十几秒的短片。",
  "pause_after": 0.45,
  "start": 76.651,
  "end": 82.615
 },
 {
  "id": "L017",
  "scene": "exp_video",
  "text": "短片取自新闻和纪录片：有人受了伤，有人遭遇天灾。",
  "pause_after": 0.45,
  "start": 83.065,
  "end": 87.629
 },
 {
  "id": "L018",
  "scene": "exp_video",
  "text": "每看完一段，她们给自己打分：有多感同身受，积极情绪有多少，消极情绪有多少。",
  "pause_after": 0.6,
  "start": 88.079,
  "end": 95.315
 },
 {
  "id": "L019",
  "scene": "exp_emp",
  "text": "第一步，同理心训练。练的是共鸣，真切地去感受对方的痛苦。",
  "pause_after": 0.45,
  "start": 95.915,
  "end": 101.751
 },
 {
  "id": "L020",
  "scene": "exp_emp",
  "text": "几天下来，变化很明显。",
  "pause_after": 0.45,
  "start": 102.201,
  "end": 104.783
 },
 {
  "id": "L021",
  "scene": "exp_emp",
  "text": "她们确实更能感同身受了，但消极情绪也跟着往上走。",
  "pause_after": 0.45,
  "start": 105.233,
  "end": 109.506
 },
 {
  "id": "L022",
  "scene": "brain_emp",
  "text": "大脑里，前脑岛和前扣带中部的活动增强了。",
  "pause_after": 0.45,
  "start": 109.956,
  "end": 114.01
 },
 {
  "id": "L023",
  "scene": "brain_emp",
  "text": "在以往大量研究里，这两个区域都和“感受他人的疼痛”有关。",
  "pause_after": 0.45,
  "start": 114.46,
  "end": 119.206
 },
 {
  "id": "L024",
  "scene": "brain_emp",
  "text": "换句话说，她们把别人的痛，更多地变成了自己的痛。",
  "pause_after": 0.7,
  "start": 119.656,
  "end": 123.82
 },
 {
  "id": "L025",
  "scene": "exp_comp",
  "text": "第二步，在同一批人身上，接着做慈悲训练。",
  "pause_after": 0.45,
  "start": 124.52,
  "end": 128.61
 },
 {
  "id": "L026",
  "scene": "exp_comp",
  "text": "练法很朴素：先想一个亲近的人，祝愿他平安喜乐；再把这份善意，慢慢扩展到陌生人，甚至关系不好的人。",
  "pause_after": 0.45,
  "start": 129.06,
  "end": 138.17
 },
 {
  "id": "L027",
  "scene": "exp_comp",
  "text": "关键在于，接下来看的短片，同样令人难过。",
  "pause_after": 0.6,
  "start": 138.62,
  "end": 142.492
 },
 {
  "id": "L028",
  "scene": "chart",
  "text": "结果，消极情绪回落到了训练前的水平，积极情绪反而上升了。",
  "pause_after": 0.45,
  "start": 143.092,
  "end": 148.492
 },
 {
  "id": "L029",
  "scene": "brain_comp",
  "text": "大脑里亮起的，是另一组区域：腹侧纹状体、膝前扣带回、内侧眶额皮层。",
  "pause_after": 0.45,
  "start": 148.942,
  "end": 155.858
 },
 {
  "id": "L030",
  "scene": "brain_comp",
  "text": "以往的研究，常把这组网络和积极情绪、亲近与奖赏联系在一起。",
  "pause_after": 0.45,
  "start": 156.308,
  "end": 161.835
 },
 {
  "id": "L031",
  "scene": "brain_comp",
  "text": "两组区域，几乎不重叠。",
  "pause_after": 0.7,
  "start": 162.285,
  "end": 164.849
 },
 {
  "id": "L032",
  "scene": "k13",
  "text": "这并不是孤例。",
  "pause_after": 0.45,
  "start": 165.549,
  "end": 166.646
 },
 {
  "id": "L033",
  "scene": "k13",
  "text": "同一团队更早在《大脑皮层》期刊发表的研究里，参与者只练慈悲，不先练同理心。",
  "pause_after": 0.45,
  "start": 167.096,
  "end": 173.605
 },
 {
  "id": "L034",
  "scene": "k13",
  "text": "几天之后，即便看到别人受苦的画面，她们报告的积极情绪也增加了。",
  "pause_after": 0.45,
  "start": 174.055,
  "end": 179.802
 },
 {
  "id": "L035",
  "scene": "k13",
  "text": "增强的，同样是和积极情绪、亲近感有关的一组网络。",
  "pause_after": 0.7,
  "start": 180.252,
  "end": 184.979
 },
 {
  "id": "L036",
  "scene": "quote_k14",
  "text": "论文的结论写得很克制。",
  "pause_after": 0.45,
  "start": 185.679,
  "end": 187.698
 },
 {
  "id": "L037",
  "scene": "quote_k14",
  "text": "训练慈悲，可能是一种新的应对方式，帮助人克服共情痛苦，增强韧性。",
  "pause_after": 0.6,
  "start": 188.148,
  "end": 194.402
 },
 {
  "id": "L038",
  "scene": "caveat1",
  "text": "注意这个“可能”。",
  "pause_after": 0.45,
  "start": 195.002,
  "end": 196.075
 },
 {
  "id": "L039",
  "scene": "caveat1",
  "text": "这是一项小研究：坚持到最后的，同理心加慈悲组二十五人，记忆对照组二十八人，全是女性，以二十多岁的年轻人为主。",
  "pause_after": 0.45,
  "start": 196.525,
  "end": 206.634
 },
 {
  "id": "L040",
  "scene": "caveat1",
  "text": "两组是先后招募的，不是同时随机分组；两种训练也是按固定顺序练的。",
  "pause_after": 0.45,
  "start": 207.084,
  "end": 213.175
 },
 {
  "id": "L041",
  "scene": "caveat1",
  "text": "所以它揭示的是一个值得重视的模式，还不是定论。",
  "pause_after": 0.8,
  "start": 213.625,
  "end": 218.098
 },
 {
  "id": "L042",
  "scene": "define",
  "text": "那么，同理心和慈悲，到底差在哪儿？",
  "pause_after": 0.45,
  "start": 218.898,
  "end": 222.461
 },
 {
  "id": "L043",
  "scene": "define",
  "text": "同一年，辛格和克里梅茨基在《当代生物学》上写了一篇综述，把它讲得很清楚。",
  "pause_after": 0.45,
  "start": 222.911,
  "end": 229.002
 },
 {
  "id": "L044",
  "scene": "define",
  "text": "同理心，是分享别人的感受：你疼，我也跟着疼。",
  "pause_after": 0.45,
  "start": 229.452,
  "end": 234.452
 },
 {
  "id": "L045",
  "scene": "define",
  "text": "健康的同理心，还知道“这是你的疼”，自他分明。",
  "pause_after": 0.45,
  "start": 234.902,
  "end": 239.029
 },
 {
  "id": "L046",
  "scene": "define",
  "text": "如果连“这是谁的疼”都分不清，那叫情绪传染，婴儿身上就有。",
  "pause_after": 0.45,
  "start": 239.479,
  "end": 244.807
 },
 {
  "id": "L047",
  "scene": "define",
  "text": "一旦这条界线模糊了，别人的苦，就整个压到了自己身上。",
  "pause_after": 0.6,
  "start": 245.257,
  "end": 250.002
 },
 {
  "id": "L048",
  "scene": "twopath",
  "text": "面对他人的苦，接下来会分出两条路。",
  "pause_after": 0.45,
  "start": 250.602,
  "end": 253.729
 },
 {
  "id": "L049",
  "scene": "twopath",
  "text": "一条是共情痛苦：强烈的、以自己为中心的难受，只想退开，保护自己。",
  "pause_after": 0.45,
  "start": 254.179,
  "end": 261.107
 },
 {
  "id": "L050",
  "scene": "twopath",
  "text": "长期如此，很可能损害身心健康。",
  "pause_after": 0.45,
  "start": 261.557,
  "end": 264.92
 },
 {
  "id": "L051",
  "scene": "twopath",
  "text": "另一条是慈悲：不是陪着一起疼，而是对对方怀着温暖和关切，想让他好起来。",
  "pause_after": 0.45,
  "start": 265.37,
  "end": 272.007
 },
 {
  "id": "L052",
  "scene": "twopath",
  "text": "它带来的是靠近，是想去帮忙的动机。",
  "pause_after": 0.6,
  "start": 272.457,
  "end": 275.566
 },
 {
  "id": "L053",
  "scene": "quote_sk",
  "text": "综述里有一句话，说得最干脆。",
  "pause_after": 0.45,
  "start": 276.166,
  "end": 278.857
 },
 {
  "id": "L054",
  "scene": "quote_sk",
  "text": "慈悲，是为对方而感受，而不是跟着对方一起感受。",
  "pause_after": 0.7,
  "start": 279.307,
  "end": 283.891
 },
 {
  "id": "L055",
  "scene": "ink",
  "text": "打个比方。两个人，看见同一个人落了水。",
  "pause_after": 0.45,
  "start": 284.591,
  "end": 288.046
 },
 {
  "id": "L056",
  "scene": "ink",
  "text": "一个人二话不说跳下去，陪着一起挣扎，最后两个人都没了力气。",
  "pause_after": 0.45,
  "start": 288.496,
  "end": 293.605
 },
 {
  "id": "L057",
  "scene": "ink",
  "text": "另一个人先站稳脚跟，找来一根长竿，伸了过去。",
  "pause_after": 0.45,
  "start": 294.055,
  "end": 297.746
 },
 {
  "id": "L058",
  "scene": "ink",
  "text": "两个人都不冷漠，都被深深触动了。区别在于，触动之后，力气用在了哪里。",
  "pause_after": 0.45,
  "start": 298.196,
  "end": 304.923
 },
 {
  "id": "L059",
  "scene": "ink",
  "text": "这只是一个类比，帮助理解，不是实验结果。",
  "pause_after": 0.6,
  "start": 305.373,
  "end": 309.409
 },
 {
  "id": "L060",
  "scene": "helping",
  "text": "不过，行为上的证据也有。",
  "pause_after": 0.45,
  "start": 310.009,
  "end": 312.246
 },
 {
  "id": "L061",
  "scene": "helping",
  "text": "社会心理学家巴特森、艾森伯格等人的研究早就发现：在同样的情境里，生起慈悲的人，比陷入共情痛苦的人，更常出手相助。",
  "pause_after": 0.45,
  "start": 312.696,
  "end": 322.968
 },
 {
  "id": "L062",
  "scene": "helping",
  "text": "辛格团队另一项研究发现，练过慈悲的人，在一个电脑游戏里，更愿意出手帮助陌生人。",
  "pause_after": 0.8,
  "start": 323.418,
  "end": 330.237
 },
 {
  "id": "L063",
  "scene": "helping",
  "text": "另有研究者发现，坚持几周的慈心练习，能让人在日常生活中报告更多的积极情绪。",
  "pause_after": 0.8,
  "start": 331.037,
  "end": 338.091
 },
 {
  "id": "L064",
  "scene": "resource",
  "text": "小研究的说服力有限。那么，更大的样本呢？",
  "pause_after": 0.45,
  "start": 338.891,
  "end": 342.637
 },
 {
  "id": "L065",
  "scene": "resource",
  "text": "辛格团队后来做了一个大型训练项目，名字就叫“资源”。",
  "pause_after": 0.45,
  "start": 343.087,
  "end": 347.105
 },
 {
  "id": "L066",
  "scene": "resource",
  "text": "三百三十二名二十到五十五岁的健康成年人，训练九个月，分成三个模块，每个三个月。",
  "pause_after": 0.45,
  "start": 347.555,
  "end": 354.391
 },
 {
  "id": "L067",
  "scene": "modules",
  "text": "第一个模块练“当下”：专注呼吸、觉察身体，类似常见的正念练习。",
  "pause_after": 0.45,
  "start": 354.841,
  "end": 360.587
 },
 {
  "id": "L068",
  "scene": "modules",
  "text": "第二个模块练“情感”：慈悲、面对困难情绪、助人的动机。",
  "pause_after": 0.45,
  "start": 361.037,
  "end": 366.073
 },
 {
  "id": "L069",
  "scene": "modules",
  "text": "第三个模块练“视角”：理解别人在想什么，也反观自己的念头。",
  "pause_after": 0.45,
  "start": 366.523,
  "end": 371.414
 },
 {
  "id": "L070",
  "scene": "modules",
  "text": "另有一组人不训练，只在同一时间做同样的测量，作为对照。",
  "pause_after": 0.6,
  "start": 371.864,
  "end": 376.955
 },
 {
  "id": "L071",
  "scene": "cortex",
  "text": "二零一七年，《科学进展》发表了结果：三种练法，对应大脑皮层不同区域的厚度变化。",
  "pause_after": 0.45,
  "start": 377.555,
  "end": 384.355
 },
 {
  "id": "L072",
  "scene": "cortex",
  "text": "练专注，变化多在前额叶；练慈悲和情感，变化在额叶和脑岛一带；练换位思考，变化在额下回和颞叶外侧。",
  "pause_after": 0.45,
  "start": 384.805,
  "end": 394.987
 },
 {
  "id": "L073",
  "scene": "cortex",
  "text": "而且，大脑哪里变得多，对应的能力测验往往也进步得多。",
  "pause_after": 0.45,
  "start": 395.437,
  "end": 399.964
 },
 {
  "id": "L074",
  "scene": "cortex",
  "text": "这提示我们：冥想不是一种东西。练什么，就长什么。",
  "pause_after": 0.6,
  "start": 400.414,
  "end": 405.541
 },
 {
  "id": "L075",
  "scene": "cortex_cav",
  "text": "同样要说清楚：参与者九成五以上是白人，都是健康成年人；皮层厚度是间接指标，不等于一个人变得更善良了。",
  "pause_after": 0.9,
  "start": 406.141,
  "end": 415.323
 },
 {
  "id": "L076",
  "scene": "limits",
  "text": "说到这里，得踩一脚刹车。",
  "pause_after": 0.45,
  "start": 416.223,
  "end": 418.714
 },
 {
  "id": "L077",
  "scene": "limits",
  "text": "二零一八年，范丹等十几位学者发表长文，题目就叫《警惕炒作》。",
  "pause_after": 0.45,
  "start": 419.164,
  "end": 425.164
 },
 {
  "id": "L078",
  "scene": "limits",
  "text": "他们提醒：冥想研究常见的问题，包括方法粗糙、对照不足、媒体夸大，还有被低估的不良反应。",
  "pause_after": 0.6,
  "start": 425.614,
  "end": 433.687
 },
 {
  "id": "L079",
  "scene": "limits3",
  "text": "放到今天这个题目上，至少有三点要记住。",
  "pause_after": 0.45,
  "start": 434.287,
  "end": 437.468
 },
 {
  "id": "L080",
  "scene": "limits3",
  "text": "第一，情绪多是自己打分。参与者知道自己在练慈悲，可能不自觉地往好里说，这叫期待效应。",
  "pause_after": 0.45,
  "start": 437.918,
  "end": 445.973
 },
 {
  "id": "L081",
  "scene": "limits3",
  "text": "第二，某个脑区亮了，不等于找到了“慈悲中枢”；同一个脑区，往往参与很多功能。",
  "pause_after": 0.45,
  "start": 446.423,
  "end": 453.732
 },
 {
  "id": "L082",
  "scene": "limits3",
  "text": "第三，也是最重要的：慈悲训练，不能替代休息，不能替代合理的排班和制度支持，也不能替代专业帮助。",
  "pause_after": 0.6,
  "start": 454.182,
  "end": 462.491
 },
 {
  "id": "L083",
  "scene": "limits3",
  "text": "如果你已经长期失眠、麻木、提不起劲，请先去找专业的人聊一聊。",
  "pause_after": 0.9,
  "start": 463.091,
  "end": 468.364
 },
 {
  "id": "L084",
  "scene": "practice",
  "text": "那么，普通人能从这些研究里带走什么？",
  "pause_after": 0.45,
  "start": 469.264,
  "end": 472.282
 },
 {
  "id": "L085",
  "scene": "practice",
  "text": "不妨试试一个很小的转向。",
  "pause_after": 0.45,
  "start": 472.732,
  "end": 474.805
 },
 {
  "id": "L086",
  "scene": "practice",
  "text": "当你发现自己正“跟着一起疼”，先停一下，感受双脚踩在地上，做几次缓慢的呼吸。",
  "pause_after": 0.45,
  "start": 475.255,
  "end": 482.0
 },
 {
  "id": "L087",
  "scene": "practice",
  "text": "提醒自己：这是他的苦，我在这里陪他。",
  "pause_after": 0.45,
  "start": 482.45,
  "end": 485.796
 },
 {
  "id": "L088",
  "scene": "practice",
  "text": "然后把注意力，从“我好难受”，轻轻转到“我能为他做点什么”。",
  "pause_after": 0.45,
  "start": 486.246,
  "end": 491.318
 },
 {
  "id": "L089",
  "scene": "practice",
  "text": "哪怕只是递一杯热水，听他把话说完。",
  "pause_after": 0.45,
  "start": 491.768,
  "end": 494.805
 },
 {
  "id": "L090",
  "scene": "practice",
  "text": "这是从研究的区分里得出的生活建议，不是经过检验的疗法。",
  "pause_after": 0.9,
  "start": 495.255,
  "end": 499.746
 },
 {
  "id": "L091",
  "scene": "scroll",
  "text": "说回一部一千六百多年前译出的论。",
  "pause_after": 0.45,
  "start": 500.646,
  "end": 503.246
 },
 {
  "id": "L092",
  "scene": "scroll",
  "text": "《大智度论》，龙树造，鸠摩罗什译。第二十七卷，专门解释什么是大慈大悲。",
  "pause_after": 0.45,
  "start": 503.696,
  "end": 510.696
 },
 {
  "id": "L093",
  "scene": "quote_dz1",
  "text": "大慈与一切众生乐，大悲拔一切众生苦。",
  "pause_after": 0.7,
  "start": 511.146,
  "end": 514.691
 },
 {
  "id": "L094",
  "scene": "quote_dz1",
  "text": "慈，是给人快乐；悲，是拔除痛苦。",
  "pause_after": 0.6,
  "start": 515.391,
  "end": 519.937
 },
 {
  "id": "L095",
  "scene": "quote_dz1",
  "text": "论里还打了个比方：一个人的几个孩子被关进牢狱，要受重罪。",
  "pause_after": 0.45,
  "start": 520.537,
  "end": 525.664
 },
 {
  "id": "L096",
  "scene": "quote_dz1",
  "text": "父亲心疼他们，想尽种种办法，让他们免于受苦，这是大悲；出来以后，再给他们好的生活，这是大慈。",
  "pause_after": 0.45,
  "start": 526.114,
  "end": 535.768
 },
 {
  "id": "L097",
  "scene": "quote_dz1",
  "text": "这位父亲，不只是陪着哭，他去找办法。",
  "pause_after": 0.7,
  "start": 536.218,
  "end": 539.891
 },
 {
  "id": "L098",
  "scene": "quote_dz2",
  "text": "同一卷里，还有一段更耐人寻味的对比。",
  "pause_after": 0.45,
  "start": 540.591,
  "end": 543.937
 },
 {
  "id": "L099",
  "scene": "quote_dz2",
  "text": "小悲，只是看着众生身心的种种苦，心生怜悯，却不能让他脱离。",
  "pause_after": 0.45,
  "start": 544.387,
  "end": 550.314
 },
 {
  "id": "L100",
  "scene": "quote_dz2",
  "text": "大悲，不但怜悯众生的苦，还能帮他脱苦。",
  "pause_after": 0.6,
  "start": 550.764,
  "end": 554.964
 },
 {
  "id": "L101",
  "scene": "quote_dz2",
  "text": "只陪着难过，是不够的；要有力气，把人拉上来。",
  "pause_after": 0.7,
  "start": 555.564,
  "end": 559.964
 },
 {
  "id": "L102",
  "scene": "yinzhao",
  "text": "这和研究里的两条路，有相通之处。",
  "pause_after": 0.45,
  "start": 560.664,
  "end": 563.628
 },
 {
  "id": "L103",
  "scene": "yinzhao",
  "text": "但要说清楚：这是印照，不是证明。",
  "pause_after": 0.45,
  "start": 564.078,
  "end": 567.478
 },
 {
  "id": "L104",
  "scene": "yinzhao",
  "text": "古人讲的是修行的境界，科学家测的是看短片时的情绪和脑血流，两者不是一回事。",
  "pause_after": 0.45,
  "start": 567.928,
  "end": 575.0
 },
 {
  "id": "L105",
  "scene": "yinzhao",
  "text": "或许佛学的讲法，也有一些科学基础，算是一种印照。",
  "pause_after": 0.8,
  "start": 575.45,
  "end": 579.832
 },
 {
  "id": "L106",
  "scene": "quote_dz3",
  "text": "论中还说，因为大慈悲的力量，菩萨在无量的生死之中，心不厌莫。",
  "pause_after": 0.6,
  "start": 580.632,
  "end": 586.468
 },
 {
  "id": "L107",
  "scene": "quote_dz3",
  "text": "不厌倦，也不沉没。",
  "pause_after": 0.7,
  "start": 587.068,
  "end": 589.214
 },
 {
  "id": "L108",
  "scene": "dawn",
  "text": "所以，下一次陪伴别人的痛苦时，先让自己站稳。",
  "pause_after": 0.5,
  "start": 589.914,
  "end": 593.917
 },
 {
  "id": "L109",
  "scene": "dawn",
  "text": "慈悲不是一起沉下去，而是有力气伸出手。",
  "pause_after": 1.2,
  "start": 594.417,
  "end": 597.854
 }
]