 ],
 "subs": [
  {
   "start": 3.8,
   "end": 5.542,
   "text": "这一幕，没有发生",
   "line": "a01"
  },
  {
   "start": 5.802,
   "end": 10.574,
   "text": "可是在1962年10月27日的晚上\n它离发生，只差一个人",
   "line": "a02"
  },
  {
   "start": 14.6,
   "end": 19.418,
   "text": "1962年10月14日\n美国的U-2高空侦察机飞过古巴",
   "line": "b01"
  },
  {
   "start": 19.438,
   "end": 22.495,
   "text": "拍下了这张照片\n苏联的中程导弹阵地",
   "line": "b01"
  },
  {
   "start": 22.755,
   "end": 26.832,
   "text": "古巴导弹危机由此开始\n苏联在古巴秘密部署核导弹",
   "line": "b02"
  },
  {
   "start": 26.852,
   "end": 30.097,
   "text": "美国发现后封锁古巴\n双方对峙了十三天",
   "line": "b02"
  },
  {
   "start": 30.317,
   "end": 33.382,
   "text": "从古巴打出去\n这种导弹够得着华盛顿",
   "line": "b03"
  },
  {
   "start": 33.617,
   "end": 37.058,
   "text": "10月22日\n肯尼迪宣布对古巴“隔离”",
   "line": "b04"
  },
  {
   "start": 37.078,
   "end": 41.096999999999994,
   "text": "其实就是海上封锁\n美国海军在古巴外海划一条线",
   "line": "b04"
  },
  {
   "start": 41.117,
   "end": 42.543,
   "text": "苏联船到线就拦",
   "line": "b04"
  },
  {
   "start": 42.75,
   "end": 44.599,
   "text": "两天后\n美国战略空军的",
   "line": "b05"
  },
  {
   "start": 44.619,
   "end": 47.028999999999996,
   "text": "战备等级升到DEFCON 2",
   "line": "b05"
  },
  {
   "start": 47.049,
   "end": 51.615,
   "text": "DEFCON是美军的战备等级\n数字越小，越接近开战",
   "line": "b05"
  },
  {
   "start": 51.85,
   "end": 54.407999999999994,
   "text": "全世界都盯着白宫和克里姆林宫",
   "line": "b06"
  },
  {
   "start": 54.428,
   "end": 58.192,
   "text": "其实这十三天\n肯尼迪和赫鲁晓夫一直在找台阶",
   "line": "b06"
  },
  {
   "start": 58.417,
   "end": 62.997,
   "text": "可没人注意到，大西洋底下\n四艘苏联潜艇正开往古巴",
   "line": "b07"
  },
  {
   "start": 63.017,
   "end": 67.497,
   "text": "每一艘都带着一枚核鱼雷\n也就是弹头是核弹的鱼雷",
   "line": "b07"
  },
  {
   "start": 67.757,
   "end": 69.375,
   "text": "美国海军并不知道",
   "line": "b08"
  },
  {
   "start": 70.1,
   "end": 73.269,
   "text": "10月27日\n后来被称作“黑色星期六”",
   "line": "c01"
  },
  {
   "start": 73.289,
   "end": 75.672,
   "text": "这一天，三个地方亮起了红灯",
   "line": "c01"
  },
  {
   "start": 75.883,
   "end": 80.09,
   "text": "古巴上空，一架U-2被萨姆导弹击落\n飞行员身亡",
   "line": "c02"
  },
  {
   "start": 80.11,
   "end": 83.071,
   "text": "萨姆导弹，就是苏联的地对空导弹",
   "line": "c02"
  },
  {
   "start": 83.331,
   "end": 86.111,
   "text": "据后来的研究\n下令开火的是当地苏军",
   "line": "c03"
  },
  {
   "start": 86.131,
   "end": 87.611,
   "text": "没有等莫斯科批准",
   "line": "c03"
  },
  {
   "start": 87.817,
   "end": 91.74000000000001,
   "text": "北极上空，另一架U-2迷了航\n闯进苏联领空",
   "line": "c04"
  },
  {
   "start": 91.76,
   "end": 95.29,
   "text": "米格战斗机起飞拦截\n美国截击机赶去接应",
   "line": "c04"
  },
  {
   "start": 95.31,
   "end": 97.559,
   "text": "机翼下挂的是核空空导弹",
   "line": "c04"
  },
  {
   "start": 99.267,
   "end": 101.901,
   "text": "第三个红点，在大西洋的海底",
   "line": "c05"
  },
  {
   "start": 102.161,
   "end": 104.917,
   "text": "三个地方都离华盛顿和莫斯科很远",
   "line": "c06"
  },
  {
   "start": 104.937,
   "end": 108.164,
   "text": "这一天\n扳机落在了离中心最远的人手里",
   "line": "c06"
  },
  {
   "start": 108.65,
   "end": 113.32900000000001,
   "text": "B-59是一艘柴电潜艇\n在水面开柴油机给电池充电",
   "line": "d01"
  },
  {
   "start": 113.349,
   "end": 114.96300000000001,
   "text": "潜到水下全靠电池",
   "line": "d01"
  },
  {
   "start": 114.983,
   "end": 117.515,
   "text": "电池一耗光，就必须浮上来",
   "line": "d01"
  },
  {
   "start": 117.775,
   "end": 121.422,
   "text": "它是为北极冷水造的\n却泡在温暖的马尾藻海里",
   "line": "d02"
  },
  {
   "start": 121.442,
   "end": 124.54,
   "text": "据艇上的无线电侦听\n组长奥尔洛夫回忆",
   "line": "d02"
  },
  {
   "start": 124.56,
   "end": 129.224,
   "text": "最凉快的舱也有45度左右\n人“像多米诺骨牌一样”倒下",
   "line": "d02"
  },
  {
   "start": 129.484,
   "end": 131.938,
   "text": "他们已经两天收不到莫斯科的消息",
   "line": "d03"
  },
  {
   "start": 131.958,
   "end": 135.502,
   "text": "最后听到的广播让他们以为\n战争可能已经打响了",
   "line": "d03"
  },
  {
   "start": 135.717,
   "end": 137.489,
   "text": "这时，美国人来“敲门”了",
   "line": "d04"
  },
  {
   "start": 137.749,
   "end": 142.224,
   "text": "美国早就通过外交渠道通知了苏联\n美舰会投四五颗训练深弹",
   "line": "d05"
  },
  {
   "start": 142.244,
   "end": 145.783,
   "text": "这种弹只会响，炸不穿船\n意思是“请浮上来”",
   "line": "d05"
  },
  {
   "start": 146.043,
   "end": 148.809,
   "text": "可是没有证据表明\n通知传到了潜艇上",
   "line": "d06"
  },
  {
   "start": 148.829,
   "end": 150.898,
   "text": "几位艇长都说，从没收到过",
   "line": "d06"
  },
  {
   "start": 150.918,
   "end": 153.262,
   "text": "信号发出去了，收件人没收到",
   "line": "d06"
  },
  {
   "start": 153.483,
   "end": 156.052,
   "text": "10月27日傍晚\n驱逐舰比尔号和",
   "line": "d07"
  },
  {
   "start": 156.072,
   "end": 157.778,
   "text": "科尼号先后投下手榴弹",
   "line": "d07"
  },
  {
   "start": 157.798,
   "end": 162.60999999999999,
   "text": "比尔号的值更军官后来回忆\n水兵们用卫生纸卷筒把手榴弹包起来",
   "line": "d07"
  },
  {
   "start": 162.63,
   "end": 165.471,
   "text": "让它沉到深处再炸\n正好炸在潜艇旁边",
   "line": "d07"
  },
  {
   "start": 165.731,
   "end": 168.52499999999998,
   "text": "在美国人看来，这是把门敲得更响",
   "line": "d08"
  },
  {
   "start": 168.545,
   "end": 172.088,
   "text": "在艇里，奥尔洛夫说\n就像坐在一个汽油桶里",
   "line": "d08"
  },
  {
   "start": 172.108,
   "end": 173.688,
   "text": "外面有人拿大锤砸",
   "line": "d08"
  },
  {
   "start": 175.75,
   "end": 180.451,
   "text": "据他回忆，精疲力竭\n又联系不上总参谋部的艇长萨维茨基",
   "line": "d09"
  },
  {
   "start": 180.471,
   "end": 182.90599999999998,
   "text": "命令把核鱼雷装配到战斗状态",
   "line": "d09"
  },
  {
   "start": 182.926,
   "end": 183.384,
   "text": "他喊",
   "line": "d09"
  },
  {
   "start": 187.916,
   "end": 191.549,
   "text": "他在海底挨着打\n连上面开没开战都不知道",
   "line": "d11"
  },
  {
   "start": 197.115,
   "end": 201.026,
   "text": "既然可能已经开战，那就先动手\n宁可同归于尽",
   "line": "d13"
  },
  {
   "start": 201.25,
   "end": 204.31799999999998,
   "text": "可怕的不是他疯了\n是命令本身就是糊的",
   "line": "d14"
  },
  {
   "start": 204.338,
   "end": 209.58499999999998,
   "text": "另一位艇长凯托夫回忆，出发前\n北方舰队参谋长交代：艇体被打穿",
   "line": "d14"
  },
  {
   "start": 209.605,
   "end": 212.309,
   "text": "或者莫斯科下令，就可以用核武器",
   "line": "d14"
  },
  {
   "start": 212.329,
   "end": 213.499,
   "text": "然后加了一句",
   "line": "d14"
  },
  {
   "start": 217.824,
   "end": 220.304,
   "text": "真到了那一步，先开火，别等",
   "line": "d16"
  },
  {
   "start": 220.564,
   "end": 225.047,
   "text": "可另一个来源说，书面命令写的是\n只能凭国防部长的特别命令",
   "line": "d17"
  },
  {
   "start": 225.067,
   "end": 227.548,
   "text": "两种说法都可信，都没有档案证实",
   "line": "d17"
  },
  {
   "start": 227.568,
   "end": 229.983,
   "text": "连什么时候能按按钮，都说不清",
   "line": "d17"
  },
  {
   "start": 234.5,
   "end": 236.702,
   "text": "假设，那枚核鱼雷射了出去",
   "line": "e01"
  },
  {
   "start": 236.722,
   "end": 239.765,
   "text": "它的威力\n大约相当于一颗广岛原子弹",
   "line": "e01"
  },
  {
   "start": 240.025,
   "end": 244.535,
   "text": "离它最近的，是航母伦道夫号\n舰上大约3400人",
   "line": "e02"
  },
  {
   "start": 245.117,
   "end": 248.486,
   "text": "美国海军遇到核攻击\n标准反应是用核深弹还击",
   "line": "e03"
  },
  {
   "start": 248.506,
   "end": 251.53699999999998,
   "text": "研究者认为\n美方很可能把它当成蓄意攻击",
   "line": "e03"
  },
  {
   "start": 251.557,
   "end": 255.874,
   "text": "接下来，可能是一连串谁也没打算\n却停不下来的连锁反应",
   "line": "e03"
  },
  {
   "start": 256.134,
   "end": 256.65000000000003,
   "text": "一枚",
   "line": "e04"
  },
  {
   "start": 256.67,
   "end": 257.723,
   "text": "然后两枚",
   "line": "e04"
  },
  {
   "start": 257.743,
   "end": 260.506,
   "text": "然后，没有人能停下来",
   "line": "e04"
  },
  {
   "start": 266.6,
   "end": 269.87,
   "text": "按奥尔洛夫的说法\n萨维茨基最后压下了火",
   "line": "f01"
  },
  {
   "start": 269.89,
   "end": 272.895,
   "text": "和阿尔希波夫等人商量后，决定上浮",
   "line": "f01"
  },
  {
   "start": 273.155,
   "end": 277.035,
   "text": "另一种说法是：最危险的一刻\n在浮上来以后",
   "line": "f02"
  },
  {
   "start": 277.25,
   "end": 281.731,
   "text": "晚上8点50分\n电池快耗光的B-59浮出水面",
   "line": "f03"
  },
  {
   "start": 281.751,
   "end": 283.545,
   "text": "四周全是美国军舰",
   "line": "f03"
  },
  {
   "start": 283.805,
   "end": 288.058,
   "text": "阿尔希波夫后来描述\n飞机贴着指挥塔掠过，探照灯雪亮",
   "line": "f04"
  },
  {
   "start": 288.078,
   "end": 291.362,
   "text": "机炮打了300多发\n驱逐舰抢到艇首前面",
   "line": "f04"
  },
  {
   "start": 291.622,
   "end": 294.716,
   "text": "在美国人那边，这是照程序打信号拍照",
   "line": "f05"
  },
  {
   "start": 294.736,
   "end": 297.564,
   "text": "在指挥塔上，这看起来像一场进攻",
   "line": "f05"
  },
  {
   "start": 297.783,
   "end": 301.08500000000004,
   "text": "据几位艇长和艇员的回忆\n萨维茨基以为遭到攻击",
   "line": "f06"
  },
  {
   "start": 301.105,
   "end": 305.14,
   "text": "下令紧急下潜，准备一号鱼雷\n也就是装着核弹头的那一枚",
   "line": "f06"
  },
  {
   "start": 305.4,
   "end": 308.21500000000003,
   "text": "可他没能马上下去\n通往舱里的窄梯子",
   "line": "f07"
  },
  {
   "start": 308.235,
   "end": 310.618,
   "text": "被信号军官和他的设备堵住了",
   "line": "f07"
  },
  {
   "start": 310.878,
   "end": 312.57300000000004,
   "text": "阿尔希波夫还站在塔上",
   "line": "f08"
  },
  {
   "start": 312.593,
   "end": 316.86,
   "text": "他看清了：美国人是在打信号、拍照\n炮弹落在旁边的水里",
   "line": "f08"
  },
  {
   "start": 316.88,
   "end": 318.232,
   "text": "他把艇长叫了回来",
   "line": "f08"
  },
  {
   "start": 318.252,
   "end": 320.389,
   "text": "命令没有传到鱼雷军官那里",
   "line": "f08"
  },
  {
   "start": 320.649,
   "end": 324.406,
   "text": "讲这个版本的人\n都没有亲眼看到塔上那几分钟",
   "line": "f09"
  },
  {
   "start": 326.817,
   "end": 330.605,
   "text": "阿尔希波夫是潜艇旅的参谋长\n军衔和艇长一样",
   "line": "f10"
  },
  {
   "start": 330.625,
   "end": 333.081,
   "text": "一年前\n他在K-19核潜艇上",
   "line": "f10"
  },
  {
   "start": 333.101,
   "end": 336.12800000000004,
   "text": "经历过反应堆事故\n看着战友死于辐射",
   "line": "f10"
  },
  {
   "start": 336.148,
   "end": 339.466,
   "text": "他也许比谁都清楚\n核出了事是什么样子",
   "line": "f10"
  },
  {
   "start": 350.583,
   "end": 354.48900000000003,
   "text": "流传最广的版本说\n发射核鱼雷要三个人一致同意",
   "line": "g01"
  },
  {
   "start": 354.509,
   "end": 356.832,
   "text": "只有阿尔希波夫投了反对票",
   "line": "g01"
  },
  {
   "start": 357.092,
   "end": 360.531,
   "text": "研究这段历史最深的\n学者萨夫兰斯卡娅认为",
   "line": "g02"
  },
  {
   "start": 360.551,
   "end": 364.90000000000003,
   "text": "事情没这么整齐：发射需要三把钥匙\n而所有证据都表明",
   "line": "g02"
  },
  {
   "start": 364.92,
   "end": 368.095,
   "text": "那枚核鱼雷并没有\n真正装配到战斗状态",
   "line": "g02"
  },
  {
   "start": 368.317,
   "end": 372.182,
   "text": "2002年\n美国国家安全档案馆的主任对记者说",
   "line": "g03"
  },
  {
   "start": 377.696,
   "end": 378.942,
   "text": "标题总是整齐的",
   "line": "g05"
  },
  {
   "start": 378.962,
   "end": 383.283,
   "text": "真实的历史更吓人：挡住那一夜的\n不是一套好用的规则",
   "line": "g05"
  },
  {
   "start": 383.303,
   "end": 385.915,
   "text": "是一个人在混乱里看清了一件事",
   "line": "g05"
  },
  {
   "start": 386.15,
   "end": 388.55400000000003,
   "text": "同一个晚上\n总统的弟弟罗伯特·",
   "line": "h01"
  },
  {
   "start": 388.574,
   "end": 392.01800000000003,
   "text": "肯尼迪私下约见苏联大使\n美国保证不入侵古巴",
   "line": "h01"
  },
  {
   "start": 392.038,
   "end": 396.34700000000004,
   "text": "部署在土耳其的木星导弹\n也就是能打到苏联的中程核导弹",
   "line": "h01"
  },
  {
   "start": 396.367,
   "end": 399.045,
   "text": "几个月内撤走，但这一条不能公开",
   "line": "h01"
  },
  {
   "start": 399.305,
   "end": 401.77700000000004,
   "text": "第二天，赫鲁晓夫宣布撤走导弹",
   "line": "h02"
  },
  {
   "start": 401.797,
   "end": 405.616,
   "text": "两个领导人一直在给对方留门\n门外的人却不知道",
   "line": "h02"
  },
  {
   "start": 405.85,
   "end": 409.998,
   "text": "美国人也有不知道的\n古巴岛上还有一批苏联战术核武器",
   "line": "h03"
  },
  {
   "start": 410.018,
   "end": 412.95000000000005,
   "text": "其中一枚核巡航导弹\n就摆在离关塔那摩",
   "line": "h03"
  },
  {
   "start": 412.97,
   "end": 415.034,
   "text": "美军基地20多公里的地方",
   "line": "h03"
  },
  {
   "start": 415.054,
   "end": 417.392,
   "text": "美国人直到1992年才知道",
   "line": "h03"
  },
  {
   "start": 417.617,
   "end": 421.36400000000003,
   "text": "第二年\n华盛顿和莫斯科之间拉起了直通热线",
   "line": "h04"
  },
  {
   "start": 421.384,
   "end": 424.835,
   "text": "美英苏三国签署了\n部分禁止核试验条约",
   "line": "h04"
  },
  {
   "start": 425.095,
   "end": 429.85400000000004,
   "text": "两边从这一夜学到的\n不是对方更可怕，而是：最危险的",
   "line": "h05"
  },
  {
   "start": 429.874,
   "end": 431.945,
   "text": "是自己控制不了的末端",
   "line": "h05"
  },
  {
   "start": 432.817,
   "end": 435.377,
   "text": "1997年\n阿尔希波夫唯一一次",
   "line": "i01"
  },
  {
   "start": 435.397,
   "end": 436.66700000000003,
   "text": "公开谈起那一夜",
   "line": "i01"
  },
  {
   "start": 436.687,
   "end": 439.79900000000004,
   "text": "他不高兴\n说那些报道是在抹黑海军将领",
   "line": "i01"
  },
  {
   "start": 439.819,
   "end": 441.374,
   "text": "他只给了一个假设",
   "line": "i01"
  },
  {
   "start": 451.561,
   "end": 456.349,
   "text": "一旦潜入水下，就再没人分得清\n那是信号，还是攻击",
   "line": "i03"
  },
  {
   "start": 456.609,
   "end": 459.649,
   "text": "关于自己做了什么\n他一个字都没提",
   "line": "i04"
  },
  {
   "start": 459.669,
   "end": 461.281,
   "text": "第二年，他去世了",
   "line": "i04"
  },
  {
   "start": 461.301,
   "end": 464.442,
   "text": "又过了四年，他的名字才传遍世界",
   "line": "i04"
  },
  {
   "start": 464.702,
   "end": 468.398,
   "text": "救下那一夜的人\n自己从来没有认领过这份功劳",
   "line": "i05"
  }
 ],
