 "rows": [
  {
   "id": "a01",
   "kind": "N",
   "dur": 1.66,
   "f0": 87.3,
   "rate": 4.21,
   "longest_pause": 0.02,
   "tries": 2,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "这一幕没有发生。"
  },
  {
   "id": "a02",
   "kind": "N",
   "dur": 4.69,
   "f0": 93.2,
   "rate": 5.54,
   "longest_pause": 0.08,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "可是在1962年10月27日的晚上,他离发生只差一个人。"
  },
  {
   "id": "b01",
   "kind": "N",
   "dur": 7.82,
   "f0": 91.8,
   "rate": 4.99,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "1962年10月14日,美国的U-2高空侦察机飞过古巴拍下了这张照片﹐苏联的中程导弹阵地。"
  },
  {
   "id": "b02",
   "kind": "N",
   "dur": 7.26,
   "f0": 95.9,
   "rate": 5.37,
   "longest_pause": 0.06,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "古巴导弹危机由此开始,苏联在古巴秘密部署核导弹,美国发现后封锁古巴,双方对峙了13天。"
  },
  {
   "id": "b03",
   "kind": "N",
   "dur": 2.98,
   "f0": 91.7,
   "rate": 5.36,
   "longest_pause": 0.02,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "从古巴打出去,这种导弹够得着华盛顿。"
  },
  {
   "id": "b04",
   "kind": "N",
   "dur": 8.85,
   "f0": 98.5,
   "rate": 4.97,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "十月二十二日,肯尼迪宣布对古巴隔离,其实就是海上封锁。美国海军在古巴外海划一条线,苏联船到线就拦。"
  },
  {
   "id": "b05",
   "kind": "N",
   "dur": 8.78,
   "f0": 98.1,
   "rate": 3.87,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "两天后,美国战略空军的战备等级升到DEFCON-2。DEFCON是美军的战备等级,数字越小,越接近开战。"
  },
  {
   "id": "b06",
   "kind": "N",
   "dur": 6.26,
   "f0": 98.8,
   "rate": 5.43,
   "longest_pause": 0.22,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "全世界都盯着白宫和克里姆林宫﹔其实这十三天,肯尼迪和赫鲁晓夫一直在找台阶。"
  },
  {
   "id": "b07",
   "kind": "N",
   "dur": 9.0,
   "f0": 92.5,
   "rate": 4.89,
   "longest_pause": 0.18,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "可没人注意到,大西洋底下,四艘苏联潜艇正开往古巴,每一艘都带着一枚核鱼雷,也就是弹头是核弹的鱼雷。"
  },
  {
   "id": "b08",
   "kind": "N",
   "dur": 1.54,
   "f0": 101.3,
   "rate": 5.2,
   "longest_pause": 0.0,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "美国海军并不知道。"
  },
  {
   "id": "c01",
   "kind": "N",
   "dur": 5.49,
   "f0": 96.4,
   "rate": 5.1,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "十月二十七日,后来被称作黑色星期六,这一天三个地方亮起了红灯。"
  },
  {
   "id": "c02",
   "kind": "N",
   "dur": 7.11,
   "f0": 91.9,
   "rate": 4.64,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "古巴上空,一架U-2被萨姆导弹击落,飞行员身亡。萨姆导弹就是苏联的地对空导弹。"
  },
  {
   "id": "c03",
   "kind": "N",
   "dur": 4.2,
   "f0": 99.2,
   "rate": 5.71,
   "longest_pause": 0.2,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "据后来的研究,下令开火的是当地苏军,没有等莫斯科批准。"
  },
  {
   "id": "c04",
   "kind": "N",
   "dur": 9.66,
   "f0": 99.8,
   "rate": 4.76,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "北极上空,另一架U-2迷了航,闯进苏联领空。米格战斗机起飞拦截,美国捷机机赶去接应。机翼下挂的是核空空导弹。"
  },
  {
   "id": "c05",
   "kind": "N",
   "dur": 2.55,
   "f0": 92.0,
   "rate": 4.7,
   "longest_pause": 0.04,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "第三个红点在大西洋的海底﹔"
  },
  {
   "id": "c06",
   "kind": "N",
   "dur": 5.92,
   "f0": 88.0,
   "rate": 5.4,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "三个地方都离华盛顿和莫斯科很远,这一天班基落在了离中心最远的人手里。"
  },
  {
   "id": "d01",
   "kind": "N",
   "dur": 8.78,
   "f0": 88.1,
   "rate": 4.67,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "B59是一艘柴电潜艇,在水面开柴油机给电池充电。潜到水下全靠电池,电池一耗光就必须浮上来。"
  },
  {
   "id": "d02",
   "kind": "N",
   "dur": 11.37,
   "f0": 90.8,
   "rate": 5.37,
   "longest_pause": 0.28,
   "tries": 2,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "它是为北极冷水造的,却泡在温暖的马尾藻海里。据艇上的无线电侦听组长奥尔洛夫回忆,最凉快的舱也有四十五度左右,人像多米诺骨牌一样倒下。"
  },
  {
   "id": "d03",
   "kind": "N",
   "dur": 5.94,
   "f0": 91.5,
   "rate": 6.06,
   "longest_pause": 0.04,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "他们已经两天收不到莫斯科的消息,最后听到的广播让他们以为,战争可能已经打响了。"
  },
  {
   "id": "d04",
   "kind": "N",
   "dur": 1.69,
   "f0": 95.5,
   "rate": 5.32,
   "longest_pause": 0.02,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "这时,美国人来敲门了。"
  },
  {
   "id": "d05",
   "kind": "N",
   "dur": 7.95,
   "f0": 98.4,
   "rate": 5.41,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "美国早就通过外交渠道通知了苏联,每件会投四五颗训练深弹。这种弹只会响,乍不穿船,意思是请扶上来。"
  },
  {
   "id": "d06",
   "kind": "N",
   "dur": 7.14,
   "f0": 90.5,
   "rate": 5.46,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "可是没有证据表明,通知传到了潜艇上,几位艇长都说从没收到过,信号发出去了,收件人没收到。"
  },
  {
   "id": "d07",
   "kind": "N",
   "dur": 11.91,
   "f0": 93.4,
   "rate": 5.79,
   "longest_pause": 0.22,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "10月27日傍晚,驱逐舰比尔号和科尼号先后投下手榴弹。比尔号的职更军官后来回忆,水兵们用卫生纸卷筒把手榴弹包起来,让它沉到深处再炸,正好炸在潜艇旁边。"
  },
  {
   "id": "d08",
   "kind": "N",
   "dur": 7.88,
   "f0": 93.2,
   "rate": 5.08,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "在美国人看来, 这是把门敲得更响。在亭里,奥尔洛夫说, 就像坐在一个汽油桶里,外面有人拿大锤砸。"
  },
  {
   "id": "d09",
   "kind": "N",
   "dur": 7.55,
   "f0": 93.8,
   "rate": 5.16,
   "longest_pause": 0.22,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "据他回忆,精疲力竭,又联系不上总参谋部的庭长萨维茨基,命令把和鱼雷装配到战斗状态,他喊﹔"
  },
  {
   "id": "d10",
   "kind": "Q",
   "dur": 4.05,
   "f0": 92.3,
   "rate": 4.94,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "也许上面战争已经开始了﹔我们还在这里翻跟头﹔"
  },
  {
   "id": "d11",
   "kind": "N",
   "dur": 3.55,
   "f0": 92.2,
   "rate": 5.06,
   "longest_pause": 0.02,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "他在海底挨着打,连上面开没开战都不知道。"
  },
  {
   "id": "d12",
   "kind": "Q",
   "dur": 4.97,
   "f0": 91.1,
   "rate": 5.64,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "我们现在就揍他们,我们会死,但要把他们全部击沉,不能给舰队丢脸。"
  },
  {
   "id": "d13",
   "kind": "N",
   "dur": 3.83,
   "f0": 101.6,
   "rate": 4.96,
   "longest_pause": 0.04,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "既然可能已经开战,那就先动手,宁可同归于尽。"
  },
  {
   "id": "d14",
   "kind": "N",
   "dur": 12.17,
   "f0": 95.6,
   "rate": 5.26,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "可怕的不是他疯了﹔是命令本身就是胡的﹔另一位庭长凯托夫回忆﹔出发前,北方舰队参谋长交代,庭体被打穿,或者莫斯科下令,就可以用核武器。然后加了一句﹔"
  },
  {
   "id": "d15",
   "kind": "Q",
   "dur": 3.84,
   "f0": 98.1,
   "rate": 4.42,
   "longest_pause": 0.24,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "我建议你们先用核武器,然后再想怎么办。"
  },
  {
   "id": "d16",
   "kind": "N",
   "dur": 2.4,
   "f0": 87.2,
   "rate": 4.58,
   "longest_pause": 0.04,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "真到了那一步,先开火,别等。"
  },
  {
   "id": "d17",
   "kind": "N",
   "dur": 9.34,
   "f0": 94.7,
   "rate": 5.68,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "可另一个来源说,书面命令写的是,只能凭国防部长的特别命令。两种说法都可信,都没有档案证实,连什么时候能按按钮都说不清。"
  },
  {
   "id": "e01",
   "kind": "N",
   "dur": 5.18,
   "f0": 94.9,
   "rate": 5.21,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "假设那枚核鱼雷射了出去,它的威力大约相当于一颗广岛原子弹。"
  },
  {
   "id": "e02",
   "kind": "N",
   "dur": 4.43,
   "f0": 88.1,
   "rate": 4.74,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [
    "夫(fu1)~富(fu4)",
    "号(hao4)~豪(hao2)"
   ],
   "asr": "离他最近的,是航母轮到富豪,见上大约三千四百人。"
  },
  {
   "id": "e03",
   "kind": "N",
   "dur": 10.68,
   "f0": 94.3,
   "rate": 5.81,
   "longest_pause": 0.28,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "美国海军遇到核攻击,标准反应是用核伸弹环击。研究者认为,美方很可能把它当成蓄意攻击,接下来可能是一连串谁也没打算,却停不下来的连锁反应。"
  },
  {
   "id": "e04",
   "kind": "N",
   "dur": 4.29,
   "f0": 87.5,
   "rate": 3.49,
   "longest_pause": 0.32,
   "tries": 6,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "一枚,然后两枚,然后没有人能停下来。"
  },
  {
   "id": "e05",
   "kind": "N",
   "dur": 2.68,
   "f0": 92.6,
   "rate": 3.74,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "这些都没有发生,为什么?"
  },
  {
   "id": "f01",
   "kind": "N",
   "dur": 6.22,
   "f0": 89.8,
   "rate": 5.31,
   "longest_pause": 0.16,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "按奥尔洛夫的说法, 萨维茨基最后压下了火,和阿尔西波夫等人商量后, 决定上伏。"
  },
  {
   "id": "f02",
   "kind": "N",
   "dur": 3.8,
   "f0": 88.5,
   "rate": 4.74,
   "longest_pause": 0.24,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "另一种说法是﹔最危险的一刻,在浮上来以后﹔"
  },
  {
   "id": "f03",
   "kind": "N",
   "dur": 6.22,
   "f0": 96.3,
   "rate": 4.5,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "晚上八点五十分,电池快耗光的B59浮出水面,四周全是美国军舰。"
  },
  {
   "id": "f04",
   "kind": "N",
   "dur": 7.48,
   "f0": 90.2,
   "rate": 5.35,
   "longest_pause": 0.18,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [
    "波(bo1)~伯(bo2)"
   ],
   "asr": "阿尔西伯夫后来描述,飞机贴着指挥塔掠过,探照灯雪亮。机炮打了300多发,驱逐舰抢到停手前面。"
  },
  {
   "id": "f05",
   "kind": "N",
   "dur": 5.86,
   "f0": 89.1,
   "rate": 5.12,
   "longest_pause": 0.18,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "在美国人那边,这是照程序打信号拍照,在指挥塔上,这看起来像一场进攻。"
  },
  {
   "id": "f06",
   "kind": "N",
   "dur": 7.28,
   "f0": 93.1,
   "rate": 6.18,
   "longest_pause": 0.02,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
   "asr": "据几位艇长和艇员的回忆,萨维茨基以为遭到攻击,下令紧急下潜,准备一号鱼雷,也就是装着核弹头的那一枚。"
  },
  {
   "id": "f07",
   "kind": "N",
   "dur": 5.14,
   "f0": 90.9,
   "rate": 5.64,
   "longest_pause": 0.3,
   "tries": 1,
   "ser": 0.0,
   "tone_warn": [],
