  {
   "id": "a6",
   "sec": "gap",
   "start": 57.375,
   "end": 67.345,
   "sub": "再看一个厂。新日铁，日本最大的钢铁公司，它的君津制铁所，1971年靠三座高炉，形成年产1000万吨钢的能力。",
   "src": "日本制铁君津地区沿革；千叶县立现代产业科学馆资料",
   "subs": [
    {
     "text": "再看一个厂。新日铁",
     "start": 57.375,
     "end": 58.975
    },
    {
     "text": "日本最大的钢铁公司",
     "start": 58.975,
     "end": 61.059
    },
    {
     "text": "它的君津制铁所",
     "start": 61.059,
     "end": 62.915
    },
    {
     "text": "1971年靠三座高炉",
     "start": 62.915,
     "end": 64.935
    },
    {
     "text": "形成年产1000万吨钢的能力",
     "start": 64.935,
     "end": 67.345
    }
   ]
  },
  {
