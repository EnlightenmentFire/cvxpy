     "s": 7.124,
     "e": 8.99
    }
   ]
  },
  {
   "id": "n002",
   "seg": "s01",
   "kind": "p",
   "text": "深夜鸡叫，古人当作恶声。一个却踢醒另一个，说：",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 9.32,
   "e": 15.009,
   "gap": 0.198,
   "chunks": [
    {
     "t": "深夜鸡叫，古人当作恶声",
     "s": 9.32,
     "e": 12.284
    },
    {
     "t": "一个却踢醒另一个，说",
     "s": 12.284,
     "e": 15.009
    }
   ]
  },
  {
   "id": "n003",
   "seg": "s01",
   "kind": "q",
   "text": "此非恶声也。",
   "src": "《晋书·祖逖传》",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 15.207,
   "e": 17.076,
   "gap": 0.264,
   "chunks": [
    {
     "t": "「此非恶声也。」",
     "s": 15.207,
     "e": 17.076
    }
   ]
  },
  {
   "id": "n004",
   "seg": "s01",
   "kind": "p",
   "text": "这不是坏声音。两人起身而舞，后世叫它闻鸡起舞。",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 17.34,
   "e": 21.868,
   "gap": 0.528,
   "chunks": [
    {
     "t": "这不是坏声音",
     "s": 17.34,
     "e": 18.722
    },
    {
     "t": "两人起身而舞",
     "s": 18.722,
     "e": 20.103
    },
    {
     "t": "后世叫它闻鸡起舞",
     "s": 20.103,
     "e": 21.868
    }
   ]
  },
  {
   "id": "n005",
   "seg": "s01",
   "kind": "p",
   "text": "踢人的叫祖逖，被踢醒的叫刘琨。两人常说：要是天下大乱，就各去中原闯一片天。",
   "src": "",
   "show": "若四海鼎沸，豪杰并起，吾与足下当相避于中原耳。",
   "show_src": "《晋书·祖逖传》",
   "slow": false,
   "s": 22.396,
   "e": 29.187,
   "gap": 0.594,
   "chunks": [
    {
     "t": "踢人的叫祖逖，被踢醒的叫刘琨",
