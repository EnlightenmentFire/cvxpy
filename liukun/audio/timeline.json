     "s": 482.994,
     "e": 484.407
    }
   ]
  },
  {
   "id": "n076",
   "seg": "s12",
   "kind": "p",
   "text": "三年后，祖逖已收复黄河以南，朝廷却派人来统管他，内乱将起。他忧愤成疾，死在北伐前线。",
   "src": "",
   "show": "虑有内难，大功不遂。感激发病。",
   "show_src": "《晋书·祖逖传》",
   "slow": false,
   "s": 486.123,
   "e": 494.993,
   "gap": 1.188,
   "chunks": [
    {
     "t": "三年后，祖逖已收复黄河以南",
     "s": 486.123,
