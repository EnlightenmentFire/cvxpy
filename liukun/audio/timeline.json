     "s": 67.259,
     "e": 69.923
    }
   ]
  },
  {
   "id": "n012",
   "seg": "s03",
   "kind": "p",
   "text": "他向朝廷要粮，朝廷答应了。送到没有，史书没写。",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 70.319,
   "e": 74.452,
   "gap": 0.594,
   "chunks": [
    {
     "t": "他向朝廷要粮，朝廷答应了",
     "s": 70.319,
     "e": 72.646
    },
    {
