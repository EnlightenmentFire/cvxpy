     "s": 60.35,
     "e": 62.498
    }
   ]
  },
  {
   "id": "n010",
   "seg": "s03",
   "kind": "q",
   "text": "白骨横野……动足遇掠，开目睹寇。",
   "src": "《晋书·刘琨传》·在路上表",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 62.696,
   "e": 66.028,
   "gap": 0.33,
   "chunks": [
    {
     "t": "「白骨横野……动足遇掠，开目睹寇。」",
     "s": 62.696,
     "e": 66.028
    }
   ]
  },
  {
   "id": "n011",
   "seg": "s03",
   "kind": "p",
   "text": "遍地白骨。四面山上全是敌兵，睁眼就见敌。",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 66.358,
   "e": 69.923,
   "gap": 0.396,
   "chunks": [
