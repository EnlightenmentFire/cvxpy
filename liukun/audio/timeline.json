     "e": 51.84
    }
   ]
  },
  {
   "id": "n008",
   "seg": "s03",
   "kind": "p",
   "text": "公元三零七年，他出任并州刺史。并州是今天山西大部，州城晋阳，就是太原。",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 52.764,
   "e": 60.02,
   "gap": 0.33,
   "chunks": [
    {
     "t": "公元三零七年，他出任并州刺史",
     "s": 52.764,
     "e": 55.867
    },
    {
