     "s": 498.57,
     "e": 500.628
    }
   ]
  },
  {
   "id": "n078",
   "seg": "s12",
   "kind": "p",
   "text": "一个死于猜忌，一个死于忧愤。",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 501.354,
   "e": 503.943,
   "gap": 1.056,
   "chunks": [
