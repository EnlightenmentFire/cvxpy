     "t": "最后两句是",
     "s": 469.604,
     "e": 470.766
    }
   ]
  },
  {
   "id": "n073",
   "seg": "s12",
   "kind": "q",
   "text": "何意百炼刚，化为绕指柔。",
   "src": "《晋书·刘琨传》·赠卢谌诗",
   "show": "",
   "show_src": "",
   "slow": true,
   "s": 471.162,
   "e": 473.826,
   "gap": 0.726,
   "chunks": [
    {
     "t": "「何意百炼刚，化为绕指柔。」",
     "s": 471.162,
     "e": 473.826
    }
   ]
  },
  {
   "id": "n074",
   "seg": "s12",
   "kind": "p",
   "text": "千锤百炼的钢，怎么就成了能绕在手指上的软东西？",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 474.552,
   "e": 479.718,
   "gap": 0.66,
   "chunks": [
    {
     "t": "千锤百炼的钢",
     "s": 474.552,
     "e": 476.142
    },
    {
     "t": "怎么就成了能绕",
     "s": 476.142,
     "e": 477.687
    },
    {
     "t": "在手指上的软东西？",
     "s": 477.687,
     "e": 479.718
    }
   ]
  },
  {
   "id": "n075",
   "seg": "s12",
   "kind": "p",
   "text": "不是他软了。是能让他硬下去的东西，一样一样，都没了。",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 480.378,
   "e": 484.407,
   "gap": 1.716,
