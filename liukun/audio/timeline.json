     "e": 111.247
    }
   ]
  },
  {
   "id": "n018",
   "seg": "s04",
   "kind": "p",
   "text": "夜深了，他吹起胡笳，那是北方草原的一种管乐。围城的兵流下泪来，想家了。",
   "src": "",
   "show": "中夜奏胡笳，贼又流涕歔欷，有怀土之切。",
   "show_src": "《晋书·刘琨传》",
   "slow": false,
   "s": 111.577,
   "e": 118.403,
   "gap": 3.825,
   "chunks": [
