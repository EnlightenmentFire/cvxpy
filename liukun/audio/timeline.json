     "s": 72.646,
     "e": 74.452
    }
   ]
  },
  {
   "id": "n013",
   "seg": "s03",
   "kind": "p",
   "text": "晋阳城里，荆棘成林。他带着千余人埋尸骨，立官署；百姓背着盾牌种地，挂着箭袋锄草。不到一年，",
   "src": "",
   "show": "百姓负楯以耕，属鞬而耨。",
   "show_src": "《晋书·刘琨传》",
   "slow": false,
