  },
  {
   "id": "n025",
   "seg": "s05",
   "kind": "q",
   "text": "专欲除胜己以自安……如是，祸必及我。",
   "src": "《晋书·刘琨传》",
   "show": "",
   "show_src": "",
   "slow": false,
