    },
    {
     "t": "他忧愤成疾，死在北伐前线",
     "s": 492.242,
     "e": 494.993
    }
   ]
  },
  {
   "id": "n077",
   "seg": "s12",
   "kind": "p",
   "text": "当年两个年轻人说，天下大乱，我们各去中原，闯一片天。",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 496.181,
   "e": 500.628,
   "gap": 0.726,
   "chunks": [
    {
     "t": "当年两个年轻人说，天下大乱",
     "s": 496.181,
     "e": 498.57
    },
    {
