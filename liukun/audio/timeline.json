     "e": 60.02
    }
   ]
  },
  {
   "id": "n009",
   "seg": "s03",
   "kind": "p",
   "text": "赴任路上，他上表朝廷：",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 60.35,
   "e": 62.498,
   "gap": 0.198,
   "chunks": [
    {
