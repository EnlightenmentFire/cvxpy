  },
  {
   "id": "n021",
   "seg": "s05",
   "kind": "p",
   "text": "但他的短处，史书没替他瞒。",
   "src": "",
   "show": "",
   "show_src": "",
   "slow": false,
   "s": 132.057,
   "e": 133.787,
   "gap": 0.264,
   "chunks": [
