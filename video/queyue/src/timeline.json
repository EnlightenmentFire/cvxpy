     "start": 163.54912500000003,
     "end": 166.32329166666668
    }
   ]
  },
  {
   "i": 33,
   "sec": "s4",
   "k": 7,
   "kind": "q",
   "text": "乃断矟长三四尺，以锤锤之，一矟辄洞贯三四虏。",
   "src": "《宋书·朱超石传》",
   "start": 166.663,
   "end": 171.474,
   "chunks": [
    {
     "text": "乃断矟长三四尺，以锤锤之，一矟辄洞贯三四虏。",
     "start": 166.66329166666668,
     "end": 171.47362500000003
    }
   ]
  },
  {
   "i": 34,
   "sec": "s4",
   "k": 8,
   "kind": "n",
   "text": "把长槊截成三四尺的短段，用大锤砸出去。一杆，洞穿三四个人。",
   "src": "",
   "start": 171.774,
   "end": 176.707,
   "chunks": [
    {
     "text": "把长槊截成三四尺的短段，用大锤砸出去。",
     "start": 171.77362500000004,
     "end": 175.04362500000005
    },
    {
     "text": "一杆，洞穿三四个人。",
     "start": 175.04362500000005,
     "end": 176.70733333333337
    }
   ]
  },
  {
   "i": 35,
   "sec": "s4",
   "k": 9,
   "kind": "q",
   "text": "虏众不能当，一时奔溃。",
   "src": "《宋书·朱超石传》",
   "start": 177.047,
   "end": 179.633,
   "chunks": [
    {
     "text": "虏众不能当，一时奔溃。",
     "start": 177.04733333333337,
     "end": 179.6327916666667
    }
   ]
  },
  {
   "i": 36,
   "sec": "s4",
   "k": 10,
   "kind": "n",
   "text": "晋军阵斩魏将阿薄干。朱超石追出去，却又被围住，苦战一整天，魏军才退。",
   "src": "",
   "start": 179.933,
   "end": 185.867,
   "chunks": [
    {
     "text": "晋军阵斩魏将阿薄干。",
     "start": 179.9327916666667,
     "end": 181.7327916666667
    },
    {
     "text": "朱超石追出去，却又被围住，苦战一整天，",
     "start": 181.7327916666667,
     "end": 184.8527916666667
    },
    {
     "text": "魏军才退。",
     "start": 184.8527916666667,
     "end": 185.86683333333337
    }
   ]
  },
  {
   "i": 37,
   "sec": "s5",
   "k": 0,
   "kind": "n",
   "text": "为什么能赢？把这个阵拆开看。",
   "src": "",
   "start": 188.387,
   "end": 191.109,
   "chunks": [
    {
     "text": "为什么能赢？把这个阵拆开看。",
     "start": 188.38683333333339,
     "end": 191.10887500000004
    }
   ]
  },
  {
   "i": 38,
   "sec": "s5",
   "k": 1,
   "kind": "n",
   "text": "第一，河。背后是自己的舰队，援兵和弩槊都从船上来；骑兵，绕不到背后。",
   "src": "",
   "start": 191.329,
   "end": 197.041,
   "chunks": [
    {
     "text": "第一，河。背后是自己的舰队，",
     "start": 191.32887500000004,
     "end": 193.45887500000003
    },
    {
     "text": "援兵和弩槊都从船上来；",
     "start": 193.45887500000003,
     "end": 195.38887500000004
    },
    {
     "text": "骑兵，绕不到背后。",
     "start": 195.38887500000004,
     "end": 197.04070833333338
    }
   ]
  },
  {
   "i": 39,
   "sec": "s5",
   "k": 2,
   "kind": "n",
   "text": "第二，车。车和盾连成一道墙，骑兵冲不动，停在墙外，就成了挤在一起的靶子。",
   "src": "",
   "start": 197.261,
   "end": 202.977,
   "chunks": [
    {
     "text": "第二，车。",
     "start": 197.26070833333338,
     "end": 197.95070833333338
    },
    {
     "text": "车和盾连成一道墙，骑兵冲不动，停在墙外，",
     "start": 197.95070833333338,
     "end": 201.4707083333334
    },
    {
     "text": "就成了挤在一起的靶子。",
     "start": 201.4707083333334,
     "end": 202.97720833333338
    }
   ]
  },
  {
   "i": 40,
   "sec": "s5",
   "k": 3,
   "kind": "n",
   "text": "第三，弩和槊，专打停下来的密集目标。",
   "src": "",
   "start": 203.197,
   "end": 206.423,
   "chunks": [
    {
     "text": "第三，弩和槊，专打停下来的密集目标。",
     "start": 203.19720833333338,
     "end": 206.42337500000005
    }
   ]
  },
  {
   "i": 41,
   "sec": "s5",
   "k": 4,
   "kind": "n",
   "text": "第四，纪律。七百人在敌骑眼前登岸布阵，两千人只等一个信号。乱一步，阵就散了。",
   "src": "",
   "start": 206.643,
   "end": 212.883,
   "chunks": [
    {
     "text": "第四，纪律。",
     "start": 206.64337500000005,
     "end": 207.55337500000005
    },
    {
     "text": "七百人在敌骑眼前登岸布阵，",
     "start": 207.55337500000005,
     "end": 209.69337500000006
    },
    {
     "text": "两千人只等一个信号。",
     "start": 209.69337500000006,
     "end": 211.39337500000005
    },
    {
     "text": "乱一步，阵就散了。",
     "start": 211.39337500000005,
     "end": 212.88312500000004
    }
   ]
  },
  {
   "i": 42,
   "sec": "s5",
   "k": 5,
   "kind": "n",
   "text": "河、车、弩、纪律，少一样都不成。",
   "src": "",
   "start": 213.103,
   "end": 215.712,
   "chunks": [
    {
     "text": "河、车、弩、纪律，少一样都不成。",
     "start": 213.10312500000003,
     "end": 215.71200000000005
    }
   ]
  },
  {
   "i": 43,
   "sec": "s5",
   "k": 6,
   "kind": "n",
   "text": "三十三年后，宋将刘康祖率八千人，在寿阳附近被八万魏骑追上。他同样结起车营，死战一天。",
   "src": "",
   "start": 215.932,
   "end": 222.969,
   "chunks": [
    {
     "text": "三十三年后，宋将刘康祖率八千人，",
     "start": 215.93200000000004,
     "end": 218.53200000000004
    },
    {
     "text": "在寿阳附近被八万魏骑追上。",
     "start": 218.53200000000004,
     "end": 220.66200000000003
    },
    {
     "text": "他同样结起车营，死战一天。",
     "start": 220.66200000000003,
     "end": 222.96916666666672
    }
   ]
  },
  {
   "i": 44,
   "sec": "s5",
   "k": 7,
   "kind": "q",
   "text": "虏分众为三，且休且战，以骑负草烧车营。",
   "src": "《宋书·刘康祖传》",
   "start": 223.309,
   "end": 227.44,
   "chunks": [
    {
     "text": "虏分众为三，且休且战，以骑负草烧车营。",
     "start": 223.30916666666673,
     "end": 227.43987500000006
    }
   ]
  },
  {
   "i": 45,
   "sec": "s5",
   "k": 8,
   "kind": "n",
   "text": "魏军分三班轮流进攻，再驮草来烧车。刘康祖中箭阵亡，全军覆没。",
   "src": "",
   "start": 227.74,
   "end": 232.949,
   "chunks": [
    {
     "text": "魏军分三班轮流进攻，再驮草来烧车。",
     "start": 227.73987500000007,
     "end": 230.68987500000006
    },
    {
     "text": "刘康祖中箭阵亡，全军覆没。",
     "start": 230.68987500000006,
     "end": 232.94866666666672
    }
   ]
  },
  {
   "i": 46,
   "sec": "s5",
   "k": 9,
   "kind": "n",
   "text": "没有河，车阵只是一座四面受敌的孤岛。",
   "src": "",
   "start": 233.169,
   "end": 236.314,
   "chunks": [
    {
     "text": "没有河，车阵只是一座四面受敌的孤岛。",
     "start": 233.16866666666672,
     "end": 236.3140833333334
    }
   ]
  },
  {
   "i": 47,
   "sec": "s6",
   "k": 0,
   "kind": "n",
   "text": "败报传到平城，拓跋嗣",
   "src": "",
   "start": 238.834,
   "end": 241.084,
   "chunks": [
    {
     "text": "败报传到平城，拓跋嗣",
     "start": 238.8340833333334,
     "end": 241.08412500000009
    }
   ]
  },
  {
   "i": 48,
   "sec": "s6",
   "k": 1,
   "kind": "q",
   "text": "恨不用浩计。",
   "src": "《魏书·崔浩传》",
   "start": 241.264,
   "end": 242.81,
   "chunks": [
    {
     "text": "恨不用浩计。",
     "start": 241.2641250000001,
     "end": 242.80954166666675
    }
   ]
  },
  {
   "i": 49,
   "sec": "s6",
   "k": 2,
   "kind": "n",
   "text": "北魏下诏借道。刘裕在船上望见长孙嵩的旗盖，还派人送去了酒和江南的食物。",
   "src": "",
   "start": 243.11,
   "end": 249.032,
   "chunks": [
    {
     "text": "北魏下诏借道。",
     "start": 243.10954166666676,
     "end": 244.26954166666675
    },
    {
     "text": "刘裕在船上望见长孙嵩的旗盖，",
     "start": 244.26954166666675,
     "end": 246.62954166666677
    },
    {
     "text": "还派人送去了酒和江南的食物。",
     "start": 246.62954166666677,
     "end": 249.03154166666675
    }
   ]
  },
  {
   "i": 50,
   "sec": "s6",
   "k": 3,
   "kind": "n",
   "text": "舰队继续西进。八月，王镇恶率水军由黄河入渭水，直抵长安城北，弃船登岸，一战破城。后秦亡。",
   "src": "",
   "start": 249.252,
   "end": 256.655,
   "chunks": [
    {
     "text": "舰队继续西进。",
     "start": 249.25154166666675,
     "end": 250.40154166666676
    },
    {
     "text": "八月，王镇恶率水军由黄河入渭水，",
     "start": 250.40154166666676,
     "end": 253.19154166666675
    },
    {
     "text": "直抵长安城北，弃船登岸，一战破城。",
     "start": 253.19154166666675,
     "end": 255.88154166666675
    },
    {
     "text": "后秦亡。",
     "start": 255.88154166666675,
     "end": 256.65462500000007
    }
   ]
  },
  {
   "i": 51,
   "sec": "s7",
   "k": 0,
   "kind": "n",
   "text": "九月，刘裕进长安。《宋书》说，他本想留下，经略赵、魏。",
   "src": "",
   "start": 259.175,
   "end": 263.281,
   "chunks": [
    {
     "text": "九月，刘裕进长安。",
     "start": 259.1746250000001,
     "end": 260.7146250000001
    },
    {
     "text": "《宋书》说，他本想留下，经略赵、魏。",
     "start": 260.7146250000001,
     "end": 263.28091666666677
    }
   ]
  },
  {
   "i": 52,
   "sec": "s7",
   "k": 1,
   "kind": "n",
   "text": "十一月，建康传来消息：替他总管后方的刘穆之，死了。",
   "src": "",
   "start": 263.501,
   "end": 267.595,
   "chunks": [
    {
     "text": "十一月，建康传来消息：",
     "start": 263.5009166666668,
     "end": 265.1809166666668
    },
    {
     "text": "替他总管后方的刘穆之，死了。",
     "start": 265.1809166666668,
     "end": 267.5951250000001
    }
   ]
  },
  {
   "i": 53,
   "sec": "s7",
   "k": 2,
   "kind": "n",
   "text": "北伐途中，刘裕曾派人回建康，暗示朝廷该给他九锡。这本是刘穆之该替主公办的事。",
   "src": "",
   "start": 267.815,
   "end": 274.295,
   "chunks": [
    {
     "text": "北伐途中，刘裕曾派人回建康，",
     "start": 267.81512500000014,
     "end": 270.17512500000015
    },
    {
     "text": "暗示朝廷该给他九锡。",
     "start": 270.17512500000015,
     "end": 272.00512500000013
    },
    {
     "text": "这本是刘穆之该替主公办的事。",
     "start": 272.00512500000013,
     "end": 274.2946250000001
    }
   ]
  },
  {
   "i": 54,
   "sec": "s7",
   "k": 3,
   "kind": "q",
   "text": "旨反从北来，穆之愧惧，发病遂卒。",
   "src": "《宋书·王弘传》",
   "start": 274.635,
   "end": 278.249,
   "chunks": [
    {
     "text": "旨反从北来，穆之愧惧，发病遂卒。",
     "start": 274.63462500000014,
     "end": 278.24925000000013
    }
   ]
  },
  {
   "i": 55,
   "sec": "s7",
   "k": 4,
   "kind": "n",
   "text": "后方无人可托。十二月，刘裕东归，把长安留给十二岁的儿子刘义真，和一群互相猜忌的将领。",
   "src": "",
   "start": 278.549,
   "end": 285.27,
   "chunks": [
    {
     "text": "后方无人可托。十二月，刘裕东归，",
     "start": 278.54925000000014,
     "end": 281.20925000000017
    },
    {
     "text": "把长安留给十二岁的儿子刘义真，",
     "start": 281.20925000000017,
     "end": 283.46925000000016
    },
    {
     "text": "和一群互相猜忌的将领。",
     "start": 283.46925000000016,
     "end": 285.27025000000015
    }
   ]
  },
  {
   "i": 56,
   "sec": "s7",
   "k": 5,
   "kind": "n",
   "text": "崩溃来得很快。沈田子杀王镇恶，王修杀沈田子，刘义真又杀了王修。",
   "src": "",
   "start": 285.49,
   "end": 290.958,
   "chunks": [
    {
     "text": "崩溃来得很快。",
     "start": 285.4902500000002,
     "end": 286.63025000000016
    },
    {
     "text": "沈田子杀王镇恶，王修杀沈田子，",
     "start": 286.63025000000016,
     "end": 289.33025000000015
    },
    {
     "text": "刘义真又杀了王修。",
     "start": 289.33025000000015,
     "end": 290.9577083333335
    }
   ]
  },
  {
   "i": 57,
   "sec": "s7",
   "k": 6,
   "kind": "n",
   "text": "夏国谋士王买德，看得很透：",
   "src": "",
   "start": 291.178,
   "end": 293.705,
   "chunks": [
    {
     "text": "夏国谋士王买德，看得很透：",
     "start": 291.17770833333356,
     "end": 293.70533333333356
    }
   ]
  },
  {
   "i": 58,
   "sec": "s7",
   "k": 7,
   "kind": "q",
   "text": "关中形胜之地，而裕以幼子守之。狼狈而归，正欲急成篡事耳。",
   "src": "《资治通鉴》卷一百一十八",
   "start": 293.885,
   "end": 299.647,
   "chunks": [
    {
     "text": "关中形胜之地，而裕以幼子守之。狼狈而归，正欲急成篡事耳。",
     "start": 293.88533333333356,
     "end": 299.6474166666669
    }
   ]
  },
  {
   "i": 59,
   "sec": "s7",
   "k": 8,
   "kind": "n",
   "text": "这么要紧的地方交给一个孩子，自己匆匆回去，是急着篡位。",
   "src": "",
   "start": 299.947,
   "end": 304.479,
   "chunks": [
    {
     "text": "这么要紧的地方交给一个孩子，",
     "start": 299.9474166666669,
     "end": 302.06741666666693
    },
    {
     "text": "自己匆匆回去，是急着篡位。",
     "start": 302.06741666666693,
     "end": 304.4793333333336
    }
   ]
  },
  {
   "i": 60,
   "sec": "s7",
   "k": 9,
   "kind": "n",
   "text": "义熙十四年十一月，晋军弃城东撤，在青泥被夏军追上，大败。长安易手，离刘裕东归，不到一年。",
   "src": "",
   "start": 304.699,
   "end": 311.779,
   "chunks": [
    {
     "text": "义熙十四年十一月，晋军弃城东撤，",
     "start": 304.69933333333364,
     "end": 307.3493333333336
    },
    {
     "text": "在青泥被夏军追上，大败。",
     "start": 307.3493333333336,
     "end": 309.2893333333336
    },
    {
     "text": "长安易手，离刘裕东归，不到一年。",
     "start": 309.2893333333336,
     "end": 311.77920833333366
    }
   ]
  },
  {
   "i": 61,
   "sec": "s7",
   "k": 10,
   "kind": "n",
   "text": "死在这场崩溃里的，有却月阵的指挥者朱超石，时年三十七。",
   "src": "",
   "start": 311.999,
   "end": 316.765,
   "chunks": [
    {
     "text": "死在这场崩溃里的，",
     "start": 311.9992083333337,
     "end": 313.39920833333366
    },
    {
     "text": "有却月阵的指挥者朱超石，时年三十七。",
     "start": 313.39920833333366,
     "end": 316.76537500000035
    }
   ]
  },
  {
   "i": 62,
   "sec": "s8",
   "k": 0,
   "kind": "n",
   "text": "刘裕登城北望，",
   "src": "",
   "start": 318.185,
   "end": 319.916,
   "chunks": [
    {
     "text": "刘裕登城北望，",
     "start": 318.18537500000036,
     "end": 319.9159583333337
    }
   ]
  },
  {
   "i": 63,
   "sec": "s8",
   "k": 1,
   "kind": "q",
   "text": "慨然流涕而已。",
   "src": "《资治通鉴》卷一百一十八",
   "start": 320.096,
   "end": 321.875,
   "chunks": [
    {
     "text": "慨然流涕而已。",
     "start": 320.0959583333337,
     "end": 321.8745000000004
    }
   ]
  },
  {
   "i": 64,
   "sec": "s8",
   "k": 2,
   "kind": "n",
   "text": "他没有再回关中。这一年六月，他已受宋公、九锡；两年后，代晋称帝。",
   "src": "",
   "start": 322.175,
   "end": 328.377,
   "chunks": [
    {
     "text": "他没有再回关中。",
     "start": 322.1745000000004,
     "end": 323.6745000000004
    },
    {
     "text": "这一年六月，他已受宋公、九锡；",
     "start": 323.6745000000004,
     "end": 326.58450000000045
    },
    {
