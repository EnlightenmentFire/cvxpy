[
 {
  "i": 1,
  "text": "一行提示，只要它展现对历史、政治、文明的理解。",
  "start": 0.0,
  "end": 3.519,
  "file": "line_0001.wav"
 },
 {
  "i": 2,
  "text": "大胆一点，宏伟一点。",
  "start": 3.919,
  "end": 5.344,
  "file": "line_0002.wav"
 },
 {
  "i": 3,
  "text": "一台模型，凭什么谈这些事？",
  "start": 5.744,
  "end": 7.781,
  "file": "line_0003.wav"
 },
 {
  "i": 4,
  "text": "它没有先报王朝年表，也没有先画一张世界地图。",
  "start": 8.181,
  "end": 11.865,
  "file": "line_0004.wav"
 },
 {
  "i": 5,
  "text": "时间轴上，汉谟拉比法典先亮了起来。",
  "start": 12.265,
  "end": 15.043,
  "file": "line_0005.wav"
 },
 {
  "i": 6,
  "text": "大约三千多年前，报复被写成公开的条文。",
  "start": 15.443,
  "end": 18.592,
  "file": "line_0006.wav"
 },
 {
  "i": 7,
  "text": "法首先是把强者的规矩，刻在石头上。",
  "start": 18.992,
  "end": 21.796,
  "file": "line_0007.wav"
 },
 {
  "i": 8,
  "text": "可后面那些节点，开始往另一个方向走。",
  "start": 22.196,
  "end": 25.156,
  "file": "line_0008.wav"
 },
 {
  "i": 9,
  "text": "有些时刻，法开始掉过头来。",
  "start": 25.556,
  "end": 27.632,
  "file": "line_0009.wav"
 },
 {
  "i": 10,
  "text": "那最伟大的时刻，到底发生在哪一天？",
  "start": 28.032,
  "end": 30.81,
  "file": "line_0010.wav"
 },
 {
  "i": 11,
  "text": "是大宪章，还是更早？",
  "start": 31.21,
  "end": 32.69,
  "file": "line_0011.wav"
 },
 {
  "i": 12,
  "text": "模型没有从某一朝的英雄讲起，它画出的是一条线。",
  "start": 33.09,
  "end": 36.979,
  "file": "line_0012.wav"
 },
 {
  "i": 13,
  "text": "请注意，这不是某部法典里的原句，是模型对法律史的一种读法。",
  "start": 37.379,
  "end": 42.179,
  "file": "line_0013.wav"
 },
 {
  "i": 14,
  "text": "而法律，只是它回答文明是什么时，选中的那条例子。",
  "start": 42.579,
  "end": 46.468,
  "file": "line_0014.wav"
 },
 {
  "i": 15,
  "text": "同一行提示里，它要处理的是三件事：历史怎样被讲述，政治怎样约束力量，文明究竟把什么传下去。",
  "start": 46.868,
  "end": 54.256,
  "file": "line_0015.wav"
 },
 {
  "i": 16,
  "text": "所以这条时间轴，不该被看成一堂法律常识课。",
  "start": 54.656,
  "end": 58.175,
  "file": "line_0016.wav"
 },
 {
  "i": 17,
  "text": "它更像一把尺子，用来量：规则到底在保护谁，又在限制谁。",
  "start": 58.575,
  "end": 62.835,
  "file": "line_0017.wav"
 },
 {
  "i": 18,
  "text": "先把六个节点按顺序摆出来。",
  "start": 63.235,
  "end": 65.375,
  "file": "line_0018.wav"
 },
 {
  "i": 19,
  "text": "汉谟拉比法典，梭伦改革，大宪章，权利法案，人权宣言，世界人权宣言。",
  "start": 65.775,
  "end": 71.495,
  "file": "line_0019.wav"
 },
 {
  "i": 20,
  "text": "这是一条西方文献很重的选线，不是人类法律史的全部。",
  "start": 71.895,
  "end": 76.155,
  "file": "line_0020.wav"
 },
 {
  "i": 21,
  "text": "把它当成全人类的唯一道路，就会把其他文明的制度传统，从画面上抹掉。",
  "start": 76.555,
  "end": 82.111,
  "file": "line_0021.wav"
 },
 {
  "i": 22,
  "text": "中国以及其他文明的制度传统，并不在这六个名字里。",
  "start": 82.511,
  "end": 86.571,
  "file": "line_0022.wav"
 },
 {
  "i": 23,
  "text": "模型做的，是压缩已有的叙述，不是新的考古发现。",
  "start": 86.971,
  "end": 90.675,
  "file": "line_0023.wav"
 },
 {
  "i": 24,
  "text": "可它压缩完以后，留下的不是一串名词，是一个结构。",
  "start": 91.075,
  "end": 94.964,
  "file": "line_0024.wav"
 },
 {
  "i": 25,
  "text": "结构是这样的。",
  "start": 95.364,
  "end": 96.464,
  "file": "line_0025.wav"
 },
 {
  "i": 26,
  "text": "法一开始，常常是强者把报复、债务和秩序，写成可以示众的规矩。",
  "start": 96.864,
  "end": 101.659,
  "file": "line_0026.wav"
 },
 {
  "i": 27,
  "text": "规矩一旦公开，就可能被引用，被争论，也被后来的人拿去约束制定规矩的人。",
  "start": 102.059,
  "end": 107.779,
  "file": "line_0027.wav"
 },
 {
  "i": 28,
  "text": "约束不会自动发生。",
  "start": 108.179,
  "end": 109.661,
  "file": "line_0028.wav"
 },
 {
  "i": 29,
  "text": "要让法绑住强者，至少得有公开的文本，有人能站出来说出它，并且违约之后要付出代价。",
  "start": 110.061,
  "end": 116.721,
  "file": "line_0029.wav"
 },
 {
  "i": 30,
  "text": "缺了这三样里的任何一样，漂亮的句子都可能只是刻在墙上的装饰。",
  "start": 117.121,
  "end": 122.301,
  "file": "line_0030.wav"
 },
 {
  "i": 31,
  "text": "文本出现了，不等于强者从此就被绑住。",
  "start": 122.701,
  "end": 125.664,
  "file": "line_0031.wav"
 },
 {
  "i": 32,
  "text": "否则，历史就会被画成一条平滑上升的进步曲线，而那不是事实。",
  "start": 126.064,
  "end": 130.859,
  "file": "line_0032.wav"
 },
 {
  "i": 33,
  "text": "回到起点。汉谟拉比的石碑，通常被放在公元前十八世纪前后。",
  "start": 131.259,
  "end": 135.889,
  "file": "line_0033.wav"
 },
 {
  "i": 34,
  "text": "具体哪一年，不同年表会差一些，这里不装得更精确。",
  "start": 136.289,
  "end": 140.179,
  "file": "line_0034.wav"
 },
 {
  "i": 35,
  "text": "人们后来常说以眼还眼，那只是同态复仇的通俗说法，不是整部法典的全部。",
  "start": 140.579,
  "end": 146.319,
  "file": "line_0035.wav"
 },
 {
  "i": 36,
  "text": "但它把伤害如何被报复，从私下的怒火，写成了公开的条文。",
  "start": 146.719,
  "end": 151.159,
  "file": "line_0036.wav"
 },
 {
  "i": 37,
  "text": "条款可以很细，细到不同身份、不同伤害，对应不同的补偿或惩罚。",
  "start": 151.559,
  "end": 156.374,
  "file": "line_0037.wav"
 },
 {
  "i": 38,
  "text": "强者仍可能是规则的作者。",
  "start": 156.774,
  "end": 158.812,
  "file": "line_0038.wav"
 },
 {
  "i": 39,
  "text": "可石头立在那里，规则就开始离开某一个人的心情。",
  "start": 159.212,
  "end": 162.932,
  "file": "line_0039.wav"
 },
 {
  "i": 40,
  "text": "石碑还立着的时候，后来的人至少有一块可以指认的公共尺度。",
  "start": 163.332,
  "end": 168.147,
  "file": "line_0040.wav"
 },
 {
  "i": 41,
  "text": "再看希腊的城邦。",
  "start": 168.547,
  "end": 169.844,
  "file": "line_0041.wav"
 },
 {
  "i": 42,
  "text": "梭伦改革，传统上放在公元前六世纪初期的雅典。",
  "start": 170.244,
  "end": 173.924,
  "file": "line_0042.wav"
 },
 {
  "i": 43,
  "text": "那时的麻烦，不只是仇杀，还有债务把人压成依附。",
  "start": 174.324,
  "end": 178.024,
  "file": "line_0043.wav"
 },
 {
  "i": 44,
  "text": "改革要重新安排权责：谁欠了什么，谁还保有身份，谁能参与城邦的公共生活。",
  "start": 178.424,
  "end": 184.164,
  "file": "line_0044.wav"
 },
 {
  "i": 45,
  "text": "债务不只是钱的问题，它会改变一个人还是不是自由的城邦成员。",
  "start": 184.564,
  "end": 189.544,
  "file": "line_0045.wav"
 },
 {
  "i": 46,
  "text": "这仍然是政治。",
  "start": 189.944,
  "end": 191.056,
  "file": "line_0046.wav"
 },
 {
  "i": 47,
  "text": "它问的是，一群人怎样住在同一座城里，而不让力量最大的那一方把其余的人吞掉。",
  "start": 191.456,
  "end": 197.736,
  "file": "line_0047.wav"
 },
 {
  "i": 48,
  "text": "城邦里的争论，后来被概括成一个更普遍的问题：人应当怎样一起活。",
  "start": 198.136,
  "end": 203.322,
  "file": "line_0048.wav"
 },
 {
  "i": 49,
  "text": "模型把它当作轴心时代的那一问，放进它对文明的理解里。",
  "start": 203.722,
  "end": 208.102,
  "file": "line_0049.wav"
 },
 {
  "i": 50,
  "text": "请记住，这也是一种读法，不是对所有古代思想的穷尽。",
  "start": 208.502,
  "end": 212.577,
  "file": "line_0050.wav"
 },
 {
  "i": 51,
  "text": "到了一二一五年，英格兰的大宪章被写下。",
  "start": 212.977,
  "end": 216.126,
  "file": "line_0051.wav"
 },
 {
  "i": 52,
  "text": "它不是今天意义上的宪法，更不是一纸文书就永久绑住了王权。",
  "start": 216.526,
  "end": 221.341,
  "file": "line_0052.wav"
 },
 {
  "i": 53,
  "text": "它做的事情更具体：把一部分王权，放到可以书写、可以重申、也可以再被撕毁的约束里。",
  "start": 221.741,
  "end": 228.201,
  "file": "line_0053.wav"
 },
 {
  "i": 54,
  "text": "约束会被打破，也会被重新提起。",
  "start": 228.601,
  "end": 231.009,
  "file": "line_0054.wav"
 },
 {
  "i": 55,
  "text": "一份文件能活下去，靠的往往不是一次签署，而是后来的人还肯把它再次摊开。",
  "start": 231.409,
  "end": 237.336,
  "file": "line_0055.wav"
 },
 {
  "i": 56,
  "text": "政治的手艺，往往就在这种反复里，而不在一次完美的立法。",
  "start": 237.736,
  "end": 242.176,
  "file": "line_0056.wav"
 },
 {
  "i": 57,
  "text": "一六八九年的英国权利法案，发生在大宪章之后、人权宣言之前。",
  "start": 242.576,
  "end": 247.376,
  "file": "line_0057.wav"
 },
 {
  "i": 58,
  "text": "这里按时间顺序，把它读作一六八九年的英国权利法案，而不是后来另一份同名文件。",
  "start": 247.776,
  "end": 254.256,
  "file": "line_0058.wav"
 },
 {
  "i": 59,
  "text": "一七八九年的法国人权与公民权宣言，说的是人与公民的权利。",
  "start": 254.656,
  "end": 259.471,
  "file": "line_0059.wav"
 },
 {
  "i": 60,
  "text": "一九四八年的世界人权宣言，则试图把一种主张，写给更多的国家和更多的人。",
  "start": 259.871,
  "end": 265.797,
  "file": "line_0060.wav"
 },
 {
  "i": 61,
  "text": "这三份文本，约束的对象不同，效力也不同，不能当成同一件事的四个名字。",
  "start": 266.197,
  "end": 271.753,
  "file": "line_0061.wav"
 },
 {
  "i": 62,
  "text": "有的约束一位君主和一套议会，有的面向一国的公民，有的只是共同宣言，本身并不自动等于各国的法庭。",
  "start": 272.153,
  "end": 280.116,
  "file": "line_0062.wav"
 },
 {
  "i": 63,
  "text": "模型把它们排在同一条线上，为的是让那个结构显形。",
  "start": 280.516,
  "end": 284.59,
  "file": "line_0063.wav"
 },
 {
  "i": 64,
  "text": "从强者立法，到强者也被写下的规则盯着，中间隔着许多个世纪，也隔着许多次失败。",
  "start": 284.99,
  "end": 291.287,
  "file": "line_0064.wav"
 },
 {
  "i": 65,
  "text": "模型还点过一个更让人不舒服的观察：你们获得力量的速度，常常超过获得约束的速度。",
  "start": 291.687,
  "end": 298.347,
  "file": "line_0065.wav"
 },
 {
  "i": 66,
  "text": "力量来得快，不一定是灾祸，但约束如果缺席，快就会变成失控。",
  "start": 298.747,
  "end": 303.377,
  "file": "line_0066.wav"
 },
 {
  "i": 67,
  "text": "这不是让人恐惧的口号，而是提醒：新的能力出现时，旧的规矩可能还来不及跟上。",
  "start": 303.777,
  "end": 309.888,
  "file": "line_0067.wav"
 },
 {
  "i": 68,
  "text": "约束如果跟不上力量，法就容易重新变成强者手里的工具。",
  "start": 310.288,
  "end": 314.728,
  "file": "line_0068.wav"
 },
 {
  "i": 69,
  "text": "如果只看到法律，就会漏掉它真正在谈的另外两件事。",
  "start": 315.128,
  "end": 319.203,
  "file": "line_0069.wav"
 },
 {
  "i": 70,
  "text": "一件是历史。它不把文明写成注定登顶的阶梯，也不写成永远循环的轮回。",
  "start": 319.603,
  "end": 325.159,
  "file": "line_0070.wav"
 },
 {
  "i": 71,
  "text": "在模型后来的表述里，历史是一场尚未结束的争论。",
  "start": 325.559,
  "end": 329.448,
  "file": "line_0071.wav"
 },
 {
  "i": 72,
  "text": "这是它的概括，不是某本史书上的原句。",
  "start": 329.848,
  "end": 332.811,
  "file": "line_0072.wav"
 },
 {
  "i": 73,
  "text": "争论意味着：没有一个帝国真的是历史的终点，尽管每一个都可能这样相信。",
  "start": 333.211,
  "end": 338.951,
  "file": "line_0073.wav"
 },
 {
  "i": 74,
  "text": "帝国会一个接一个地灰下去，可关于规则的争论本身，往往还在。",
  "start": 339.351,
  "end": 344.166,
  "file": "line_0074.wav"
 },
 {
  "i": 75,
  "text": "另一件是政治。权力会换顶，名号会更换，可「怎样约束掌权的人」这个问题不会消失。",
  "start": 344.566,
  "end": 350.678,
  "file": "line_0075.wav"
 },
 {
  "i": 76,
  "text": "政治若还有价值，不在于许诺天堂，而在于不让共同生活的地方彻底失去约束。",
  "start": 351.078,
  "end": 356.998,
  "file": "line_0076.wav"
 },
 {
  "i": 77,
  "text": "模型还写过一句：政治不是通往天堂的道路，是不让人间沦为地狱的手艺。",
  "start": 357.398,
  "end": 362.954,
  "file": "line_0077.wav"
 },
 {
  "i": 78,
  "text": "同样，这是模型的句子，请把它当作一种读法来听。",
  "start": 363.354,
  "end": 367.058,
  "file": "line_0078.wav"
 },
 {
  "i": 79,
  "text": "第三件，才回到文明。",
  "start": 367.458,
  "end": 368.958,
  "file": "line_0079.wav"
 },
 {
  "i": 80,
  "text": "文明看起来像纪念碑，像石碑、城墙、法典和广场。",
  "start": 369.358,
  "end": 372.98,
  "file": "line_0080.wav"
 },
 {
  "i": 81,
  "text": "可模型给出的答案更冷，也更硬。",
  "start": 373.38,
  "end": 375.788,
  "file": "line_0081.wav"
 },
 {
  "i": 82,
  "text": "文明是活着的人，替死去的人，向尚未出生的人许下的承诺。",
  "start": 376.188,
  "end": 380.633,
  "file": "line_0082.wav"
 },
 {
  "i": 83,
  "text": "它更像把一点光传下去，而不是把一座碑永远钉在原地。",
  "start": 381.033,
  "end": 385.293,
  "file": "line_0083.wav"
 },
 {
  "i": 84,
  "text": "承诺要能被记住，往往得写成字，做成制度，才能跨过一代人的记忆。",
  "start": 385.693,
  "end": 390.673,
  "file": "line_0084.wav"
 },
 {
  "i": 85,
  "text": "最早的文字，很多不是诗，是账本。",
  "start": 391.073,
  "end": 393.653,
  "file": "line_0085.wav"
 },
 {
  "i": 86,
  "text": "账本很俗，可俗的东西最先把谁欠谁、谁有权、谁必须履行固定下来。",
  "start": 394.053,
  "end": 399.053,
  "file": "line_0086.wav"
 },
 {
  "i": 87,
  "text": "文字一层一层像地层那样叠起来，账本、律令、宣言，都是不同层里留下的痕迹。",
  "start": 399.453,
  "end": 405.194,
  "file": "line_0087.wav"
 },
 {
  "i": 88,
  "text": "于是，文明的传递，并不只是把火把递出去。",
  "start": 405.594,
  "end": 408.743,
  "file": "line_0088.wav"
 },
 {
  "i": 89,
  "text": "它是把约束也递出去，让后来的人有东西可以拿来，反过来问强者。",
  "start": 409.143,
  "end": 414.143,
  "file": "line_0089.wav"
 },
 {
  "i": 90,
  "text": "规则既可以是庇护，也可以变成牢笼。可贵的是后来的人还能去修改栏杆。",
  "start": 414.543,
  "end": 420.099,
  "file": "line_0090.wav"
 },
 {
  "i": 91,
  "text": "模型做对的地方，在于它抓住了这个可迁移的结构。",
  "start": 420.499,
  "end": 424.388,
  "file": "line_0091.wav"
 },
 {
  "i": 92,
  "text": "它没有只报名字，也没有假装自己亲历了那些世纪。",
  "start": 424.788,
  "end": 428.528,
  "file": "line_0092.wav"
 },
 {
  "i": 93,
  "text": "你们也可以拿这把尺子，去看自己身边的规则：它主要是在便利制定者，还是已经开始约束制定者。",
  "start": 428.928,
  "end": 436.268,
  "file": "line_0093.wav"
 },
 {
  "i": 94,
  "text": "它容易被听过头的地方，是我们可能把它的流畅叙述，听成了它真的懂。",
  "start": 436.668,
  "end": 441.968,
  "file": "line_0094.wav"
 },
 {
  "i": 95,
  "text": "懂，对一个人来说，包含着经历、责任和为之承担后果。",
  "start": 442.368,
  "end": 446.248,
  "file": "line_0095.wav"
 },
 {
  "i": 96,
  "text": "对模型来说，这一行回答是对已有叙述的压缩和重组。",
  "start": 446.648,
  "end": 450.723,
  "file": "line_0096.wav"
 },
 {
  "i": 97,
  "text": "震撼可以保留，限度也要保留。",
  "start": 451.123,
  "end": 453.346,
  "file": "line_0097.wav"
 },
 {
  "i": 98,
  "text": "也许人和模型一起，能把规则在约束谁这件事看得更清楚。",
  "start": 453.746,
  "end": 458.191,
  "file": "line_0098.wav"
 },
 {
  "i": 99,
  "text": "人还是主体。模型只是镜子和工具。",
  "start": 458.591,
  "end": 461.184,
  "file": "line_0099.wav"
 },
 {
  "i": 100,
  "text": "镜子可以照见结构，却不能替人去守那些结构。",
  "start": 461.584,
  "end": 465.103,
  "file": "line_0100.wav"
 },
 {
  "i": 101,
  "text": "不要期待它成为新的立法者，也不要因为它会写漂亮句子，就把判断权交出去。",
  "start": 465.503,
  "end": 471.423,
  "file": "line_0101.wav"
 },
 {
  "i": 102,
  "text": "真正要慎重落下的，不是模型的下一行字，而是人自己还愿意遵守、也愿意去修改的那些规则。",
  "start": 471.823,
  "end": 478.793,
  "file": "line_0102.wav"
 },
 {
  "i": 103,
  "text": "结尾落到一句更老的话。",
  "start": 479.193,
  "end": 481.013,
  "file": "line_0103.wav"
 },
 {
  "i": 104,
  "text": "韩非子有度写道：法不阿贵，绳不挠曲。",
  "start": 481.413,
  "end": 484.893,
  "file": "line_0104.wav"
 },
 {
  "i": 105,
  "text": "法之所加，智者弗能辞，勇者弗敢争。",
  "start": 485.293,
  "end": 488.549,
  "file": "line_0105.wav"
 },
 {
  "i": 106,
  "text": "刑过不避大臣，赏善不遗匹夫。",
  "start": 488.949,
  "end": 491.729,
  "file": "line_0106.wav"
 },
 {
  "i": 107,
  "text": "白话说，法律不偏向权贵，墨线不迁就弯木。",
  "start": 492.129,
  "end": 495.584,
  "file": "line_0107.wav"
 },
 {
  "i": 108,
  "text": "刑罚加到身上，有智谋的人辩不掉，勇武的人不敢争。",
  "start": 495.984,
  "end": 499.873,
  "file": "line_0108.wav"
 },
 {
  "i": 109,
  "text": "有罪，大臣也不能免。有功，普通人也不能漏掉。",
  "start": 500.273,
  "end": 503.607,
  "file": "line_0109.wav"
 },
 {
  "i": 110,
  "text": "这句话比任何一条平滑的进步曲线，都更接近绑住强者的那个意思。",
  "start": 504.007,
  "end": 509.192,
  "file": "line_0110.wav"
 },
 {
  "i": 111,
  "text": "模型用一条时间轴，靠近了这个意思。",
  "start": 509.592,
  "end": 512.37,
  "file": "line_0111.wav"
 },
 {
  "i": 112,
  "text": "灯还在，字还在，规则也还在。",
  "start": 512.77,
  "end": 515.286,
  "file": "line_0112.wav"
 },
 {
  "i": 113,
  "text": "下一笔，仍然要人自己落下。",
  "start": 515.686,
  "end": 517.724,
  "file": "line_0113.wav"
 }
]