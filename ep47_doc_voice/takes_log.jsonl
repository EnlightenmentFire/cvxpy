{"id": "line_0099", "round": 0, "seed": 5016, "f0": 103.7, "f0_p10": 86.8, "f0_p90": 122.3, "dur": 3.76, "per": 0.0, "cer": 0.0, "asr": "人还是主体,模型只是镜子和工具。", "ok": false, "gen_s": 10.4, "score": 0.6445738366004186}
{"id": "line_0005", "round": 0, "seed": 5020, "f0": 93.0, "f0_p10": 73.3, "f0_p90": 115.8, "dur": 4.4, "per": 0.0, "cer": 0.067, "asr": "时间轴上汉摩拉比法典先亮了起来", "ok": true, "gen_s": 12.0, "score": 0.10045948288029365}
