  "seed": 5072,
  "f0_delivered": 101.3,
  "tempo_factor": 1.266,
  "rate_raw": 4.27,
  "rate": 5.4,
  "dur": 4.63,
  "asr": "力量来得快,不一定是灾祸,但约束如果缺席,快就会变成失控。",
