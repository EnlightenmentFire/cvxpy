{
"end": 836.5900000000004,
"lines": [
{
"id": "o01",
"ch": "open",
"sc": "hook",
"k": "n",
"t": "曹操大军压境，一个只带了一千多人的外来客将，赶来救援。",
"q": null,
"t0": 0.55,
"t1": 6.829069767441861
},
{
"id": "o02",
"ch": "open",
"sc": "hook",
"k": "n",
"t": "一年以后，这座州，归了他。",
"q": null,
"t0": 7.249069767441861,
"t1": 10.27232558139535
},
{
"id": "o03",
"ch": "open",
"sc": "who",
"k": "n",
"t": "这个人叫刘备。公元一九四年，他还只是公孙瓒阵营里的一个平原相，给青州刺史田楷当副手。",
"q": null,
"t0": 10.87232558139535,
"t1": 20.639767441860464
},
{
"id": "o04",
"ch": "open",
"sc": "who",
"k": "n",
"t": "史书给他记的家底，只有一行字：",
"q": null,
"t0": 21.059767441860465,
"t1": 24.54813953488372
},
{
"id": "o05",
"ch": "open",
"sc": "who",
"k": "q",
"t": "时先主自有兵千余人及幽州乌丸杂胡骑，又略得饥民数千人。",
"q": {
"orig": "時先主自有兵千餘人及幽州烏丸雜胡騎，又略得饑民數千人。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "自己的兵一千多，一些乌丸胡骑，外加沿路收拢的几千饥民。"
},
"t0": 24.968139534883722,
"t1": 31.247209302325583
},
{
"id": "o06",
"ch": "open",
"sc": "gift",
"k": "n",
"t": "可徐州牧陶谦一见他，就拨给他四千丹阳兵。陶谦本人就是丹阳人，这是他的同乡兵。",
"q": null,
"t0": 31.867209302325584,
"t1": 40.70441860465117
},
{
"id": "o07",
"ch": "open",
"sc": "gift",
"k": "q",
"t": "谦以丹杨兵四千益先主，先主遂去楷归谦。",
"q": {
"orig": "謙以丹楊兵四千益先主，先主遂去楷歸謙。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "陶谦给他四千丹阳兵，他就离开田楷，投了陶谦。"
},
"t0": 41.12441860465117,
"t1": 45.54302325581396
},
{
"id": "o08",
"ch": "open",
"sc": "gift",
"k": "n",
"t": "四千人，是他自己家底的好几倍。拿了兵，当场换老板，没有半点犹豫。",
"q": null,
"t0": 46.16302325581396,
"t1": 53.60488372093024
},
{
"id": "o09",
"ch": "open",
"sc": "beaten",
"k": "n",
"t": "那一年，他甚至还在郯城东边，被曹操正面打败过一次。",
"q": null,
"t0": 54.02488372093024,
"t1": 59.83883720930233
},
{
"id": "o10",
"ch": "open",
"sc": "deathbed",
"k": "n",
"t": "可没过多久，陶谦病重，留下一句话：",
"q": null,
"t0": 60.258837209302335,
"t1": 64.21232558139536
},
{
"id": "o11",
"ch": "open",
"sc": "deathbed",
"k": "q",
"t": "非刘备不能安此州也。",
"q": {
"orig": "非劉備不能安此州也。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "除了刘备，没人能安定徐州。"
},
"t0": 64.63232558139536,
"t1": 66.9579069767442
},
{
"id": "o12",
"ch": "open",
"sc": "question",
"k": "n",
"t": "一个外来的客将，兵不多，仗没打赢，在徐州连一寸自己的地都没有。",
"q": null,
"t0": 67.5779069767442,
"t1": 74.78720930232559
},
{
"id": "o13",
"ch": "open",
"sc": "question",
"k": "n",
"t": "为什么偏偏是他？徐州那些根深叶茂的豪族，又凭什么点头？",
"q": null,
"t0": 75.2072093023256,
"t1": 81.48627906976745
},
{
"id": "o14",
"ch": "open",
"sc": "title",
"k": "n",
"t": "这一集讲刘备第一次拿到一个州。不是打下来的，是被人请上去的。",
"q": null,
"t0": 81.90627906976745,
"t1": 88.88302325581397
},
{
"id": "a01",
"ch": "c1",
"sc": "pingyuan",
"k": "n",
"t": "先把时间往回倒几年。",
"q": null,
"t0": 92.08302325581396,
"t1": 94.40860465116279
},
{
"id": "a02",
"ch": "c1",
"sc": "pingyuan",
"k": "n",
"t": "刘备投奔老同学公孙瓒，被派到青州刺史田楷手下抵挡袁绍。仗打得不错，先试守平原县令，后来做了平原国的相。",
"q": null,
"t0": 94.82860465116279,
"t1": 106.68906976744186
},
{
"id": "a03",
"ch": "c1",
"sc": "pingyuan",
"k": "n",
"t": "平原在今天山东德州一带，隔着黄河，对面就是冀州的袁绍。",
"q": null,
"t0": 107.10906976744187,
"t1": 113.38813953488372
},
{
"id": "a04",
"ch": "c1",
"sc": "assassin",
"k": "n",
"t": "在这里，《三国志》专门记了一件小事。",
"q": null,
"t0": 113.80813953488372,
"t1": 117.99418604651163
},
{
"id": "a05",
"ch": "c1",
"sc": "assassin",
"k": "q",
"t": "郡民刘平素轻先主，耻为之下，使客刺之。客不忍刺，语之而去。其得人心如此。",
"q": {
"orig": "郡民劉平素輕先主，恥為之下，使客刺之。客不忍刺，語之而去。其得人心如此。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "本地人刘平看不起刘备，派刺客去杀他。刺客不忍下手，反把实情告诉了他。"
},
"t0": 118.41418604651163,
"t1": 126.78627906976745
},
{
"id": "a06",
"ch": "c1",
"sc": "assassin",
"k": "n",
"t": "刺客为什么下不了手？裴松之注引《魏书》说，刺客上门，刘备不知底细，待他非常厚。",
"q": null,
"t0": 127.40627906976745,
"t1": 136.4760465116279
},
{
"id": "a07",
"ch": "c1",
"sc": "famine",
"k": "n",
"t": "那几年闹饥荒，百姓成群结伙地抢掠。刘备对外抵御寇乱，对内拿出财物接济。",
"q": null,
"t0": 136.8960465116279,
"t1": 145.03558139534883
},
{
"id": "a08",
"ch": "c1",
"sc": "famine",
"k": "q",
"t": "士之下者，必与同席而坐，同簋而食，无所简择。众多归焉。",
"q": {
"orig": "士之下者，必與同席而坐，同簋而食，無所簡擇。眾多歸焉。",
"src": "《先主傳》裴注引《魏書》",
"lvl": 2,
"bai": "再低微的士人，他也同席坐、同锅吃，不挑人。所以人们都来投奔他。"
},
"t0": 145.45558139534884,
"t1": 151.7346511627907
},
{
"id": "a09",
"ch": "c1",
"sc": "famine",
"k": "n",
"t": "这就是他手里那几千饥民的来历。",
"q": null,
"t0": 152.3546511627907,
"t1": 155.84302325581396
},
{
"id": "a09b",
"ch": "c1",
"sc": "famine",
"k": "n",
"t": "汉末的兵从哪里来？无非三条：朝廷给的，豪族带的，流民投的。",
"q": null,
"t0": 156.26302325581395,
"t1": 163.00720930232558
},
{
"id": "a09c",
"ch": "c1",
"sc": "famine",
"k": "n",
"t": "刘备前两条都没有，只能靠第三条。谁能让饿着肚子的人吃上饭，人就跟谁走。",
"q": null,
"t0": 163.42720930232556,
"t1": 171.5667441860465
},
{
"id": "a10",
"ch": "c1",
"sc": "analogy1",
"k": "a",
"t": "打个比方：这像一个外地调来、在本地没有根基的地方长官，在灾年里靠亲民、收容流民，攒下了一身口碑。",
"q": null,
"t0": 171.9867441860465,
"t1": 183.14953488372092
},
{
"id": "a11",
"ch": "c1",
"sc": "analogy1",
"k": "b",
"t": "但这个比方有一处不成立：汉末的郡国长官同时掌兵，口碑换来的不是选票，也不是考评，而是兵源和投奔的人。",
"q": null,
"t0": 183.64953488372092,
"t1": 195.2774418604651
},
{
"id": "a12",
"ch": "c1",
"sc": "analogy1",
"k": "n",
"t": "在乱世里，人心可以直接折算成兵力。",
"q": null,
"t0": 195.7774418604651,
"t1": 199.73093023255814
},
{
"id": "b01",
"ch": "c2",
"sc": "bigmap",
"k": "n",
"t": "再看徐州这边。",
"q": null,
"t0": 202.73093023255814,
"t1": 204.35883720930232
},
{
"id": "b02",
"ch": "c2",
"sc": "bigmap",
"k": "n",
"t": "曹操的父亲曹嵩，在琅邪避难时被杀。曹操把这笔账，算在了陶谦头上。",
"q": null,
"t0": 204.7788372093023,
"t1": 212.2206976744186
},
{
"id": "b03",
"ch": "c2",
"sc": "bigmap",
"k": "q",
"t": "避难琅邪，为陶谦所害，故太祖志在复雠东伐。",
"q": {
"orig": "避難琅邪，為陶謙所害，故太祖志在復讎東伐。",
"src": "《三國志·武帝紀》",
"lvl": 1,
"bai": "曹嵩在琅邪避难时被陶谦所害，所以曹操一心东征复仇。"
},
"t0": 212.6406976744186,
"t1": 217.52441860465115
},
{
"id": "b04",
"ch": "c2",
"sc": "invade1",
"k": "n",
"t": "一九三年秋，曹军第一次东征，连下十几座城，陶谦缩在城里，不敢出来。",
"q": null,
"t0": 218.14441860465115,
"t1": 225.8188372093023
},
{
"id": "b05",
"ch": "c2",
"sc": "rescue",
"k": "n",
"t": "陶谦派人向青州刺史田楷告急。田楷带着刘备，从齐地南下。",
"q": null,
"t0": 226.23883720930232,
"t1": 232.51790697674417
},
{
"id": "b06",
"ch": "c2",
"sc": "xiaopei",
"k": "n",
"t": "刘备一到，陶谦就把四千丹阳兵交给他，又上表朝廷，让他做豫州刺史，驻扎小沛。",
"q": null,
"t0": 232.9379069767442,
"t1": 241.5425581395349
},
{
"id": "b06b",
"ch": "c2",
"sc": "supply",
"k": "q",
"t": "曹操军食亦尽，引兵还。",
"q": {
"orig": "曹操軍食亦盡，引兵還。",
"src": "《資治通鑑》卷六十一",
"lvl": 4,
"bai": "曹军的粮也吃完了，只好退兵。"
},
"t0": 241.96255813953488,
"t1": 244.52069767441859
},
{
"id": "b06c",
"ch": "c2",
"sc": "supply",
"k": "n",
"t": "远征几百里，粮草全靠后方一车一车地运。粮一断，再强的大军也得回家。",
"q": null,
"t0": 245.1406976744186,
"t1": 252.81511627906974
},
{
"id": "b07",
"ch": "c2",
"sc": "gate",
"k": "n",
"t": "看地图，小沛在哪儿？",
"q": null,
"t0": 253.23511627906976,
"t1": 255.5606976744186
},
{
"id": "b08",
"ch": "c2",
"sc": "gate",
"k": "n",
"t": "它属于豫州的沛国，却正卡在徐州的西门口，对面就是曹操的兖州。曹军从西边来，第一个碰上的就是小沛。",
"q": null,
"t0": 255.9806976744186,
"t1": 267.14348837209303
},
{
"id": "b08b",
"ch": "c2",
"sc": "gate",
"k": "n",
"t": "泗水从兖州方向流下来，经过沛，一路通到彭城、下邳。那个年代，河道就是运粮道，也是进兵道。",
"q": null,
"t0": 267.563488372093,
"t1": 277.7960465116279
},
{
"id": "b09",
"ch": "c2",
"sc": "gate",
"k": "n",
"t": "陶谦等于把西门交给了刘备。刘备，成了徐州的看门人。",
"q": null,
"t0": 278.2160465116279,
"t1": 284.03
},
{
"id": "b10",
"ch": "c2",
"sc": "invade2",
"k": "n",
"t": "一九四年夏天，曹操第二次东征，一路打到东海。沿途百姓的遭遇，史书只留了一句：",
"q": null,
"t0": 284.45,
"t1": 293.28720930232555
},
{
"id": "b11",
"ch": "c2",
"sc": "invade2",
"k": "q",
"t": "所过多所残戮。",
"q": {
"orig": "所過多所殘戮。",
"src": "《三國志·武帝紀》",
"lvl": 1,
"bai": "大军所过之处，杀戮极多。"
},
"t0": 293.70720930232557,
"t1": 295.3351162790698
},
{
"id": "b12",
"ch": "c2",
"sc": "tandong",
"k": "n",
"t": "回师经过郯城，陶谦的部将曹豹和刘备，在城东拦截。",
"q": null,
"t0": 295.9551162790697,
"t1": 301.5365116279069
},
{
"id": "b13",
"ch": "c2",
"sc": "tandong",
"k": "q",
"t": "谦将曹豹与刘备屯郯东，要太祖。太祖击破之。",
"q": {
"orig": "謙將曹豹與劉備屯郯東，要太祖。太祖擊破之。",
"src": "《三國志·武帝紀》",
"lvl": 1,
"bai": "曹豹和刘备在郯城东边拦截曹操，被曹操击破。"
},
"t0": 301.95651162790693,
"t1": 306.8402325581395
},
{
"id": "b14",
"ch": "c2",
"sc": "tandong",
"k": "n",
"t": "刘备败了。陶谦这边，史书写他：",
"q": null,
"t0": 307.46023255813947,
"t1": 310.9486046511627
},
{
"id": "b14b",
"ch": "c2",
"sc": "tandong",
"k": "q",
"t": "谦恐，欲走归丹杨。",
"q": {
"orig": "謙恐，欲走歸丹楊。",
"src": "《三國志·陶謙傳》",
"lvl": 1,
"bai": "陶谦害怕了，想逃回丹阳老家。"
},
"t0": 311.36860465116274,
"t1": 313.4616279069767
},
{
"id": "b15",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "就在这时，曹操的后院起火了。",
"q": null,
"t0": 314.0816279069767,
"t1": 317.33744186046505
},
{
"id": "b16",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "陈留太守张邈和陈宫背叛曹操，迎吕布进兖州，郡县纷纷响应。",
"q": null,
"t0": 317.75744186046506,
"t1": 324.2690697674418
},
{
"id": "b16b",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "整个兖州，只剩鄄城、范、东阿三座城，还在曹操手里。",
"q": null,
"t0": 324.6890697674418,
"t1": 330.5030232558139
},
{
"id": "b17",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "老巢眼看不保，曹操只能掉头回师。徐州之围，自己解了。",
"q": null,
"t0": 330.9230232558139,
"t1": 336.9695348837209
},
{
"id": "b17b",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "为什么非回不可？远征大军的粮草从兖州来，将士的家小也在兖州。后方一丢，前线就成了无根之木，补给先断，军心先散。",
"q": null,
"t0": 337.3895348837209,
"t1": 350.1802325581395
},
{
"id": "b18",
"ch": "c2",
"sc": "lubu2",
"k": "n",
"t": "你看，这一仗刘备没赢，可他拿到了一样比胜仗更值钱的东西：危难之时，赶来救援的名分。",
"q": null,
"t0": 350.6002325581395,
"t1": 360.13511627906973
},
{
"id": "b19",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "用三个问题，把这一步拆开。",
"q": null,
"t0": 361.03511627906977,
"t1": 364.05837209302325
},
{
"id": "b20",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "手里有什么？一千多自己的兵，一些乌丸杂胡骑，几千饥民，再加上陶谦给的四千丹阳兵。",
"q": null,
"t0": 364.47837209302327,
"t1": 373.7806976744186
},
{
"id": "b21",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "借了谁的势？陶谦的求援，加上曹操后院那把火。",
"q": null,
"t0": 374.2006976744186,
"t1": 379.31697674418604
},
{
"id": "b22",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "做对了哪一步？果断离开田楷，投向陶谦。",
"q": null,
"t0": 379.73697674418605,
"t1": 384.15558139534886
},
{
"id": "b23",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "在田楷那里，他是一支可有可无的偏师；到了陶谦这里，他是唯一挡在西门的屏障。",
"q": null,
"t0": 384.5755813953488,
"t1": 393.1802325581395
},
{
"id": "b24",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "被人依赖，才有分量。",
"q": null,
"t0": 393.6002325581395,
"t1": 395.92581395348833
},
{
"id": "c01",
"ch": "c3",
"sc": "sick",
"k": "n",
"t": "这一年还没过完，陶谦就病重了。",
"q": null,
"t0": 398.92581395348833,
"t1": 402.4141860465116
},
{
"id": "c02",
"ch": "c3",
"sc": "sick",
"k": "n",
"t": "据裴注引《吴书》，他的两个儿子陶商、陶应，都没有出来做官。州交给谁，等于给徐州找下一个靠山。",
"q": null,
"t0": 402.8341860465116,
"t1": 413.53186046511627
},
{
"id": "c03",
"ch": "c3",
"sc": "sick",
"k": "n",
"t": "病床前，他对别驾麋竺说：",
"q": null,
"t0": 413.9518604651163,
"t1": 416.7425581395349
},
{
"id": "c04",
"ch": "c3",
"sc": "sick",
"k": "q",
"t": "非刘备不能安此州也。",
"q": {
"orig": "非劉備不能安此州也。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "除了刘备，没人能安定徐州。"
},
"t0": 417.1625581395349,
"t1": 419.4881395348837
},
{
"id": "c05",
"ch": "c3",
"sc": "welcome",
"k": "n",
"t": "陶谦一死，麋竺带着徐州的人，到小沛去迎刘备。",
"q": null,
"t0": 420.1081395348837,
"t1": 425.22441860465113
},
{
"id": "c06",
"ch": "c3",
"sc": "welcome",
"k": "n",
"t": "刘备的第一反应，史书写了四个字：未敢当。",
"q": null,
"t0": 425.64441860465115,
"t1": 430.29558139534885
},
{
"id": "c07",
"ch": "c3",
"sc": "hall_chen",
"k": "n",
"t": "下邳的陈登站出来劝他：",
"q": null,
"t0": 430.7155813953488,
"t1": 433.2737209302325
},
{
"id": "c08",
"ch": "c3",
"sc": "hall_chen",
"k": "q",
"t": "彼州殷富，户口百万，欲屈使君抚临州事。",
"q": {
"orig": "彼州殷富，戶口百萬，欲屈使君撫臨州事。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "徐州富庶，人口百万，想委屈您来主持州务。"
},
"t0": 433.69372093023253,
"t1": 438.11232558139534
},
{
"id": "c09",
"ch": "c3",
"sc": "hall_liu",
"k": "n",
"t": "刘备推辞，把徐州往外让，让给袁术：",
"q": null,
"t0": 438.73232558139534,
"t1": 442.6858139534884
},
{
"id": "c10",
"ch": "c3",
"sc": "hall_liu",
"k": "q",
"t": "袁公路近在寿春，此君四世五公，海内所归，君可以州与之。",
"q": {
"orig": "袁公路近在壽春，此君四世五公，海內所歸，君可以州與之。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "袁术就在旁边的寿春，他家四代出了五位三公，天下归心，把徐州给他吧。"
},
"t0": 443.1058139534884,
"t1": 449.38488372093025
},
{
"id": "c11",
"ch": "c3",
"sc": "hall_chen2",
"k": "n",
"t": "陈登不接这个话头。他说袁术骄横，不是收拾乱局的人，然后许下一个数字：",
"q": null,
"t0": 450.00488372093025,
"t1": 457.9118604651163
},
{
"id": "c12",
"ch": "c3",
"sc": "hall_chen2",
"k": "q",
"t": "今欲为使君合步骑十万。",
"q": {
"orig": "今欲為使君合步騎十萬。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "我们愿意替您凑齐十万步骑。"
},
"t0": 458.3318604651163,
"t1": 460.89
},
{
"id": "c12b",
"ch": "c3",
"sc": "hall_chen2",
"k": "n",
"t": "接着，陈登又加了一句重话：",
"q": null,
"t0": 461.51,
"t1": 464.5332558139535
},
{
"id": "c12c",
"ch": "c3",
"sc": "hall_chen2",
"k": "q",
"t": "若使君不见听许，登亦未敢听使君也。",
"q": {
"orig": "若使君不見聽許，登亦未敢聽使君也。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "您要是不答应，我陈登也不敢再听您的了。"
},
"t0": 464.9532558139535,
"t1": 468.9067441860465
},
{
"id": "c12d",
"ch": "c3",
"sc": "hall_chen2",
"k": "n",
"t": "这已经不是请，是逼。",
"q": null,
"t0": 469.5267441860465,
"t1": 471.85232558139535
},
{
"id": "c13",
"ch": "c3",
"sc": "hall_kong",
"k": "n",
"t": "北海相孔融，孔子的二十世孙，天下闻名的名士，说得更狠：",
"q": null,
"t0": 472.27232558139536,
"t1": 478.5513953488372
},
{
"id": "c14",
"ch": "c3",
"sc": "hall_kong",
"k": "q",
"t": "袁公路岂忧国忘家者邪？冢中枯骨，何足介意。",
"q": {
"orig": "袁公路豈憂國忘家者邪？冢中枯骨，何足介意。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "袁术哪是忧国忘家的人？坟里的一把枯骨，不必放在心上。"
},
"t0": 478.97139534883723,
"t1": 483.8551162790698
},
{
"id": "c15",
"ch": "c3",
"sc": "hall_kong",
"k": "n",
"t": "名士开口，等于给这件事盖了章。于是，刘备领了徐州。",
"q": null,
"t0": 484.47511627906977,
"t1": 490.28906976744184
},
{
"id": "c16",
"ch": "c3",
"sc": "who_ask",
"k": "n",
"t": "这场戏，要看懂两层。第一层，是谁在请他。",
"q": null,
"t0": 491.28906976744184,
"t1": 495.94023255813954
},
{
"id": "c17",
"ch": "c3",
"sc": "who_ask",
"k": "q",
"t": "祖世货殖，僮客万人，赀产巨亿。",
"q": {
"orig": "祖世貨殖，僮客萬人，貲產鉅億。",
"src": "《三國志·麋竺傳》",
"lvl": 1,
"bai": "麋竺家祖辈经商，僮仆门客上万，资产上亿。"
},
"t0": 496.3602325581395,
"t1": 499.84860465116276
},
{
"id": "c18",
"ch": "c3",
"sc": "who_ask",
"k": "n",
"t": "这是麋竺，东海的豪商。陈登，出身下邳的官宦大族，父亲陈珪做过沛相。",
"q": null,
"t0": 500.46860465116276,
"t1": 508.14302325581394
},
{
"id": "c19",
"ch": "c3",
"sc": "who_ask",
"k": "n",
"t": "他们要的，是一个能打仗、又压不住他们的人。",
"q": null,
"t0": 508.5630232558139,
"t1": 513.4467441860464
},
{
"id": "c20",
"ch": "c3",
"sc": "balance",
"k": "n",
"t": "把两个人放上天平。",
"q": null,
"t0": 513.8667441860465,
"t1": 515.9597674418604
},
{
"id": "c21",
"ch": "c3",
"sc": "balance",
"k": "n",
"t": "袁术太重。四世五公，自带班底，兵强马壮。他一进徐州，本地豪族就只能当附庸。",
"q": null,
"t0": 516.3797674418605,
"t1": 524.9844186046512
},
{
"id": "c22",
"ch": "c3",
"sc": "balance",
"k": "n",
"t": "刘备刚好。会打仗，有名声，可在徐州没有根；兵有一半是陶谦给的，钱粮要靠本地人。",
"q": null,
"t0": 525.4044186046513,
"t1": 534.4741860465117
},
{
"id": "c23",
"ch": "c3",
"sc": "balance",
"k": "n",
"t": "他够用，又离不开他们。这就是本地精英眼里的最优弱主。",
"q": null,
"t0": 534.8941860465118,
"t1": 540.9406976744187
},
{
"id": "c24",
"ch": "c3",
"sc": "decline",
"k": "n",
"t": "第二层，是那几次推辞。",
"q": null,
"t0": 541.7406976744187,
"t1": 544.2988372093024
},
{
"id": "c25",
"ch": "c3",
"sc": "decline",
"k": "n",
"t": "推辞不是客气，是一个合法性动作。刘备每推一次，推举的人就得多表一次态：不选袁术，偏选你，还要当众许下十万步骑。",
"q": null,
"t0": 544.7188372093024,
"t1": 557.509534883721
},
{
"id": "c26",
"ch": "c3",
"sc": "decline",
"k": "n",
"t": "推到最后，这个州不是刘备伸手拿的，而是一州的人公开托付给他的。责任，分摊到了每一个劝进的人身上。",
"q": null,
"t0": 557.929534883721,
"t1": 569.0923255813954
},
{
"id": "c27",
"ch": "c3",
"sc": "yuanshao",
"k": "n",
"t": "事后，陈登他们还派人去见当时的盟主袁绍，请他背书。袁绍回答：",
"q": null,
"t0": 569.5123255813954,
"t1": 576.489069767442
},
{
"id": "c28",
"ch": "c3",
"sc": "yuanshao",
"k": "q",
"t": "刘玄德弘雅有信义，今徐州乐戴之，诚副所望也。",
"q": {
"orig": "劉玄德弘雅有信義，今徐州樂戴之，誠副所望也。",
"src": "《先主傳》裴注引《獻帝春秋》",
"lvl": 2,
"bai": "刘备宽厚有信义，徐州人乐意拥戴他，正合我意。"
},
"t0": 576.9090697674419,
"t1": 582.0253488372093
},
{
"id": "c28b",
"ch": "c3",
"sc": "yuanshao",
"k": "n",
"t": "陈登他们给袁绍的信里有一句：辄共奉故平原相刘备府君以为宗主。注意那个共字：是大家一起奉他。",
"q": null,
"t0": 582.6453488372093,
"t1": 593.1104651162791
},
{
"id": "c29",
"ch": "c3",
"sc": "analogy2",
"k": "a",
"t": "打个比方：一个地方的几大世家和旧班底，共同推举一位外来的、能带兵、却在本地没有根基的人，出任封疆大吏。彼此都放心。",
"q": null,
"t0": 593.5304651162791,
"t1": 606.7862790697675
},
{
"id": "c30",
"ch": "c3",
"sc": "analogy2",
"k": "b",
"t": "但这个比方也有不成立的地方：当时没有中央任命。领徐州，靠的是地方推举，加上事后补一道表奏。这种合法性，比今天任何一份正式任命都脆弱。",
"q": null,
"t0": 607.2862790697675,
"t1": 622.6351162790698
},
{
"id": "c31",
"ch": "c3",
"sc": "analogy2",
"k": "n",
"t": "所以两年以后，一场偷袭，就够了。",
"q": null,
"t0": 623.1351162790698,
"t1": 626.8560465116279
},
{
"id": "d01",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "一九六年，袁术来攻。刘备在盱眙、淮阴和他相持了一个多月。",
"q": null,
"t0": 629.8560465116279,
"t1": 636.3676744186047
},
{
"id": "d02",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "吕布乘虚偷袭下邳，守将曹豹反水，开门迎布。刘备的妻儿成了俘虏，徐州丢了。",
"q": null,
"t0": 636.7876744186046,
"t1": 645.1597674418605
},
{
"id": "d02b",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "裴注引《英雄记》补了一个细节：刘备留张飞守下邳，张飞要杀曹豹，曹豹据营自守，派人去招吕布。",
"q": null,
"t0": 645.5797674418604,
"t1": 656.0448837209302
},
{
"id": "d03",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "开门的曹豹，正是陶谦的旧部。最优弱主的代价就在这里：你压不住他们，就总有人另找靠山。",
"q": null,
"t0": 656.4648837209302,
"t1": 666.2323255813953
},
{
"id": "d03b",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "可刘备回到小沛，没多久又聚起了一万多人。",
"q": null,
"t0": 666.6523255813953,
"t1": 671.3034883720929
},
{
"id": "d04",
"ch": "c4",
"sc": "gain",
"k": "n",
"t": "但这一年多，刘备真正攒下了两样东西。",
"q": null,
"t0": 671.723488372093,
"t1": 675.9095348837209
},
{
"id": "d05",
"ch": "c4",
"sc": "gain",
"k": "n",
"t": "第一样是名分。当过一州之主，天下诸侯第一次把他当成一方人物。就在这一年，曹操上表，封他为镇东将军、宜城亭侯。",
"q": null,
"t0": 676.329534883721,
"t1": 688.8876744186047
},
{
"id": "d05b",
"ch": "c4",
"sc": "gain",
"k": "n",
"t": "后来他走投无路去投曹操，曹操任他为豫州牧。徐州那段履历，成了他的身价。",
"q": null,
"t0": 689.3076744186046,
"t1": 697.4472093023255
},
{
"id": "d06",
"ch": "c4",
"sc": "gain2",
"k": "n",
"t": "第二样，是人和钱。徐州丢了，刘备转到广陵海西，正是最难的时候。麋竺做了一件事：",
"q": null,
"t0": 697.8672093023256,
"t1": 706.936976744186
},
{
"id": "d07",
"ch": "c4",
"sc": "gain2",
"k": "q",
"t": "竺于是进妹于先主为夫人，奴客二千，金银货币以助军资，于时困匮，赖此复振。",
"q": {
"orig": "竺于是進妹于先主為夫人，奴客二千，金銀貨幣以助軍資，于時困匱，賴此複振。",
"src": "《三國志·麋竺傳》",
"lvl": 1,
"bai": "麋竺把妹妹嫁给刘备，又送上两千奴客和金银，助他重新振作。"
},
"t0": 707.3569767441861,
"t1": 715.729069767442
},
{
"id": "d08",
"ch": "c4",
"sc": "gain2",
"k": "n",
"t": "后来曹操表麋竺做嬴郡太守，麋竺的弟弟麋芳做彭城相，兄弟俩都辞了官，跟着刘备走。",
"q": null,
"t0": 716.349069767442,
"t1": 725.4188372093024
},
{
"id": "d09",
"ch": "c4",
"sc": "gain2",
"k": "n",
"t": "地盘丢了，人没丢。一个豪商家族，把身家押在了一个没有地盘的人身上。",
"q": null,
"t0": 725.8388372093025,
"t1": 733.5132558139536
},
{
"id": "e01",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "很多人熟悉的，是《三国演义》里的三让徐州。",
"q": null,
"t0": 736.5132558139536,
"t1": 741.3969767441862
},
{
"id": "e02",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "演义说：陶谦三次把徐州让给刘备，刘备三次推辞。",
"q": null,
"t0": 741.8169767441861,
"t1": 747.1658139534885
},
{
"id": "e03",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "史书说：陶谦只在临终前，对麋竺留下一句话；真正当面劝进的，是麋竺、陈登和孔融。",
"q": null,
"t0": 747.5858139534885,
"t1": 756.6555813953489
},
{
"id": "e04",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "演义把这件事，写成了陶谦一个人的仁厚。史书里，它是一州精英的集体选择。",
"q": null,
"t0": 757.075581395349,
"t1": 765.2151162790699
},
{
"id": "e05",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "这个差别要紧。一个人的仁厚，换了人就没了；一州精英的选择，背后是他们自己的算盘。算盘一变，人也会变，曹豹就是例子。",
"q": null,
"t0": 765.63511627907,
"t1": 778.8909302325584
},
{
"id": "f01",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "回到开头的问题：为什么是他？",
"q": null,
"t0": 781.8909302325584,
"t1": 785.1467441860468
},
{
"id": "f02",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "平原的刺客，路上的饥民，徐州的豪商，没有一个是他抢来的。",
"q": null,
"t0": 785.5667441860468,
"t1": 792.0783720930235
},
{
"id": "f02b",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "从平原到徐州，他做的其实是同一件事：先让人离不开他，再等人来请。",
"q": null,
"t0": 792.4983720930235,
"t1": 799.9402325581398
},
{
"id": "f03",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "司马迁写李广，引过一句谚语：",
"q": null,
"t0": 800.3602325581397,
"t1": 803.6160465116282
},
{
"id": "f04",
"ch": "c6",
"sc": "end",
"k": "q",
"t": "桃李不言，下自成蹊。",
"q": {
