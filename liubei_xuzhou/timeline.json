{
"end": 716.9896458333333,
"lines": [
{
"id": "o01",
"ch": "open",
"sc": "hook",
"k": "n",
"t": "曹操大军压境，一个只带了一千多人的外来客将，赶来救援。",
"q": null,
"t0": 0.55,
"t1": 5.092375
},
{
"id": "o02",
"ch": "open",
"sc": "hook",
"k": "n",
"t": "一年以后，这座州，归了他。",
"q": null,
"t0": 5.512375,
"t1": 8.308979166666667
},
{
"id": "o03",
"ch": "open",
"sc": "who",
"k": "n",
"t": "这个人叫刘备。公元一九四年，他还只是公孙瓒阵营里的一个平原相，给青州刺史田楷当副手。",
"q": null,
"t0": 8.908979166666667,
"t1": 15.9144375
},
{
"id": "o04",
"ch": "open",
"sc": "who",
"k": "n",
"t": "史书给他记的家底，只有一行字：",
"q": null,
"t0": 16.3344375,
"t1": 18.9615625
},
{
"id": "o05",
"ch": "open",
"sc": "who",
"k": "q",
"t": "时先主自有兵千余人及幽州乌丸杂胡骑，又略得饥民数千人。",
"q": {
"orig": "時先主自有兵千餘人及幽州烏丸雜胡騎，又略得饑民數千人。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "自己的兵一千多，一些乌丸胡骑，外加沿路收拢的几千饥民。"
},
"t0": 19.3815625,
"t1": 24.9969375
},
{
"id": "o06",
"ch": "open",
"sc": "gift",
"k": "n",
"t": "可徐州牧陶谦一见他，就拨给他四千丹阳兵。陶谦本人就是丹阳人，这是他的同乡兵。",
"q": null,
"t0": 25.616937500000002,
"t1": 32.30035416666667
},
{
"id": "o07",
"ch": "open",
"sc": "gift",
"k": "q",
"t": "谦以丹杨兵四千益先主，先主遂去楷归谦。",
"q": {
"orig": "謙以丹楊兵四千益先主，先主遂去楷歸謙。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "陶谦给他四千丹阳兵，他就离开田楷，投了陶谦。"
},
"t0": 32.72035416666667,
"t1": 36.951125
},
{
"id": "o08",
"ch": "open",
"sc": "gift",
"k": "n",
"t": "四千人，是他自己家底的好几倍。拿了兵，当场换老板，没有半点犹豫。",
"q": null,
"t0": 37.571125,
"t1": 43.71216666666667
},
{
"id": "o09",
"ch": "open",
"sc": "beaten",
"k": "n",
"t": "那一年，他甚至还在郯城东边，被曹操正面打败过一次。",
"q": null,
"t0": 44.13216666666667,
"t1": 48.57285416666667
},
{
"id": "o10",
"ch": "open",
"sc": "deathbed",
"k": "n",
"t": "可没过多久，陶谦病重，留下一句话：",
"q": null,
"t0": 48.99285416666667,
"t1": 52.247083333333336
},
{
"id": "o11",
"ch": "open",
"sc": "deathbed",
"k": "q",
"t": "非刘备不能安此州也。",
"q": {
"orig": "非劉備不能安此州也。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "除了刘备，没人能安定徐州。"
},
"t0": 52.66708333333334,
"t1": 54.70554166666667
},
{
"id": "o12",
"ch": "open",
"sc": "question",
"k": "n",
"t": "一个外来的客将，兵不多，仗没打赢，在徐州连一寸自己的地都没有。",
"q": null,
"t0": 55.32554166666667,
"t1": 60.986562500000005
},
{
"id": "o13",
"ch": "open",
"sc": "question",
"k": "n",
"t": "为什么偏偏是他？徐州那些根深叶茂的豪族，又凭什么点头？",
"q": null,
"t0": 61.40656250000001,
"t1": 66.42895833333334
},
{
"id": "o14",
"ch": "open",
"sc": "title",
"k": "n",
"t": "这一集讲刘备第一次拿到一个州。不是打下来的，是被人请上去的。",
"q": null,
"t0": 66.84895833333334,
"t1": 71.44762500000002
},
{
"id": "a01",
"ch": "c1",
"sc": "pingyuan",
"k": "n",
"t": "先把时间往回倒几年。",
"q": null,
"t0": 74.647625,
"t1": 76.32558333333334
},
{
"id": "a02",
"ch": "c1",
"sc": "pingyuan",
"k": "n",
"t": "刘备投奔老同学公孙瓒，被派到青州刺史田楷手下抵挡袁绍。仗打得不错，先试守平原县令，后来做了平原国的相。",
"q": null,
"t0": 76.74558333333334,
"t1": 86.03916666666667
},
{
"id": "a03",
"ch": "c1",
"sc": "pingyuan",
"k": "n",
"t": "平原在今天山东德州一带，隔着黄河，对面就是冀州的袁绍。",
"q": null,
"t0": 86.45916666666668,
"t1": 91.30662500000001
},
{
"id": "a04",
"ch": "c1",
"sc": "assassin",
"k": "n",
"t": "在这里，《三国志》专门记了一件小事。",
"q": null,
"t0": 91.72662500000001,
"t1": 94.74358333333335
},
{
"id": "a05",
"ch": "c1",
"sc": "assassin",
"k": "q",
"t": "郡民刘平素轻先主，耻为之下，使客刺之。客不忍刺，语之而去。其得人心如此。",
"q": {
"orig": "郡民劉平素輕先主，恥為之下，使客刺之。客不忍刺，語之而去。其得人心如此。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "本地人刘平看不起刘备，派刺客去杀他。刺客不忍下手，反把实情告诉了他。"
},
"t0": 95.16358333333335,
"t1": 104.27081250000002
},
{
"id": "a06",
"ch": "c1",
"sc": "assassin",
"k": "n",
"t": "刺客为什么下不了手？裴松之注引《魏书》说，刺客上门，刘备不知底细，待他非常厚。",
"q": null,
"t0": 104.89081250000001,
"t1": 111.38779166666667
},
{
"id": "a07",
"ch": "c1",
"sc": "famine",
"k": "n",
"t": "那几年闹饥荒，百姓成群结伙地抢掠。刘备对外抵御寇乱，对内拿出财物接济。",
"q": null,
"t0": 111.80779166666667,
"t1": 118.101375
},
{
"id": "a08",
"ch": "c1",
"sc": "famine",
"k": "q",
"t": "士之下者，必与同席而坐，同簋而食，无所简择。众多归焉。",
"q": {
"orig": "士之下者，必與同席而坐，同簋而食，無所簡擇。眾多歸焉。",
"src": "《先主傳》裴注引《魏書》",
"lvl": 2,
"bai": "再低微的士人，他也同席坐、同锅吃，不挑人。所以人们都来投奔他。"
},
"t0": 118.521375,
"t1": 124.98291666666667
},
{
"id": "a09",
"ch": "c1",
"sc": "famine",
"k": "n",
"t": "这就是他手里那几千饥民的来历。",
"q": null,
"t0": 125.60291666666667,
"t1": 127.95885416666667
},
{
"id": "a09b",
"ch": "c1",
"sc": "famine",
"k": "n",
"t": "汉末的兵从哪里来？无非三条：朝廷给的，豪族带的，流民投的。",
"q": null,
"t0": 128.37885416666668,
"t1": 134.04533333333336
},
{
"id": "a09c",
"ch": "c1",
"sc": "famine",
"k": "n",
"t": "刘备前两条都没有，只能靠第三条。谁能让饿着肚子的人吃上饭，人就跟谁走。",
"q": null,
"t0": 134.46533333333335,
"t1": 140.11485416666667
},
{
"id": "a10",
"ch": "c1",
"sc": "analogy1",
"k": "a",
"t": "打个比方：这像一个外地调来、在本地没有根基的地方长官，在灾年里靠亲民、收容流民，攒下了一身口碑。",
"q": null,
"t0": 140.5348541666667,
"t1": 148.75518750000003
},
{
"id": "a11",
"ch": "c1",
"sc": "analogy1",
"k": "b",
"t": "但这个比方有一处不成立：汉末的郡国长官同时掌兵，口碑换来的不是选票，也不是考评，而是兵源和投奔的人。",
"q": null,
"t0": 149.25518750000003,
"t1": 157.54877083333338
},
{
"id": "a12",
"ch": "c1",
"sc": "analogy1",
"k": "n",
"t": "在乱世里，人心可以直接折算成兵力。",
"q": null,
"t0": 158.04877083333338,
"t1": 161.15045833333338
},
{
"id": "b01",
"ch": "c2",
"sc": "bigmap",
"k": "n",
"t": "再看徐州这边。",
"q": null,
"t0": 164.15045833333338,
"t1": 165.31995833333337
},
{
"id": "b02",
"ch": "c2",
"sc": "bigmap",
"k": "n",
"t": "曹操的父亲曹嵩，在琅邪避难时被杀。曹操把这笔账，算在了陶谦头上。",
"q": null,
"t0": 165.73995833333336,
"t1": 171.62677083333335
},
{
"id": "b03",
"ch": "c2",
"sc": "bigmap",
"k": "q",
"t": "避难琅邪，为陶谦所害，故太祖志在复雠东伐。",
"q": {
"orig": "避難琅邪，為陶謙所害，故太祖志在復讎東伐。",
"src": "《三國志·武帝紀》",
"lvl": 1,
"bai": "曹嵩在琅邪避难时被陶谦所害，所以曹操一心东征复仇。"
},
"t0": 172.04677083333337,
"t1": 176.62368750000005
},
{
"id": "b04",
"ch": "c2",
"sc": "invade1",
"k": "n",
"t": "一九三年秋，曹军第一次东征，连下十几座城，陶谦缩在城里，不敢出来。",
"q": null,
"t0": 177.24368750000002,
"t1": 183.29454166666667
},
{
"id": "b05",
"ch": "c2",
"sc": "rescue",
"k": "n",
"t": "陶谦派人向青州刺史田楷告急。田楷带着刘备，从齐地南下。",
"q": null,
"t0": 183.7145416666667,
"t1": 189.16066666666669
},
{
"id": "b06",
"ch": "c2",
"sc": "xiaopei",
"k": "n",
"t": "刘备一到，陶谦就把四千丹阳兵交给他，又上表朝廷，让他做豫州刺史，驻扎小沛。记住这支丹阳兵，后面它还会出场。",
"q": null,
"t0": 189.5806666666667,
"t1": 199.3657916666667
},
{
"id": "b06b",
"ch": "c2",
"sc": "supply",
"k": "q",
"t": "曹操军食亦尽，引兵还。",
"q": {
"orig": "曹操軍食亦盡，引兵還。",
"src": "《資治通鑑》卷六十一",
"lvl": 4,
"bai": "曹军的粮也吃完了，只好退兵。"
},
"t0": 199.7857916666667,
"t1": 202.26656250000005
},
{
"id": "b06c",
"ch": "c2",
"sc": "supply",
"k": "n",
"t": "远征几百里，粮草全靠后方一车一车地运。粮一断，再强的大军也得回家。",
"q": null,
"t0": 202.88656250000005,
"t1": 209.11235416666673
},
{
"id": "b07",
"ch": "c2",
"sc": "gate",
"k": "n",
"t": "看地图，小沛在哪儿？",
"q": null,
"t0": 209.53235416666672,
"t1": 211.53235416666672
},
{
"id": "b08",
"ch": "c2",
"sc": "gate",
"k": "n",
"t": "它属于豫州的沛国，却正卡在徐州的西门口，对面就是曹操的兖州。曹军从西边来，第一个碰上的就是小沛。",
"q": null,
"t0": 211.9523541666667,
"t1": 220.3476458333334
},
{
"id": "b08b",
"ch": "c2",
"sc": "gate",
"k": "n",
"t": "泗水从兖州方向流下来，经过沛，一路通到彭城、下邳。那个年代，河道就是运粮道，也是进兵道。",
"q": null,
"t0": 220.76764583333338,
"t1": 228.95954166666672
},
{
"id": "b09",
"ch": "c2",
"sc": "gate",
"k": "n",
"t": "陶谦等于把西门交给了刘备。刘备，成了徐州的看门人。",
"q": null,
"t0": 229.3795416666667,
"t1": 234.06295833333337
},
{
"id": "b10",
"ch": "c2",
"sc": "invade2",
"k": "n",
"t": "一九四年夏天，曹操第二次东征，一路打到东海。沿途百姓的遭遇，史书只留了一句：",
"q": null,
"t0": 234.48295833333339,
"t1": 241.38672916666673
},
{
"id": "b11",
"ch": "c2",
"sc": "invade2",
"k": "q",
"t": "所过多所残戮。",
"q": {
"orig": "所過多所殘戮。",
"src": "《三國志·武帝紀》",
"lvl": 1,
"bai": "大军所过之处，杀戮极多。"
},
"t0": 241.8067291666667,
"t1": 243.2682708333334
},
{
"id": "b12",
"ch": "c2",
"sc": "tandong",
"k": "n",
"t": "回师经过郯城，陶谦的部将曹豹和刘备，在城东拦截。",
"q": null,
"t0": 243.8882708333334,
"t1": 248.46454166666672
},
{
"id": "b13",
"ch": "c2",
"sc": "tandong",
"k": "q",
"t": "谦将曹豹与刘备屯郯东，要太祖。太祖击破之。",
"q": {
"orig": "謙將曹豹與劉備屯郯東，要太祖。太祖擊破之。",
"src": "《三國志·武帝紀》",
"lvl": 1,
"bai": "曹豹和刘备在郯城东边拦截曹操，被曹操击破。"
},
"t0": 248.88454166666673,
"t1": 253.9037708333334
},
{
"id": "b14",
"ch": "c2",
"sc": "tandong",
"k": "n",
"t": "刘备败了。陶谦这边，史书写他：",
"q": null,
"t0": 254.5237708333334,
"t1": 257.69327083333343
},
{
"id": "b14b",
"ch": "c2",
"sc": "tandong",
"k": "q",
"t": "谦恐，欲走归丹杨。",
"q": {
"orig": "謙恐，欲走歸丹楊。",
"src": "《三國志·陶謙傳》",
"lvl": 1,
"bai": "陶谦害怕了，想逃回丹阳老家。"
},
"t0": 258.1132708333334,
"t1": 260.5171250000001
},
{
"id": "b15",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "就在这时，曹操的后院起火了。",
"q": null,
"t0": 261.1371250000001,
"t1": 263.8659375000001
},
{
"id": "b16",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "陈留太守张邈和陈宫背叛曹操，迎吕布进兖州，郡县纷纷响应。",
"q": null,
"t0": 264.2859375000001,
"t1": 269.21814583333344
},
{
"id": "b16b",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "整个兖州，只剩鄄城、范、东阿三座城，还在曹操手里。",
"q": null,
"t0": 269.63814583333345,
"t1": 274.68900000000014
},
{
"id": "b17",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "老巢眼看不保，曹操只能掉头回师。徐州之围，自己解了。",
"q": null,
"t0": 275.1090000000001,
"t1": 280.0975000000001
},
{
"id": "b17b",
"ch": "c2",
"sc": "lubu",
"k": "n",
"t": "为什么非回不可？远征大军的粮草从兖州来，将士的家小也在兖州。后方一丢，前线就成了无根之木，补给先断，军心先散。",
"q": null,
"t0": 280.5175000000001,
"t1": 290.9860416666668
},
{
"id": "b18",
"ch": "c2",
"sc": "lubu2",
"k": "n",
"t": "你看，这一仗刘备没赢，可他拿到了一样比胜仗更值钱的东西：危难之时，赶来救援的名分。",
"q": null,
"t0": 291.40604166666674,
"t1": 298.56404166666675
},
{
"id": "b19",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "用三个问题，把这一步拆开。",
"q": null,
"t0": 299.46404166666673,
"t1": 301.7691250000001
},
{
"id": "b20",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "手里有什么？一千多自己的兵，一些乌丸杂胡骑，几千饥民，再加上陶谦给的四千丹阳兵。",
"q": null,
"t0": 302.18912500000005,
"t1": 309.5505208333334
},
{
"id": "b21",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "借了谁的势？陶谦的求援，加上曹操后院那把火。",
"q": null,
"t0": 309.97052083333335,
"t1": 313.77258333333333
},
{
"id": "b22",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "做对了哪一步？果断离开田楷，投向陶谦。",
"q": null,
"t0": 314.19258333333335,
"t1": 317.67262500000004
},
{
"id": "b23",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "在田楷那里，他是一支可有可无的偏师；到了陶谦这里，他是唯一挡在西门的屏障。",
"q": null,
"t0": 318.092625,
"t1": 324.48791666666665
},
{
"id": "b24",
"ch": "c2",
"sc": "q3",
"k": "n",
"t": "被人依赖，才有分量。",
"q": null,
"t0": 324.90791666666667,
"t1": 326.7892708333333
},
{
"id": "c01",
"ch": "c3",
"sc": "sick",
"k": "n",
"t": "这一年还没过完，陶谦就病重了。",
"q": null,
"t0": 329.7892708333333,
"t1": 332.3994375
},
{
"id": "c02",
"ch": "c3",
"sc": "sick",
"k": "n",
"t": "据裴注引《吴书》，他的两个儿子陶商、陶应，都没有出来做官。州交给谁，等于给徐州找下一个靠山。",
"q": null,
"t0": 332.8194375,
"t1": 340.65539583333333
},
{
"id": "c03",
"ch": "c3",
"sc": "sick",
"k": "n",
"t": "病床前，他对别驾麋竺说：",
"q": null,
"t0": 341.07539583333335,
"t1": 343.329625
},
{
"id": "c04",
"ch": "c3",
"sc": "sick",
"k": "q",
"t": "非刘备不能安此州也。",
"q": {
"orig": "非劉備不能安此州也。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "除了刘备，没人能安定徐州。"
},
"t0": 343.74962500000004,
"t1": 345.84577083333335
},
{
"id": "c05",
"ch": "c3",
"sc": "welcome",
"k": "n",
"t": "陶谦一死，麋竺带着徐州的人，到小沛去迎刘备。",
"q": null,
"t0": 346.46577083333335,
"t1": 350.5674583333334
},
{
"id": "c06",
"ch": "c3",
"sc": "welcome",
"k": "n",
"t": "刘备的第一反应，史书写了四个字：未敢当。",
"q": null,
"t0": 350.98745833333334,
"t1": 354.9705
},
{
"id": "c07",
"ch": "c3",
"sc": "hall_chen",
"k": "n",
"t": "下邳的陈登站出来劝他：",
"q": null,
"t0": 355.3905,
"t1": 357.1532083333333
},
{
"id": "c08",
"ch": "c3",
"sc": "hall_chen",
"k": "q",
"t": "彼州殷富，户口百万，欲屈使君抚临州事。",
"q": {
"orig": "彼州殷富，戶口百萬，欲屈使君撫臨州事。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "徐州富庶，人口百万，想委屈您来主持州务。"
},
"t0": 357.5732083333333,
"t1": 362.2270625
},
{
"id": "c09",
"ch": "c3",
"sc": "hall_liu",
"k": "n",
"t": "刘备推辞，把徐州往外让，让给袁术：",
"q": null,
"t0": 362.8470625,
"t1": 365.8470625
},
{
"id": "c10",
"ch": "c3",
"sc": "hall_liu",
"k": "q",
"t": "袁公路近在寿春，此君四世五公，海内所归，君可以州与之。",
"q": {
"orig": "袁公路近在壽春，此君四世五公，海內所歸，君可以州與之。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "袁术就在旁边的寿春，他家四代出了五位三公，天下归心，把徐州给他吧。"
},
"t0": 366.2670625,
"t1": 372.709375
},
{
"id": "c11",
"ch": "c3",
"sc": "hall_chen2",
"k": "n",
"t": "陈登不接这个话头。他说袁术骄横，不是收拾乱局的人，然后许下一个数字：",
"q": null,
"t0": 373.329375,
"t1": 379.1483958333334
},
{
"id": "c12",
"ch": "c3",
"sc": "hall_chen2",
"k": "q",
"t": "今欲为使君合步骑十万。",
"q": {
"orig": "今欲為使君合步騎十萬。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "我们愿意替您凑齐十万步骑。"
},
"t0": 379.56839583333334,
"t1": 382.31839583333334
},
{
"id": "c12a",
"ch": "c3",
"sc": "hall_chen2",
"k": "n",
"t": "这张支票两头都能兑现：往大了说，可以匡主济民，成五霸之业；往小了说，可以割地守境，名留竹帛。",
"q": null,
"t0": 382.93839583333335,
"t1": 391.678125
},
{
"id": "c12b",
"ch": "c3",
"sc": "hall_chen2",
"k": "n",
"t": "接着，陈登又加了一句重话：",
"q": null,
"t0": 392.09812500000004,
"t1": 394.28456250000005
},
{
"id": "c12c",
"ch": "c3",
"sc": "hall_chen2",
"k": "q",
"t": "若使君不见听许，登亦未敢听使君也。",
"q": {
"orig": "若使君不見聽許，登亦未敢聽使君也。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "您要是不答应，我陈登也不敢再听您的了。"
},
"t0": 394.70456250000007,
"t1": 398.60841666666676
},
{
"id": "c12d",
"ch": "c3",
"sc": "hall_chen2",
"k": "n",
"t": "这已经不是请，是逼。",
"q": null,
"t0": 399.2284166666667,
"t1": 401.39791666666673
},
{
"id": "c13",
"ch": "c3",
"sc": "hall_kong",
"k": "n",
"t": "北海相孔融，孔子的二十世孙，天下闻名的名士，说得更狠：",
"q": null,
"t0": 401.8179166666667,
"t1": 407.4619791666667
},
{
"id": "c14",
"ch": "c3",
"sc": "hall_kong",
"k": "q",
"t": "袁公路岂忧国忘家者邪？冢中枯骨，何足介意。",
"q": {
"orig": "袁公路豈憂國忘家者邪？冢中枯骨，何足介意。",
"src": "《三國志·先主傳》",
"lvl": 1,
"bai": "袁术哪是忧国忘家的人？坟里的一把枯骨，不必放在心上。"
},
"t0": 407.88197916666667,
"t1": 413.066125
},
{
"id": "c15",
"ch": "c3",
"sc": "hall_kong",
"k": "n",
"t": "名士开口，等于给这件事盖了章。于是，刘备领了徐州。",
"q": null,
"t0": 413.686125,
"t1": 418.2000625
},
{
"id": "c16",
"ch": "c3",
"sc": "who_ask",
"k": "n",
"t": "这场戏，要看懂两层。第一层，是谁在请他。",
"q": null,
"t0": 419.2000625,
"t1": 423.47670833333336
},
{
"id": "c17",
"ch": "c3",
"sc": "who_ask",
"k": "q",
"t": "祖世货殖，僮客万人，赀产巨亿。",
"q": {
"orig": "祖世貨殖，僮客萬人，貲產鉅億。",
"src": "《三國志·麋竺傳》",
"lvl": 1,
"bai": "麋竺家祖辈经商，僮仆门客上万，资产上亿。"
},
"t0": 423.8967083333333,
"t1": 427.6659375
},
{
"id": "c18",
"ch": "c3",
"sc": "who_ask",
"k": "n",
"t": "这是麋竺，东海的豪商。陈登，出身下邳的官宦大族，父亲陈珪做过沛相。",
"q": null,
"t0": 428.2859375,
"t1": 434.85070833333333
},
{
"id": "c19",
"ch": "c3",
"sc": "who_ask",
"k": "n",
"t": "他们要的，是一个能打仗、又压不住他们的人。",
"q": null,
"t0": 435.27070833333335,
"t1": 438.6266458333333
},
{
"id": "c20",
"ch": "c3",
"sc": "balance",
"k": "n",
"t": "把两个人放上天平。",
"q": null,
"t0": 439.04664583333334,
"t1": 440.53816666666665
},
{
"id": "c21",
"ch": "c3",
"sc": "balance",
"k": "n",
"t": "袁术太重。四世五公，自带班底，兵强马壮。他一进徐州，本地豪族就只能当附庸。",
"q": null,
"t0": 440.95816666666667,
"t1": 447.9805625
},
{
"id": "c22",
"ch": "c3",
"sc": "balance",
"k": "n",
"t": "刘备刚好。会打仗，有名声，可在徐州没有根；兵有一半是陶谦给的，钱粮要靠本地人。",
"q": null,
"t0": 448.4005625,
"t1": 455.81279166666667
},
{
"id": "c23",
"ch": "c3",
"sc": "balance",
"k": "n",
"t": "他够用，又离不开他们。这就是本地精英眼里的最优弱主。",
"q": null,
"t0": 456.2327916666666,
"t1": 460.96706249999994
},
{
"id": "c24",
"ch": "c3",
"sc": "decline",
"k": "n",
"t": "第二层，是那几次推辞。",
"q": null,
"t0": 461.76706249999995,
"t1": 463.8348541666666
},
{
"id": "c25",
"ch": "c3",
"sc": "decline",
"k": "n",
"t": "推辞不是客气，是一个合法性动作。刘备每推一次，推举的人就得多表一次态：不选袁术，偏选你，还要当众许下十万步骑。",
"q": null,
"t0": 464.25485416666663,
"t1": 474.62168749999995
},
{
"id": "c26",
"ch": "c3",
"sc": "decline",
"k": "n",
"t": "推到最后，这个州不是刘备伸手拿的，而是一州的人公开托付给他的。责任，分摊到了每一个劝进的人身上。",
"q": null,
"t0": 475.04168749999997,
"t1": 483.09799999999996
},
{
"id": "c27",
"ch": "c3",
"sc": "yuanshao",
"k": "n",
"t": "事后，陈登他们还派人去见当时的盟主袁绍，请他背书。袁绍回答：",
"q": null,
"t0": 483.518,
"t1": 488.890875
},
{
"id": "c28",
"ch": "c3",
"sc": "yuanshao",
"k": "q",
"t": "刘玄德弘雅有信义，今徐州乐戴之，诚副所望也。",
"q": {
"orig": "劉玄德弘雅有信義，今徐州樂戴之，誠副所望也。",
"src": "《先主傳》裴注引《獻帝春秋》",
"lvl": 2,
"bai": "刘备宽厚有信义，徐州人乐意拥戴他，正合我意。"
},
"t0": 489.31087499999995,
"t1": 494.2916458333333
},
{
"id": "c28b",
"ch": "c3",
"sc": "yuanshao",
"k": "n",
"t": "陈登他们给袁绍的信里有一句：辄共奉故平原相刘备府君以为宗主。注意那个共字：是大家一起奉他。",
"q": null,
"t0": 494.9116458333333,
"t1": 502.22764583333327
},
{
"id": "c29",
"ch": "c3",
"sc": "analogy2",
"k": "a",
"t": "打个比方：一个地方的几大世家和旧班底，共同推举一位外来的、能带兵、却在本地没有根基的人，出任封疆大吏。彼此都放心。",
"q": null,
"t0": 502.6476458333333,
"t1": 512.4442499999999
},
{
"id": "c30",
"ch": "c3",
"sc": "analogy2",
"k": "b",
"t": "但这个比方也有不成立的地方：当时没有中央任命。领徐州，靠的是地方推举，加上事后补一道表奏。这种合法性，比今天任何一份正式任命都脆弱。",
"q": null,
"t0": 512.9442499999999,
"t1": 524.1131666666665
},
{
"id": "c31",
"ch": "c3",
"sc": "analogy2",
"k": "n",
"t": "所以两年以后，一场偷袭，就够了。",
"q": null,
"t0": 524.6131666666665,
"t1": 527.8334999999998
},
{
"id": "d01",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "一九六年，袁术来攻。刘备在盱眙、淮阴和他相持了一个多月。",
"q": null,
"t0": 530.8334999999998,
"t1": 536.4491249999999
},
{
"id": "d02",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "吕布乘虚偷袭下邳，守将曹豹反水，开门迎布。刘备的妻儿成了俘虏，徐州丢了。",
"q": null,
"t0": 536.8691249999998,
"t1": 544.3322083333331
},
{
"id": "d02b",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "裴注引《英雄记》补了一个细节：刘备留张飞守下邳，张飞要杀曹豹，曹豹据营自守，派人去招吕布。",
"q": null,
"t0": 544.7522083333332,
"t1": 552.6390208333332
},
{
"id": "d02c",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "《吕布传》裴注引的《英雄记》，还记下了城门是怎么开的：",
"q": null,
"t0": 553.0590208333332,
"t1": 557.0251249999999
},
{
"id": "d02d",
"ch": "c4",
"sc": "lose",
"k": "q",
"t": "天明，丹杨兵悉开门内布兵。",
"q": {
"orig": "天明，丹楊兵悉開門內布兵。",
"src": "《呂布傳》裴注引《英雄記》",
"lvl": 2,
"bai": "天一亮，丹阳兵打开城门，把吕布的兵放了进来。"
},
"t0": 557.4451249999998,
"t1": 560.6566666666665
},
{
"id": "d03",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "两种记载细节不同，指向的却是同一件事：开门的，是陶谦留下的旧部和丹阳兵。当年陶谦拨给刘备的，也正是丹阳兵。最优弱主的代价就在这里：你压不住他们，就总有人另找靠山。",
"q": null,
"t0": 561.2766666666665,
"t1": 575.8408541666665
},
{
"id": "d03b",
"ch": "c4",
"sc": "lose",
"k": "n",
"t": "可刘备回到小沛，没多久又聚起了一万多人。",
"q": null,
"t0": 576.2608541666665,
"t1": 579.7354374999999
},
{
"id": "d04",
"ch": "c4",
"sc": "gain",
"k": "n",
"t": "但这一年多，刘备真正攒下了两样东西。",
"q": null,
"t0": 580.1554374999998,
"t1": 582.9689999999998
},
{
"id": "d05",
"ch": "c4",
"sc": "gain",
"k": "n",
"t": "第一样是名分。当过一州之主，天下诸侯第一次把他当成一方人物。就在这一年，曹操上表，封他为镇东将军、宜城亭侯。",
"q": null,
"t0": 583.3889999999998,
"t1": 593.6372083333331
},
{
"id": "d05b",
"ch": "c4",
"sc": "gain",
"k": "n",
"t": "后来他走投无路去投曹操，曹操任他为豫州牧。徐州那段履历，成了他的身价。",
"q": null,
"t0": 594.0572083333332,
"t1": 600.5880833333332
},
{
"id": "d06",
"ch": "c4",
"sc": "gain2",
"k": "n",
"t": "第二样，是人和钱。徐州丢了，刘备转到广陵海西，正是最难的时候。麋竺做了一件事：",
"q": null,
"t0": 601.0080833333332,
"t1": 608.1376458333332
},
{
"id": "d07",
"ch": "c4",
"sc": "gain2",
"k": "q",
"t": "竺于是进妹于先主为夫人，奴客二千，金银货币以助军资，于时困匮，赖此复振。",
"q": {
"orig": "竺于是進妹于先主為夫人，奴客二千，金銀貨幣以助軍資，于時困匱，賴此複振。",
"src": "《三國志·麋竺傳》",
"lvl": 1,
"bai": "麋竺把妹妹嫁给刘备，又送上两千奴客和金银，助他重新振作。"
},
"t0": 608.5576458333331,
"t1": 616.5768749999999
},
{
"id": "d08",
"ch": "c4",
"sc": "gain2",
"k": "n",
"t": "后来曹操表麋竺做嬴郡太守，麋竺的弟弟麋芳做彭城相，兄弟俩都辞了官，跟着刘备走。",
"q": null,
"t0": 617.1968749999999,
"t1": 624.2985624999999
},
{
"id": "d09",
"ch": "c4",
"sc": "gain2",
"k": "n",
"t": "地盘丢了，人没丢。一个豪商家族，把身家押在了一个没有地盘的人身上。",
"q": null,
"t0": 624.7185624999998,
"t1": 630.8087708333331
},
{
"id": "e01",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "很多人熟悉的，是《三国演义》里的三让徐州。",
"q": null,
"t0": 633.8087708333331,
"t1": 637.2155416666665
},
{
"id": "e02",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "演义说：陶谦三次把徐州让给刘备，刘备三次推辞。",
"q": null,
"t0": 637.6355416666664,
"t1": 642.0762291666664
},
{
"id": "e03",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "史书说：陶谦只在临终前，对麋竺留下一句话；真正当面劝进的，是麋竺、陈登和孔融。",
"q": null,
"t0": 642.4962291666665,
"t1": 650.9254166666665
},
{
"id": "e04",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "演义把这件事，写成了陶谦一个人的仁厚。史书里，它是一州精英的集体选择。",
"q": null,
"t0": 651.3454166666664,
"t1": 657.8084999999998
},
{
"id": "e05",
"ch": "c5",
"sc": "novel",
"k": "n",
"t": "这个差别要紧。一个人的仁厚，换了人就没了；一州精英的选择，背后是他们自己的算盘。算盘一变，人也会变，曹豹就是例子。",
"q": null,
"t0": 658.2284999999998,
"t1": 668.4143541666665
},
{
"id": "f01",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "回到开头的问题：为什么是他？",
"q": null,
"t0": 671.4143541666665,
"t1": 673.9906249999998
},
{
"id": "f02",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "平原的刺客，路上的饥民，徐州的豪商，没有一个是他抢来的。",
"q": null,
"t0": 674.4106249999999,
"t1": 679.4445208333332
},
{
"id": "f02b",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "从平原到徐州，他做的其实是同一件事：先让人离不开他，再等人来请。",
"q": null,
"t0": 679.8645208333332,
"t1": 686.0055624999999
},
{
"id": "f03",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "司马迁写李广，引过一句谚语：",
"q": null,
"t0": 686.4255625,
"t1": 689.069625
},
{
"id": "f04",
"ch": "c6",
"sc": "end",
"k": "q",
"t": "桃李不言，下自成蹊。",
"q": {
"orig": "桃李不言，下自成蹊。",
"src": "《史記·李將軍列傳》",
"lvl": 9,
"bai": "桃李不说话，树下自然被人踩出小路。"
},
"t0": 689.4896249999999,
"t1": 692.2780833333333
},
{
"id": "f05",
"ch": "c6",
"sc": "end",
"k": "n",
"t": "人心，是自己走过来的。",
"q": null,
"t0": 692.8980833333333,
"t1": 694.8980833333333
},
{
"id": "f05b",
"ch": "c6",
"sc": "takeaway",
"k": "n",
"t": "放到今天的职场，也是一样：",
"q": null,
"t0": 695.6980833333332,
"t1": 697.9862291666666
},
{
"id": "f06",
"ch": "c6",
"sc": "takeaway",
"k": "n",
"t": "有时你被选中，不是因为你最强，而是因为你强到能办事，又弱到让别人放心。",
"q": null,
"t0": 698.4062291666665,
"t1": 704.1689374999999
},
{
"id": "f07",
